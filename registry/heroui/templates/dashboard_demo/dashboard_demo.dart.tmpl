const _popoverWidth = 288.0;

/// Selects the demo's appearance and radius under the theme it is placed in.
///
/// HeroUI exposes only the selected theme, so two probe scopes read the
/// host's light and dark themes; the radius from Settings is copied onto
/// both, so each brightness keeps its own colors. The probes are always
/// present below a host theme, so moving the slider never rebuilds the pages
/// under a different parent.
class _{{typePrefix}}DemoTheme extends StatelessWidget {
  const _{{typePrefix}}DemoTheme({
    required this.dark,
    required this.radius,
    required this.child,
  });

  final bool dark;
  final double? radius;
  final Widget child;

  {{typePrefix}}ThemeMode get _mode =>
      dark ? {{typePrefix}}ThemeMode.dark : {{typePrefix}}ThemeMode.light;

  @override
  Widget build(BuildContext context) {
    final radius = this.radius;
    if ({{typePrefix}}Theme.maybeOf(context) == null) {
      return _{{typePrefix}}StableDemoTheme(
        mode: _mode,
        theme: radius == null ? null : {{typePrefix}}ThemeData.light(radius: radius),
        darkTheme: radius == null ? null : {{typePrefix}}ThemeData.dark(radius: radius),
        child: child,
      );
    }
    return {{typePrefix}}Theme(
      mode: {{typePrefix}}ThemeMode.light,
      child: Builder(
        builder: (lightContext) {
          final light = {{typePrefix}}Theme.of(lightContext);
          return {{typePrefix}}Theme(
            mode: {{typePrefix}}ThemeMode.dark,
            child: Builder(
              builder: (darkContext) {
                final dark = {{typePrefix}}Theme.of(darkContext);
                return _{{typePrefix}}StableDemoTheme(
                  mode: _mode,
                  theme: radius == null ? null : light.copyWith(radius: radius),
                  darkTheme: radius == null
                      ? null
                      : dark.copyWith(radius: radius),
                  child: child,
                );
              },
            ),
          );
        },
      ),
    );
  }
}

/// A header icon button that opens a popover.
///
/// The button owns activation (`openOnTap: false`), so the popover adds no
/// focus stop of its own, and the one node shared with `triggerFocusNode` is
/// what closing returns focus to.
class _{{typePrefix}}HeaderPopover extends StatefulWidget {
  const _{{typePrefix}}HeaderPopover({
    required this.dark,
    required this.icon,
    required this.semanticLabel,
    required this.popoverChild,
    this.showBadge = false,
  });

  final bool dark;
  final IconData icon;
  final String semanticLabel;
  final Widget popoverChild;
  final bool showBadge;

  @override
  State<_{{typePrefix}}HeaderPopover> createState() => _{{typePrefix}}HeaderPopoverState();
}

class _{{typePrefix}}HeaderPopoverState extends State<_{{typePrefix}}HeaderPopover> {
  final _controller = MenuController();
  final _focusNode = FocusNode();

  @override
  void didUpdateWidget(covariant _{{typePrefix}}HeaderPopover oldWidget) {
    super.didUpdateWidget(oldWidget);
    // Appearance changes used to dismiss the popover by remounting the demo.
    // Keep that behavior while retaining the dashboard's page state.
    if (widget.dark != oldWidget.dark) _controller.close();
  }

  @override
  void dispose() {
    _focusNode.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) => {{typePrefix}}Popover(
    controller: _controller,
    openOnTap: false,
    triggerFocusNode: _focusNode,
    popoverChild: widget.popoverChild,
    child: StackBox(
      style: StackBoxStyler().clipBehavior(.none),
      children: [
        {{typePrefix}}IconButton.ghost(
          icon: widget.icon,
          semanticLabel: widget.semanticLabel,
          focusNode: _focusNode,
          onPressed: () =>
              _controller.isOpen ? _controller.close() : _controller.open(),
        ),
        if (widget.showBadge)
          Positioned(
            right: 8,
            top: 8,
            child: IgnorePointer(
              child: Box(
                style: BoxStyler()
                    .size(8, 8)
                    .borderRadius(.circular(99))
                    .color({{typePrefix}}Tokens.accent())
                    .border(.all(.color({{typePrefix}}Tokens.background()).width(1.5))),
              ),
            ),
          ),
      ],
    ),
  );
}

