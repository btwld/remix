  bool get _isDark =>
      _dark ?? ({{typePrefix}}Theme.maybeOf(context)?.brightness == Brightness.dark);

  @override
  Widget build(BuildContext context) {
    final demo = {{typePrefix}}DashboardDemoBase(
      initialPage: widget.initialPage,
      shellBuilder:
          (
            context, {
            required sections,
            required selectedValue,
            required onSelected,
            required body,
            required title,
            required onSearchChanged,
          }) => {{typePrefix}}DashboardShell<{{typePrefix}}DashboardDemoPage>(
            sections: sections,
            selectedValue: selectedValue,
            onSelected: onSelected,
            body: body,
            title: title,
            headerTitle: widget.builtInChrome
                ? _{{typePrefix}}Breadcrumb(page: selectedValue)
