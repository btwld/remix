import 'dart:math' as math;

import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
{{icon:import}}

import '../../components/alert.dart';
import '../../components/button.dart';
import '../../components/card.dart';
import '../../components/checkbox.dart';
import '../../components/disclosure.dart';
import '../../components/modal.dart';
import '../../components/select.dart';
import '../../components/slider.dart';
import '../../components/switch.dart';
import '../../components/textfield.dart';
import '../../theme/theme.dart';
import 'dashboard_demo_text.dart';

enum _Appearance { light, dark, system }

class {{typePrefix}}DashboardSettingsPage extends StatefulWidget {
  const {{typePrefix}}DashboardSettingsPage({
    super.key,
    this.darkMode,
    this.onDarkModeChanged,
    this.onRadiusChanged,
  });

  final bool? darkMode;
  final ValueChanged<bool?>? onDarkModeChanged;

  /// Called with the base corner radius (`--radius`), in logical pixels, as
  /// the slider moves.
  final ValueChanged<double>? onRadiusChanged;

  @override
  State<{{typePrefix}}DashboardSettingsPage> createState() =>
      _{{typePrefix}}DashboardSettingsPageState();
}

class _{{typePrefix}}DashboardSettingsPageState
    extends State<{{typePrefix}}DashboardSettingsPage> {
  bool _productUpdates = true;
  bool _weeklyDigest = false;
  String _language = 'en';
  _Appearance _appearance = .system;
  double? _radius;
  bool _dangerZoneExpanded = false;

  _Appearance get _resolvedAppearance => widget.onDarkModeChanged == null
      ? _appearance
      : switch (widget.darkMode) {
          false => .light,
          true => .dark,
          null => .system,
        };

  /// The slider's value: the user's drag, otherwise the active theme's
  /// [{{typePrefix}}ThemeData.radius].
  double _resolvedRadius(BuildContext context) =>
      _radius ??
      {{typePrefix}}Theme.maybeOf(context)?.radius ??
      const {{typePrefix}}ThemeData.light().radius;

  @override
  Widget build(BuildContext context) => SingleChildScrollView(
    padding: const EdgeInsets.all(32),
    child: Box(
      style: BoxStyler().alignment(.topStart),
      child: ColumnBox(
        style: FlexBoxStyler()
            .maxWidth(880)
            .crossAxisAlignment(.stretch)
            .spacing(16),
        children: [
          ColumnBox(
            style: FlexBoxStyler().crossAxisAlignment(.start).spacing(4),
            children: const [
              {{typePrefix}}DashboardText('Settings', type: .h3),
              {{typePrefix}}DashboardText(
                'Manage your profile, preferences, and workspace.',
                muted: true,
              ),
            ],
          ),
          _section(
            'Profile',
            'This information appears across your workspace.',
            ColumnBox(
              style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(12),
              children: [
                GridBox(
                  style: GridBoxStyler.equalColumns(2)
                      .gap(12)
                      .onConstraints(
                        const .maxWidth(559),
                        .equalColumns(1).gap(12),
                      ),
                  children: const [
                    {{typePrefix}}TextField(label: 'Full name', hintText: 'Ada Chen'),
                    {{typePrefix}}TextField(
                      label: 'Email address',
                      hintText: 'ada@northstar.co',
                    ),
                  ],
                ),
                {{typePrefix}}Select<String>(
                  semanticLabel: 'Language',
                  trigger: const RemixSelectTrigger(placeholder: 'Language'),
                  items: const [
                    RemixSelectItem(value: 'en', label: 'English'),
                    RemixSelectItem(value: 'es', label: 'Spanish'),
                    RemixSelectItem(value: 'fr', label: 'French'),
                  ],
                  selectedValue: _language,
                  onChanged: (value) {
                    if (value != null) setState(() => _language = value);
                  },
                ),
                Box(
                  style: BoxStyler().alignment(.centerStart),
                  child: {{typePrefix}}Button(
                    label: 'Save changes',
                    onPressed: () =>
                        {{valuePrefix}}DashboardToast(context, 'Profile settings saved'),
                  ),
                ),
              ],
            ),
          ),
          _section(
            'Preferences',
            'Choose which workspace activity reaches your inbox.',
            ColumnBox(
              style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(16),
              children: [
                _preference(
                  'Product updates',
                  'News about features and improvements.',
                  {{typePrefix}}Switch(
                    selected: _productUpdates,
                    semanticLabel: 'Receive product updates',
                    onChanged: (value) =>
                        setState(() => _productUpdates = value),
                  ),
                ),
                _preference(
                  'Weekly digest',
                  'A summary of workspace activity each Monday.',
                  {{typePrefix}}Checkbox(
                    selected: _weeklyDigest,
                    semanticLabel: 'Receive weekly digest',
                    onChanged: (value) =>
                        setState(() => _weeklyDigest = value ?? false),
                  ),
                ),
              ],
            ),
          ),
          _section(
            'Appearance',
            'Choose light, dark, or match the system.',
            ColumnBox(
              style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(16),
              children: [
                const {{typePrefix}}Alert(
                  icon: {{icon:magicWand}},
                  text:
                      'Changes are deterministic and remain local to the demo.',
                ),
                ColumnBox(
                  style: FlexBoxStyler().crossAxisAlignment(.start).spacing(8),
                  children: [
                    const {{typePrefix}}DashboardText('Color mode', emphasized: true),
                    {{typePrefix}}DashboardSegments<_Appearance>(
                      semanticLabel: 'Color mode',
                      selectedValue: _resolvedAppearance,
                      items: const [
                        (value: .light, label: 'Light'),
                        (value: .dark, label: 'Dark'),
                        (value: .system, label: 'System'),
                      ],
                      onChanged: (value) {
                        setState(() => _appearance = value);
                        widget.onDarkModeChanged?.call(switch (value) {
                          .light => false,
                          .dark => true,
                          .system => null,
                        });
                      },
                    ),
                  ],
                ),
                ColumnBox(
                  style: FlexBoxStyler()
                      .crossAxisAlignment(.stretch)
                      .spacing(8),
                  children: [
                    {{typePrefix}}DashboardText(
                      'Control radius · ${_resolvedRadius(context).round()}px',
                      emphasized: true,
                    ),
                    {{typePrefix}}Slider(
                      semanticLabel: 'Control radius',
                      value: _resolvedRadius(context),
                      min: 0,
                      max: 16,
                      snapDivisions: 16,
                      onChanged: (value) {
                        setState(() => _radius = value);
                        widget.onRadiusChanged?.call(value);
                      },
                    ),
                  ],
                ),
              ],
            ),
          ),
          {{typePrefix}}Card(
            child: {{typePrefix}}Disclosure(
              key: const ValueKey('settings-danger-zone'),
              expanded: _dangerZoneExpanded,
              onExpandedChanged: (value) =>
                  setState(() => _dangerZoneExpanded = value),
              semanticHint: 'Shows destructive workspace actions',
              trigger: {{typePrefix}}DisclosureTrigger(
                expanded: _dangerZoneExpanded,
                child: const {{typePrefix}}DashboardText(
                  'Danger zone',
                  emphasized: true,
                ),
              ),
              content: ColumnBox(
                style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(12),
                children: [
                  const {{typePrefix}}DashboardText(
                    'Destructive workspace actions cannot be undone.',
                    muted: true,
                  ),
                  Box(
                    style: BoxStyler().alignment(.centerStart),
                    child: {{typePrefix}}Button.danger(
                      label: 'Delete workspace',
                      onPressed: _confirmDelete,
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    ),
  );

  Future<void> _confirmDelete() async {
    final confirmed = await showRemixDialog<bool>(
      context: context,
      barrierLabel: 'Dismiss',
      barrierColor: {{typePrefix}}Tokens.backdrop.resolve(context),
      builder: (dialogContext) => {{typePrefix}}Modal(
        title: 'Delete workspace?',
        description:
            'This demo keeps your data safe, but a real action would be permanent.',
        actions: [
          {{typePrefix}}Button.tertiary(
            label: 'Cancel',
            onPressed: () => Navigator.of(dialogContext).pop(false),
          ),
          {{typePrefix}}Button.danger(
            label: 'Delete',
            onPressed: () => Navigator.of(dialogContext).pop(true),
          ),
        ],
      ),
    );
    if (!mounted || confirmed != true) return;
    {{valuePrefix}}DashboardToast(context, 'Demo workspace was not deleted');
  }
}

Widget _section(String title, String description, Widget child) => {{typePrefix}}Card(
  child: ColumnBox(
    style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(16),
    children: [
      ColumnBox(
        style: FlexBoxStyler().crossAxisAlignment(.start),
        children: [{{typePrefix}}CardTitle(title), {{typePrefix}}CardDescription(description)],
      ),
      child,
    ],
  ),
);

Widget _preference(String title, String description, Widget trailing) => RowBox(
  style: FlexBoxStyler().crossAxisAlignment(.center).spacing(16),
  children: [
    Expanded(
      child: ColumnBox(
        style: FlexBoxStyler().crossAxisAlignment(.start).spacing(2),
        children: [
          {{typePrefix}}DashboardText(title, emphasized: true),
          {{typePrefix}}DashboardText(description, muted: true),
        ],
      ),
    ),
    trailing,
  ],
);

/// The disclosure's trigger row: its label and a chevron that turns over as
/// the panel opens.
class {{typePrefix}}DisclosureTrigger extends StatelessWidget {
  const {{typePrefix}}DisclosureTrigger({
    super.key,
    required this.expanded,
    required this.child,
  });

  final bool expanded;
  final Widget child;

  @override
  Widget build(BuildContext context) => RowBox(
    style: FlexBoxStyler().crossAxisAlignment(.center),
    children: [
      Expanded(child: child),
      Box(
        style: BoxStyler()
            .transform(
              Matrix4.rotationZ(expanded ? math.pi : 0),
              alignment: .center,
            )
            .animate({{typePrefix}}Tokens.smoothMotion),
        child: StyledIcon(
          icon: {{icon:chevronDown}},
          style: IconStyler().size(16).color({{typePrefix}}Tokens.muted()),
        ),
      ),
    ],
  );
}
