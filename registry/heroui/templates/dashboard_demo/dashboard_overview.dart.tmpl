/// Revenue, orders, and recent activity, in HeroUI cards.
///
/// Pass local [data] to replace the starter metrics, chart, and records without
/// changing the responsive composition.
class {{typePrefix}}DashboardOverview extends StatelessWidget {
  const {{typePrefix}}DashboardOverview({
    super.key,
    this.data = {{valuePrefix}}DashboardSampleData,
    this.scrollController,
    this.onViewOrders,
  });

  final {{typePrefix}}DashboardSampleData data;
  final ScrollController? scrollController;
  final VoidCallback? onViewOrders;

  @override
  Widget build(BuildContext context) => {{typePrefix}}DashboardOverviewBase(
    data: data,
    scrollController: scrollController,
    headerBuilder: (context, title, description) => ColumnBox(
      style: FlexBoxStyler().crossAxisAlignment(.start).spacing(4),
      children: [
        {{typePrefix}}DashboardText(title, type: .h3),
        {{typePrefix}}DashboardText(description, muted: true),
      ],
    ),
    metricBuilder: (context, metric) => {{typePrefix}}Card(
      child: ColumnBox(
        style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(8),
        children: [
          RowBox(
            style: FlexBoxStyler()
                .mainAxisAlignment(.spaceBetween)
                .crossAxisAlignment(.center)
                .spacing(8),
            children: [
              Flexible(child: {{typePrefix}}CardDescription(metric.label)),
              if (metric.delta case final delta?)
                // Up and down are a status, so they take its colours here,
                // unlike a chart series.
                {{typePrefix}}Chip.soft(
                  size: .sm,
                  color: metric.positive ? .success : .danger,
                  child: RowBox(
                    style: FlexBoxStyler()
                        .mainAxisSize(.min)
                        .crossAxisAlignment(.center)
                        .spacing(2),
                    children: [
                      StyledIcon(
                        icon: metric.positive
                            ? {{icon:chevronUp}}
                            : {{icon:chevronDown}},
                        style: IconStyler().size(12),
                      ),
                      StyledText(delta),
                    ],
                  ),
                ),
            ],
          ),
          {{typePrefix}}DashboardText(metric.value, type: .h3),
          if (metric.progress case final progress?)
            {{typePrefix}}Progress(
              value: progress,
              size: .sm,
              semanticsLabel: metric.label,
            ),
          {{typePrefix}}DashboardText(metric.change, type: .bodyXs, muted: true),
        ],
      ),
    ),
    chartBuilder: (context, data) => GridBox(
      style: GridBoxStyler.equalColumns(
        3,
      ).gap(16).onConstraints(const .maxWidth(759), .equalColumns(1).gap(16)),
      children: [_revenueCard(data), _customerChartCard(), _fulfillmentCard()],
    ),
    tableBuilder: (context, data) => GridBox(
      style: GridBoxStyler.equalColumns(
        2,
      ).gap(20).onConstraints(const .maxWidth(899), .equalColumns(1).gap(20)),
      children: [_activityCard(data), _ordersCard(data, onViewOrders)],
    ),
  );
}

/// A card whose header is HeroUI's card title and description.
Widget _chartCard({
  required String title,
  required String description,
  required List<Widget> children,
}) => {{typePrefix}}Card(
  child: ColumnBox(
    style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(16),
    children: [
      ColumnBox(
        style: FlexBoxStyler().crossAxisAlignment(.start),
        children: [{{typePrefix}}CardTitle(title), {{typePrefix}}CardDescription(description)],
      ),
      ...children,
    ],
  ),
);

Widget _revenueCard({{typePrefix}}DashboardSampleData data) => _chartCard(
  title: 'Revenue trend',
  description: 'Seven-day net revenue',
  children: [
    Box(
      key: const ValueKey('dashboard-revenue-chart'),
      style: BoxStyler().height(220),
      child: {{typePrefix}}LineChart(
        semanticsLabel: 'Seven-day net revenue',
        showMarkers: true,
        series: [_revenueSeries(data.revenue)],
        // Half a step of room at each end keeps the first and last labels
        // and markers off the plot's edges, where a marker is cut in half
        // and a label is pushed into its neighbor.
        xAxis: ChartAxis.numeric(
          min: -0.5,
          max: data.revenue.length > 1 ? data.revenue.length - 0.5 : 1.5,
          interval: 1,
          minIncluded: false,
          maxIncluded: false,
          labelFormatter: (value) => _pointLabel(data.revenue, value),
        ),
        // Round steps, with room past each end so the end labels sit on
        // their gridlines.
        yAxis: {{valuePrefix}}DashboardNumericAxis(max: 100, interval: 20),
        style: {{valuePrefix}}DashboardLineStyle(),
      ),
    ),
  ],
);

Widget _customerChartCard() => _chartCard(
  title: 'Customer acquisition',
  description: 'New accounts by month',
  children: [
    Box(
      style: BoxStyler().height(220),
      child: {{typePrefix}}BarChart(
        semanticsLabel: 'New accounts by month',
        groups: [
          for (final (index, value) in const [
            18.0,
            24.0,
            21.0,
            32.0,
            38.0,
            44.0,
          ].indexed)
            BarGroup(
              id: 'customers-$index',
              label: const ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'][index],
              bars: [BarValue(id: 'customers', label: 'Customers', toY: value)],
            ),
        ],
        // Customers peak at 44; see the revenue chart above for why the
        // maximum is pinned to a whole number of intervals.
        yAxis: {{valuePrefix}}DashboardNumericAxis(max: 50),
        style: {{valuePrefix}}DashboardBarStyle(),
      ),
    ),
  ],
);

Widget _fulfillmentCard() => _chartCard(
  title: 'Fulfillment mix',
  description: 'Current order status',
  children: [
    // The legend names the series colors the pie draws: the first three of
    // the chart ramp.
    {{typePrefix}}ChartLegend(
      items: [
        {{typePrefix}}ChartLegendItem(
          label: 'Fulfilled',
          detail: '72%',
          color: {{valuePrefix}}ChartSeries[0],
        ),
        {{typePrefix}}ChartLegendItem(
          label: 'Processing',
          detail: '18%',
          color: {{valuePrefix}}ChartSeries[1],
        ),
        {{typePrefix}}ChartLegendItem(
          label: 'Review',
          detail: '10%',
          color: {{valuePrefix}}ChartSeries[2],
        ),
      ],
      labelStyle: {{valuePrefix}}DashboardTextStyle(type: .bodyXs, emphasized: true),
      detailStyle: {{valuePrefix}}DashboardTextStyle(type: .bodyXs, muted: true),
    ),
    Box(
      style: BoxStyler().height(190),
      child: {{typePrefix}}PieChart(
        centerRadius: 44,
        // mix_chart draws each slice 80px wide in any box; this ring stops
        // the donut at 88px, 80% of the way to the edge of its box.
        style: PieChartStyler().slice(PieSliceStyler().radius(44)),
        semanticsLabel: 'Current order status',
        slices: [
          PieSlice(id: 'fulfilled', label: 'Fulfilled', value: 72),
          PieSlice(id: 'processing', label: 'Processing', value: 18),
          PieSlice(id: 'review', label: 'Review', value: 10),
        ],
      ),
    ),
  ],
);

Widget _activityCard({{typePrefix}}DashboardSampleData data) => {{typePrefix}}Card(
  child: ColumnBox(
    style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(8),
    children: [
      const {{typePrefix}}CardTitle('Recent activity'),
      ColumnBox(
        style: FlexBoxStyler().crossAxisAlignment(.stretch),
        children: [
          for (final (index, event) in data.activities.indexed) ...[
            Box(
              style: BoxStyler().padding(.vertical(10)),
              child: RowBox(
                style: FlexBoxStyler().crossAxisAlignment(.center).spacing(12),
                children: [
                  Box(
                    style: BoxStyler()
                        .size(32, 32)
                        .alignment(.center)
                        .borderRadius(.all({{typePrefix}}Tokens.radiusXl()))
                        .color({{typePrefix}}Tokens.defaultColor()),
                    child: StyledIcon(
                      icon: _activityIcon(event.kind),
                      style: IconStyler()
                          .size(16)
                          .color({{typePrefix}}Tokens.defaultForeground()),
                    ),
                  ),
                  Expanded(
                    child: ColumnBox(
                      style: FlexBoxStyler()
                          .crossAxisAlignment(.start)
                          .spacing(2),
                      children: [
                        {{typePrefix}}DashboardText(event.title, emphasized: true),
                        {{typePrefix}}DashboardText(event.detail, muted: true),
                      ],
                    ),
                  ),
                  {{typePrefix}}DashboardText(
                    event.relativeTime,
                    type: .bodyXs,
                    muted: true,
                  ),
                ],
              ),
            ),
            if (index != data.activities.length - 1) const {{typePrefix}}Separator(),
          ],
        ],
      ),
    ],
  ),
);

IconData _activityIcon({{typePrefix}}DashboardActivityKind kind) => switch (kind) {
  .customer => {{icon:person}},
  .order => {{icon:box}},
  .payment => {{icon:checkCircled}},
  .alert => {{icon:exclamationTriangle}},
};

Widget _ordersCard(
  {{typePrefix}}DashboardSampleData data,
  VoidCallback? onViewOrders,
) => {{typePrefix}}Card(
  child: ColumnBox(
    style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(12),
    children: [
      RowBox(
        style: FlexBoxStyler().crossAxisAlignment(.center),
        children: [
          const Expanded(child: {{typePrefix}}CardTitle('Recent orders')),
          {{typePrefix}}Button.ghost(
            key: const ValueKey('overview-view-orders'),
            size: .sm,
            label: 'View all',
            trailingIcon: {{icon:doubleArrowRight}},
            onPressed: onViewOrders,
          ),
        ],
      ),
      {{typePrefix}}Table<{{typePrefix}}DashboardRecord>.secondary(
        key: const ValueKey('dashboard-records-table'),
        semanticLabel: 'Recent customer orders',
        rows: data.records,
        // Fits the half-width card at a 1280px desktop with the sidebar open;
        // narrower than this, the table scrolls sideways.
        minimumWidth: 400,
        columns: _recordColumns,
      ),
    ],
  ),
);

/// A status chip: soft, in the status colour the value names.
Widget {{valuePrefix}}DashboardStatusChip(String status) =>
    {{typePrefix}}Chip.soft(label: status, size: .sm, color: _statusColor(status));

{{typePrefix}}Color _statusColor(String status) => switch (status.toLowerCase()) {
  'paid' || 'fulfilled' || 'active' => .success,
  'pending' || 'in review' || 'invited' => .warning,
  'cancelled' || 'suspended' => .danger,
  _ => .defaultColor,
};

Widget _cell(String text, {bool emphasized = false}) =>
    {{typePrefix}}DashboardText(text, emphasized: emphasized);

LineSeries _revenueSeries(List<{{typePrefix}}DashboardPoint> points) => LineSeries(
  id: 'revenue',
  label: 'Revenue',
  points: [
    for (final (index, point) in points.indexed)
      ChartPoint(id: point.label, x: index.toDouble(), y: point.value),
  ],
);

String _pointLabel(List<{{typePrefix}}DashboardPoint> points, double value) {
  final index = value.round();
  return index >= 0 && index < points.length ? points[index].label : '';
}

final _recordColumns = <RemixDataTableColumn<{{typePrefix}}DashboardRecord>>[
  RemixDataTableColumn(
    id: 'id',
    label: 'Record',
    width: const FixedColumnWidth(96),
    cellBuilder: (_, record) => _cell(record.id, emphasized: true),
  ),
  RemixDataTableColumn(
    id: 'customer',
    label: 'Customer',
    width: const FlexColumnWidth(2),
    cellBuilder: (_, record) => _cell(record.customer),
  ),
  RemixDataTableColumn(
    id: 'status',
    label: 'Status',
    width: const FixedColumnWidth(104),
    cellBuilder: (_, record) => Align(
      alignment: AlignmentDirectional.centerStart,
      child: {{valuePrefix}}DashboardStatusChip(record.status),
    ),
  ),
  RemixDataTableColumn(
    id: 'amount',
    label: 'Amount',
    width: const FixedColumnWidth(96),
    alignment: AlignmentDirectional.centerEnd,
    cellBuilder: (_, record) => _cell(record.amount, emphasized: true),
  ),
];
