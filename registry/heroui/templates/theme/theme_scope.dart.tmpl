import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';

import 'theme_data.dart';
import 'tokens.dart';

/// Installs a [{{typePrefix}}ThemeData] for a subtree.
///
/// Two things are installed together on purpose:
///
/// * an inherited theme so application code can read the raw values through
///   [{{typePrefix}}Theme.of];
/// * a `MixScope` carrying the same values keyed by `{{typePrefix}}Tokens`, so every Mix
///   styler resolved below this point sees them.
///
/// The outermost scope also sets the page up: it paints the theme's
/// `background` behind [child] and gives bare [Text] the theme's body run and
/// bare [Icon]s its `foreground`. A nested scope whose theme has a different
/// `foreground` recolors both for its subtree.
/// Place it below the application host so those defaults apply:
///
/// ```dart
/// WidgetsApp(
///   color: const Color(0xFFFFFFFF),
///   pageRouteBuilder: <T>(settings, builder) => PageRouteBuilder<T>(
///     settings: settings,
///     pageBuilder: (context, animation, secondaryAnimation) => builder(context),
///   ),
///   builder: (context, child) => {{typePrefix}}Theme(child: child!),
///   home: const HomePage(),
/// )
/// ```
///
/// Each supplied theme replaces the values for its appearance. An empty nested
/// scope inherits the parent pair and selection; individual tokens do not merge.
class {{typePrefix}}Theme extends StatelessWidget {
  /// A root follows the system and supplies both preset defaults.
  /// A custom theme without [darkTheme] is used in both modes.
  /// Nested scopes inherit the configured pair and active selection.
  const {{typePrefix}}Theme({
    super.key,
    this.theme,
    this.darkTheme,
    this.mode,
    required this.child,
  });

  /// Values used for the light appearance, and for both when [darkTheme] is
  /// omitted.
  final {{typePrefix}}ThemeData? theme;

  /// Values used for the dark appearance.
  final {{typePrefix}}ThemeData? darkTheme;

  /// Appearance selection. A null mode inherits the ancestor's selection, or
  /// follows the system at the root.
  final {{typePrefix}}ThemeMode? mode;

  /// The subtree that resolves against the selected theme.
  final Widget child;

  /// The closest [{{typePrefix}}ThemeData], or `null` when no [{{typePrefix}}Theme] is
  /// installed.
  static {{typePrefix}}ThemeData? maybeOf(BuildContext context) =>
      context.dependOnInheritedWidgetOfExactType<_{{typePrefix}}InheritedTheme>()?.data;

  /// The closest [{{typePrefix}}ThemeData].
  ///
  /// Throws when no [{{typePrefix}}Theme] is installed above [context]; use
  /// [maybeOf] when absence is a valid state.
  static {{typePrefix}}ThemeData of(BuildContext context) {
    final data = maybeOf(context);
    if (data != null) return data;

    throw FlutterError.fromParts([
      ErrorSummary('No {{typePrefix}}Theme found.'),
      ErrorDescription(
        '${context.widget.runtimeType} tried to read the UI theme, but no '
        '{{typePrefix}}Theme was found above it.',
      ),
      context.describeElement('The context used was'),
    ]);
  }

  @override
  Widget build(BuildContext context) {
    // `mode: system` needs a platform brightness. A scope mounted above any
    // MediaQuery still has to resolve, so supply one from the view. The
    // lookup does not subscribe, so unrelated MediaQuery changes (keyboard
    // insets, padding) do not rebuild the app below the scope.
    final view = View.maybeOf(context);
    final hasMediaQuery =
        context.getElementForInheritedWidgetOfExactType<MediaQuery>() != null;
    if (!hasMediaQuery && view != null) {
      return MediaQuery.fromView(
        view: view,
        child: Builder(builder: _build),
      );
    }

    return _build(context);
  }

  Widget _build(BuildContext context) {
    final inherited = context
        .dependOnInheritedWidgetOfExactType<_{{typePrefix}}InheritedTheme>();
    final base = theme ?? inherited?.baseTheme ?? const {{typePrefix}}ThemeData.light();
    final dark =
        darkTheme ??
        theme ??
        inherited?.darkTheme ??
        const {{typePrefix}}ThemeData.dark();
    final useDark = mode == null && inherited != null
        ? inherited.usesDarkTheme
        : switch (mode ?? {{typePrefix}}ThemeMode.system) {
            {{typePrefix}}ThemeMode.light => false,
            {{typePrefix}}ThemeMode.dark => true,
            {{typePrefix}}ThemeMode.system =>
              (MediaQuery.maybePlatformBrightnessOf(context) ??
                      Brightness.light) ==
                  Brightness.dark,
          };
    final selected = useDark ? dark : base;
    final tokens = selected.tokens;
    Widget scoped = MixScope(tokens: tokens, child: child);
    // Only the outermost scope sets the page up. A nested scope must not
    // reinstall the root text run, which would silently replace whatever
    // `DefaultTextStyle` the subtree sits in, nor paint a second background
    // over a card or a panel. But a nested scope that switches to a theme with
    // a different `foreground` (a region shown in the other brightness, say)
    // recolors the run it inherits, so bare text and icons below it stay
    // readable on the surfaces its own recipes paint.
    if (inherited == null) {
      scoped = ColoredBox(
        color: tokens[{{typePrefix}}Tokens.background]! as Color,
        child: _rootTextStyle(tokens: tokens, child: scoped),
      );
    } else if (inherited.data.color({{typePrefix}}Tokens.foreground) !=
        selected.color({{typePrefix}}Tokens.foreground)) {
      scoped = _recolored(tokens[{{typePrefix}}Tokens.foreground]! as Color, scoped);
    }

    return _{{typePrefix}}InheritedTheme(
      baseTheme: base,
      darkTheme: dark,
      usesDarkTheme: useDark,
      child: scoped,
    );
  }
}

/// The text run a bare [Text] below the root scope inherits.
///
/// The theme's font at `textBase`, in `foreground`, so a `Text` with no style of
/// its own reads as body copy in the theme's color in both brightnesses —
/// instead of inheriting whatever the host set up, which in a dark theme is
/// often dark text on a dark page.
///
/// Recipes still set their own sizes and colors; this is only the fallback,
/// and a nearer `DefaultTextStyle` wins through Flutter's normal inheritance.
/// Place the scope *below* a Material or Cupertino host (in its `builder`) so
/// the host's own text defaults do not sit between the two. A `Material`
/// below the scope (a `Scaffold`, a `Card`) sets its own text style from the
/// host's `ThemeData`, so give that `ThemeData` the scope's brightness.
///
/// A bare [Icon] takes `foreground` too, the color of the text beside it; its
/// size is left to the host.
Widget _rootTextStyle({
  required Map<MixToken<Object?>, Object> tokens,
  required Widget child,
}) {
  final body = tokens[{{typePrefix}}Tokens.textBase]! as TextStyle;
  final foreground = tokens[{{typePrefix}}Tokens.foreground]! as Color;

  return DefaultTextStyle(
    style: body.copyWith(color: foreground, fontWeight: FontWeight.w400),
    child: IconTheme.merge(
      data: IconThemeData(color: foreground),
      child: child,
    ),
  );
}

/// The inherited text run and icon theme, recolored to [foreground] and
/// otherwise untouched.
Widget _recolored(Color foreground, Widget child) => DefaultTextStyle.merge(
  style: TextStyle(color: foreground),
  child: IconTheme.merge(
    data: IconThemeData(color: foreground),
    child: child,
  ),
);

class _ThemeComparison {
  _ThemeComparison(this.theme)
    : _overrideCount = theme.colors.length,
      _lookups = _snapshotLookups(theme.colors);

  final {{typePrefix}}ThemeData theme;
  final int _overrideCount;
  final Map<ColorToken, Color?> _lookups;

  static final _paletteKeys = {
    ...const {{typePrefix}}ThemeData.light().tokens.keys.whereType<ColorToken>(),
    ...const {{typePrefix}}ThemeData.dark().tokens.keys.whereType<ColorToken>(),
  };

  static Map<ColorToken, Color?> _snapshotLookups(
    Map<ColorToken, Color> colors,
  ) {
    if (colors.isEmpty) return const {};

    final lookups = Map<ColorToken, Color?>.identity()
      ..addAll(colors)
      ..addEntries(_paletteKeys.map((token) => MapEntry(token, colors[token])));
    for (final token in colors.keys) {
      final alias = ColorToken(token.name);
      if (alias == token) lookups[alias] = colors[alias];
    }
    return lookups;
  }

  bool differsFrom(_ThemeComparison old) {
    if (theme != old.theme) return true;

    final colors = theme.colors;
    return colors.length != old._overrideCount ||
        old._lookups.entries.any((entry) => colors[entry.key] != entry.value);
  }
}

/// The inherited half of [{{typePrefix}}Theme].
///
/// Kept private so callers always mount [{{typePrefix}}Theme], which installs the
/// matching `MixScope` alongside the inherited data, while
/// `InheritedTheme.wrap` can still rebuild both across a route boundary.
class _{{typePrefix}}InheritedTheme extends InheritedTheme {
  _{{typePrefix}}InheritedTheme({
    required {{typePrefix}}ThemeData baseTheme,
    required {{typePrefix}}ThemeData darkTheme,
    required this.usesDarkTheme,
    required super.child,
  }) : _base = _ThemeComparison(baseTheme) {
    _dark = identical(baseTheme, darkTheme)
        ? _base
        : _ThemeComparison(darkTheme);
  }

  final _ThemeComparison _base;
  late final _ThemeComparison _dark;

  /// The theme values available to [child].
  {{typePrefix}}ThemeData get data => usesDarkTheme ? darkTheme : baseTheme;

  /// The configured light values, carried so a nested scope can inherit them.
  {{typePrefix}}ThemeData get baseTheme => _base.theme;

  /// The configured dark values, carried so a nested scope can inherit them.
  {{typePrefix}}ThemeData get darkTheme => _dark.theme;

  /// Whether the dark half of the configured pair is currently selected.
  final bool usesDarkTheme;

  /// Rebuilds the theme *and* its Mix scope for a captured subtree.
  ///
  /// `InheritedTheme.capture` only carries `InheritedTheme`s across a route
  /// boundary. `MixScope` is a plain `InheritedModel`, so without rebuilding
  /// it here a captured subtree would keep the theme values and lose the
  /// token values that recipes actually resolve.
  @override
  Widget wrap(BuildContext context, Widget child) {
    return _{{typePrefix}}InheritedTheme(
      baseTheme: baseTheme,
      darkTheme: darkTheme,
      usesDarkTheme: usesDarkTheme,
      child: MixScope(tokens: data.tokens, child: child),
    );
  }

  @override
  bool updateShouldNotify(_{{typePrefix}}InheritedTheme oldWidget) =>
      usesDarkTheme != oldWidget.usesDarkTheme ||
      _base.differsFrom(oldWidget._base) ||
      _dark.differsFrom(oldWidget._dark);
}
