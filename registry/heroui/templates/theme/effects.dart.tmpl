import 'dart:math' as math;

import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
import 'tokens.dart';

/// `focus-ring`: a ring with a background-colored separation.
RemixBoxEffectsMix {{valuePrefix}}FocusRing({
  Color? color,
  double offset = {{typePrefix}}Tokens.ringOffset,
  double width = {{typePrefix}}Tokens.focusWidth,
}) => RemixBoxEffectsMix(
  outline: BorderSideMix(color: color ?? {{typePrefix}}Tokens.focus(), width: width),
  outlineOffset: offset,
  // CSS ring-offset paints background, not transparent space. Outer shadows
  // are clipped to the outside of the shape by Remix's effect renderer.
  overContent: offset > 0
      ? RemixBoxEffectLayerMix(
          shadows: [
            RemixBoxShadowMix(
              color: {{typePrefix}}Tokens.background(),
              spreadRadius: offset,
            ),
          ],
        )
      : null,
);

/// `invalid-field-ring`: a 1px danger outline with no offset.
///
/// [focused] is the 2px ring of a field that takes focus itself (a select
/// trigger, a text input). Controls focused through a parent, like a checkbox,
/// keep the ordinary focus ring.
RemixBoxEffectsMix {{valuePrefix}}InvalidRing({bool focused = false}) =>
    RemixBoxEffectsMix(
      outline: BorderSideMix(
        color: {{typePrefix}}Tokens.danger(),
        width: focused ? {{typePrefix}}Tokens.focusWidth : {{typePrefix}}Tokens.invalidWidth,
      ),
      outlineOffset: 0,
      overContent: RemixBoxEffectLayerMix(shadows: const []),
    );

/// `--surface-shadow` and `--overlay-shadow` per mode, alphas as in the CSS.
/// Preserves layered CSS shadows and the dark overlay's inset hairline.
RemixBoxEffectsMix {{valuePrefix}}SurfaceEffects({bool overlay = false}) =>
    RemixBoxEffectsMix.behindContent(
      RemixBoxEffectLayerMix(
        shadowToken: overlay ? {{valuePrefix}}OverlayShadow : {{valuePrefix}}SurfaceShadow,
      ),
    );

const {{valuePrefix}}SurfaceShadow = RemixBoxShadowListToken('{{valuePrefix}}.shadow.surface');

/// `--surface-shadow` for stylers without an effects slot (tabs, toggles).
///
/// Dark mode defines no surface shadow; these low-alpha black shadows are not
/// visible on its dark surfaces, so one list serves both modes.
final {{valuePrefix}}SurfaceBoxShadows = _boxShadows({{valuePrefix}}Shadows(Brightness.light));

/// `--overlay-shadow` for stylers without an effects slot (tooltip).
///
/// Dark mode adds a 1px inset hairline that a box shadow cannot draw, so the
/// light layers serve both modes.
final {{valuePrefix}}OverlayBoxShadows = _boxShadows(
  {{valuePrefix}}Shadows(Brightness.light, overlay: true),
);

List<BoxShadowMix> _boxShadows(List<RemixBoxShadow> shadows) => [
  for (final shadow in shadows)
    BoxShadowMix(
      color: shadow.color,
      offset: shadow.offset,
      blurRadius: shadow.blurRadius,
      spreadRadius: shadow.spreadRadius,
    ),
];

const {{valuePrefix}}OverlayShadow = RemixBoxShadowListToken('{{valuePrefix}}.shadow.overlay');

/// The layers of `--surface-shadow`, or of `--overlay-shadow` when [overlay]
/// is set, in [brightness].
List<RemixBoxShadow> {{valuePrefix}}Shadows(
  Brightness brightness, {
  bool overlay = false,
}) {
  if (brightness == Brightness.dark) {
    return overlay
        ? const [
            RemixBoxShadow(
              kind: RemixBoxShadowKind.inset,
              color: Color.fromRGBO(255, 255, 255, .3),
              blurRadius: 1,
            ),
          ]
        : const [];
  }
  return overlay
      ? const [
          RemixBoxShadow(
            color: Color.fromRGBO(0, 0, 0, .06),
            offset: Offset(0, 2),
            blurRadius: 8,
          ),
          RemixBoxShadow(
            color: Color.fromRGBO(0, 0, 0, .03),
            offset: Offset(0, -6),
            blurRadius: 12,
          ),
          RemixBoxShadow(
            color: Color.fromRGBO(0, 0, 0, .08),
            offset: Offset(0, 14),
            blurRadius: 28,
          ),
        ]
      : const [
          RemixBoxShadow(
            color: Color.fromRGBO(0, 0, 0, .04),
            offset: Offset(0, 2),
            blurRadius: 4,
          ),
          RemixBoxShadow(
            color: Color.fromRGBO(0, 0, 0, .06),
            offset: Offset(0, 1),
            blurRadius: 2,
          ),
          RemixBoxShadow(color: Color.fromRGBO(0, 0, 0, .06), blurRadius: 1),
        ];
}

/// `focus-ring` as a border, for parts whose styler has no `containerEffects`
/// (tab, toggle, select and menu items, accordion and disclosure triggers).
///
/// Transparent at rest and recoloured on keyboard focus, so nothing shifts;
/// pair it with [{{valuePrefix}}InsideRing] on the padding.
BorderMix {{valuePrefix}}RingBorder({bool focused = false}) => BorderMix.all(
  BorderSideMix(
    color: focused ? {{typePrefix}}Tokens.focus() : {{typePrefix}}Tokens.transparent,
    width: {{typePrefix}}Tokens.focusWidth,
  ),
);

/// A content inset less the ring border that sits inside it: `px-4` is
/// `{{valuePrefix}}InsideRing(16)`.
double {{valuePrefix}}InsideRing(double inset) => inset - {{typePrefix}}Tokens.focusWidth;

/// [source] at [alpha] of its own opacity: Tailwind `bg-x/N` and
/// `color-mix(in srgb, x N%, transparent)`.
///
/// Keep the result in a top-level final; a [ContextToken] compares by
/// identity.
ContextToken<Color> {{valuePrefix}}Alpha(ColorToken source, double alpha) =>
    ContextToken<Color>((context) {
      final color = source.resolve(context);
      return color.withValues(alpha: color.a * alpha);
    });

/// `min(max, calc(var(--radius-N) * scale))`: HeroUI caps its large surfaces
/// at 32px. `{{typePrefix}}Tokens.radiusPanel` is the `radius-3xl` case.
///
/// Keep the result in a top-level final.
ContextToken<Radius> {{valuePrefix}}Radius(
  RadiusToken base, {
  double scale = 1,
  double max = double.infinity,
}) => ContextToken<Radius>(
  (context) => Radius.circular(math.min(max, base.resolve(context).x * scale)),
);
