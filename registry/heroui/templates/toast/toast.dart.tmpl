import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';
import 'button.dart';
import 'close_button.dart';

part 'toast.g.dart';

/// HeroUI toast tones: the title and the leading icon take the status color.
enum {{typePrefix}}ToastVariant { defaultToast, accent, success, warning, danger }

/// HeroUI recipe for [RemixToast] and, as its `style`, [RemixToastScope].
///
/// Stacking, timing, and dismissal stay with Remix. The action is HeroUI's
/// default button, as in `Toast` (`toast-default-action`): beside the message
/// above 768px and under it from 768px down. Below 640px it adds `mt-2` by
/// restating the whole button style, because an `action` replaces rather than
/// merges; a caller's own `action` there must be an `onBreakpoint` fragment
/// too.
@MixWidget(target: RemixToast.new)
ToastStyler {{valuePrefix}}ToastStyle({
  {{typePrefix}}ToastVariant variant = .defaultToast,
  ToastStyler style = const ToastStyler.create(),
}) {
  final (title, icon) = switch (variant) {
    .defaultToast => (
      {{typePrefix}}Tokens.overlayForeground,
      {{typePrefix}}Tokens.overlayForeground,
    ),
    .accent => (
      {{typePrefix}}Tokens.accentSoftForeground,
      {{typePrefix}}Tokens.overlayForeground,
    ),
    .success => (
      {{typePrefix}}Tokens.successSoftForeground,
      {{typePrefix}}Tokens.successSoftForeground,
    ),
    .warning => (
      {{typePrefix}}Tokens.warningSoftForeground,
      {{typePrefix}}Tokens.warningSoftForeground,
    ),
    .danger => (
      {{typePrefix}}Tokens.dangerSoftForeground,
      {{typePrefix}}Tokens.dangerSoftForeground,
    ),
  };

  return ToastStyler()
      .direction(.horizontal)
      .crossAxisAlignment(.start)
      .spacing(_gap)
      .padding(.horizontal(_paddingX).vertical(_paddingY))
      .color({{typePrefix}}Tokens.surface())
      .borderRadius(.all({{typePrefix}}Tokens.radiusPanel()))
      .containerEffects({{valuePrefix}}SurfaceEffects(overlay: true))
      // `.toast__indicator`: a `size-4` icon with `p-1` around it.
      .icon(
        IconStyler()
            .size(_icon)
            .color(icon())
            .wrap(.padding(EdgeInsetsGeometryMix.all(_iconPadding))),
      )
      .title(
        TextStyler(
          style: {{typePrefix}}Tokens.textSm.mix(),
        ).fontWeight(.w500).color(title()),
      )
      .description(
        TextStyler(
          style: {{typePrefix}}Tokens.textSm.mix(),
        ).color({{typePrefix}}Tokens.muted()),
      )
      .action({{valuePrefix}}ButtonStyle())
      .closeButton(_closeButton)
      .onBreakpoint(
        const Breakpoint.maxWidth({{typePrefix}}Tokens.breakpointMd),
        ToastStyler().actionPlacement(.below),
      )
      .onBreakpoint(
        const Breakpoint.maxWidth(_belowSm),
        ToastStyler().action({{valuePrefix}}ButtonStyle().margin(.top(_actionMargin))),
      )
      .merge(style);
}

/// `.toast__close-button` on top of the close button: `size-5` with a
/// `size-3.5` icon and `bg-default` on hover; from `sm` up it gains the border
/// and the overlay fill, and its icon is `size-3`.
final _closeButton = {{valuePrefix}}CloseButtonStyle()
    .size(_closeSize, _closeSize)
    .icon(.size(_closeIcon))
    .onHovered(IconButtonStyler().color({{typePrefix}}Tokens.defaultColor()))
    .onBreakpoint(
      const Breakpoint.minWidth({{typePrefix}}Tokens.breakpointSm),
      IconButtonStyler()
          .color({{typePrefix}}Tokens.overlay())
          .border(.all(.color({{typePrefix}}Tokens.border()).width(_closeBorder)))
          .icon(.size(_closeIconFromSm))
          .onHovered(IconButtonStyler().color({{typePrefix}}Tokens.defaultColor())),
    );

/// `.toast` `px-4 py-3 gap-1.5`.
const _paddingX = 16.0;
const _paddingY = 12.0;
const _gap = 6.0;

/// `.toast__action`: `mt-2 sm:mt-0`. A stacked action is already `gap-1.5`
/// below the message, so the margin adds the rest of `mt-2` below `sm`, whose
/// `maxWidth` is the pixel before 640.
const _actionMargin = 8 - _gap;
const _belowSm = {{typePrefix}}Tokens.breakpointSm - 1;

/// `.toast__indicator` `size-4` with `p-1`, and `.toast__close-button`
/// `size-5`.
const _icon = 16.0;
const _iconPadding = 4.0;
const _closeSize = 20.0;

/// `size-3.5`, `sm:size-3`, and `sm:border`.
const _closeIcon = 14.0;
const _closeIconFromSm = 12.0;
const _closeBorder = 1.0;
