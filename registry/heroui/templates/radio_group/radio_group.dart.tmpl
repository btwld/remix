import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';
import 'field_layout.dart';
import 'radio.dart';

/// One option of a [{{typePrefix}}RadioGroup].
class {{typePrefix}}RadioOption<T> {
  const {{typePrefix}}RadioOption({
    required this.value,
    required this.label,
    this.description,
    this.enabled = true,
  });

  final T value;
  final String label;
  final String? description;
  final bool enabled;
}

/// A [RemixRadioGroup] of labeled [{{typePrefix}}Radio] options.
///
/// [variant], [invalid], and [enabled] apply to every option. While [invalid],
/// [errorText] shows after [helperText].
class {{typePrefix}}RadioGroup<T> extends StatelessWidget {
  const {{typePrefix}}RadioGroup({
    super.key,
    required this.groupValue,
    required this.options,
    this.onChanged,
    this.orientation = Axis.vertical,
    this.variant = .primary,
    this.invalid = false,
    this.enabled = true,
    this.label,
    this.helperText,
    this.errorText,
  });

  final T? groupValue;
  final List<{{typePrefix}}RadioOption<T>> options;
  final ValueChanged<T?>? onChanged;
  final Axis orientation;
  final {{typePrefix}}RadioVariant variant;
  final bool invalid;
  final bool enabled;
  final String? label;
  final String? helperText;
  final String? errorText;

  @override
  Widget build(BuildContext context) {
    final items = [
      for (final option in options)
        _row(option, optionEnabled: enabled && option.enabled),
    ];
    return RemixRadioGroup<T>(
      groupValue: groupValue,
      onChanged: onChanged,
      enabled: enabled,
      semanticLabel: label,
      child: {{typePrefix}}FieldLayout(
        axis: orientation,
        label: label,
        helperText: helperText,
        errorText: errorText,
        invalid: invalid,
        enabled: enabled,
        items: items,
      ),
    );
  }

  Widget _row({{typePrefix}}RadioOption<T> option, {required bool optionEnabled}) =>
      {{typePrefix}}DescribedControl(
        descriptionInset: {{valuePrefix}}RadioSize + {{valuePrefix}}ControlGap,
        enabled: optionEnabled,
        description: option.description,
        control: {{typePrefix}}Radio<T>(
          value: option.value,
          label: option.label,
          variant: variant,
          invalid: invalid,
          enabled: optionEnabled,
        ),
      );
}
