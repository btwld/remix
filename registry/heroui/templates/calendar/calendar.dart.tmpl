/// The application's Calendar style recipe.
///
/// Remix owns rendering, selection, navigation, focus and date semantics.
/// This supplies theme typography, transparent resting days and the visual
/// states. The inset focus band uses the shared ring tint and stroke without
/// changing layout; a calendar's scrolling grid clips an outside ring.
CalendarStyler {{valuePrefix}}CalendarStyle({
  CalendarStyler style = const CalendarStyler.create(),
}) => CalendarStyler()
    .padding(.all(12.0))
    .headerSpacing(16.0)
    .weekdaySpacing(12.0)
    .rowSpacing(4.0)
    .selectorSpacing(4.0)
    // `.calendar__header-cell`: `text-xs font-medium text-muted`.
    .weekday(
      .style(
        {{typePrefix}}Tokens.textXs.mix(),
      ).fontWeight(.w500).color({{typePrefix}}Tokens.muted()),
    )
    .day(
      CalendarDayStyler()
          .minWidth({{valuePrefix}}CalendarTarget)
          .minHeight({{valuePrefix}}CalendarTarget)
          .alignment(.center)
          .color(_clear())
          .border(.color(_clear()).width(1.0))
          .borderRadius(
            .only(
              topStart: {{typePrefix}}Tokens.radius3xl(),
              topEnd: {{typePrefix}}Tokens.radius3xl(),
              bottomStart: {{typePrefix}}Tokens.radius3xl(),
              bottomEnd: {{typePrefix}}Tokens.radius3xl(),
            ),
          )
          .label(
            .style(
              {{typePrefix}}Tokens.textSm.mix(),
            ).fontWeight(FontWeight.w500).color({{typePrefix}}Tokens.foreground()),
          )
          .onToday(
            CalendarDayStyler()
                .color({{typePrefix}}Tokens.accentSoft())
                .border(.color({{typePrefix}}Tokens.accentSoftForeground()))
                .label(
                  .fontWeight(
                    FontWeight.w600,
                  ).color({{typePrefix}}Tokens.accentSoftForeground()),
                ),
          )
          .onSelected(
            CalendarDayStyler()
                .color({{typePrefix}}Tokens.accent())
                .label(.color({{typePrefix}}Tokens.accentForeground())),
          )
          // Reserve range keys before pointer states: Mix keeps a key's first
          // position when the range recipe supplies its role fragments.
          .onRangeStart(CalendarDayStyler())
          .onRangeMiddle(CalendarDayStyler())
          .onRangeEnd(CalendarDayStyler())
          .onRangeSingle(CalendarDayStyler())
          .onRangePreview(CalendarDayStyler())
          .onHovered(
            CalendarDayStyler()
                .color({{typePrefix}}Tokens.defaultColor())
                .label(.color({{typePrefix}}Tokens.foreground()))
                .onSelected(_solidPointer({{typePrefix}}Tokens.accent))
                .onRangeMiddle(
                  CalendarDayStyler()
                      .color({{typePrefix}}Tokens.accentSoftHover())
                      .label(.color({{typePrefix}}Tokens.foreground())),
                )
                .onRangePreview(
                  CalendarDayStyler()
                      .color({{typePrefix}}Tokens.accentSoft())
                      .label(.color({{typePrefix}}Tokens.foreground())),
                ),
          )
          .onPressed(
            CalendarDayStyler()
                .color({{typePrefix}}Tokens.defaultHover())
                .label(.color({{typePrefix}}Tokens.foreground()))
                .onSelected(_solidPointer({{typePrefix}}Tokens.accentHover))
                .onRangeMiddle(
                  CalendarDayStyler()
                      .color({{typePrefix}}Tokens.accentSoftHover())
                      .label(.color({{typePrefix}}Tokens.foreground())),
                )
                .onRangePreview(
                  CalendarDayStyler()
                      .color({{typePrefix}}Tokens.accentSoftHover())
                      .label(.color({{typePrefix}}Tokens.foreground())),
                ),
          )
          // One inset outline follows the resolved day or range-cap shape,
          // so the day's own border gives way to it.
          .onFocusVisible(
            CalendarDayStyler()
                .border(.all(.color(_clear()).width(0).style(BorderStyle.none)))
                .containerEffects(
                  RemixBoxEffectsMix(
                    outline: BorderSideMix(
                      color: {{typePrefix}}Tokens.foreground(),
                      width: 2.0,
                    ),
                    outlineOffset: -2.0,
                  ),
                ),
          )
          .onDisabled(
            CalendarDayStyler()
                .label(.color({{typePrefix}}Tokens.muted()))
                .wrap(.opacity({{typePrefix}}Tokens.disabledOpacity))
                .onSelected(
                  CalendarDayStyler()
                      .color(_quietSelected())
                      .label(.color({{typePrefix}}Tokens.muted()))
                      .wrap(.opacity(1)),
                ),
          )
          .onUnavailable(
            CalendarDayStyler()
                .label(
                  .color(
                    {{typePrefix}}Tokens.muted(),
                  ).decoration(TextDecoration.lineThrough),
                )
                .wrap(.opacity(1))
                .variant(
                  _calendarDisabled,
                  CalendarDayStyler().wrap(
                    .opacity({{typePrefix}}Tokens.disabledOpacity),
                  ),
                ),
          ),
    )
    .variant(
      _calendarDisabled,
      CalendarStyler().weekday(
        .color(
          {{typePrefix}}Tokens.muted(),
        ).wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
      ),
    )
    .merge(style);

/// A fully transparent `foreground`: resting days have no fill or border.
final _clear = {{valuePrefix}}Alpha({{typePrefix}}Tokens.foreground, 0);

/// A hovered or pressed selected day: a solid fill under the accent text.
CalendarDayStyler _solidPointer(ColorToken fill) => CalendarDayStyler()
    .color(fill())
    .label(.color({{typePrefix}}Tokens.accentForeground()));

/// Matches while the calendar, or the range calendar, is disabled.
final _calendarDisabled = ContextVariant(
  '{{valuePrefix}}.calendar.disabled',
  (context) =>
      (NakedCalendarState.maybeOf(context)?.states ??
              NakedRangeCalendarState.maybeOf(context)?.states ??
              const <WidgetState>{})
          .contains(WidgetState.disabled),
);

/// The fill of a selected day that cannot be used: `surface-tertiary` on the
/// endpoints of a range, `surface-secondary` elsewhere.
final _quietSelected = ContextToken<Color>((context) {
  final value = NakedRangeCalendarState.maybeOf(context)?.value;
  final day = NakedCalendarDayState.maybeOf(context)?.date;
  final cap =
      value != null &&
      day != null &&
      (compareCivilDates(day, value.start) == 0 ||
          compareCivilDates(day, value.end) == 0);

  return (cap ? {{typePrefix}}Tokens.surfaceTertiary : {{typePrefix}}Tokens.surfaceSecondary)
      .resolve(context);
});

/// The side of a day tile: `calendar.css` `w-63` over seven columns.
const {{valuePrefix}}CalendarTarget = 36.0;

/// A day tile's side at the current text scale, so tiles grow with text.
double {{valuePrefix}}CalendarDayWidth(BuildContext context) =>
    MediaQuery.textScalerOf(context).scale({{valuePrefix}}CalendarTarget);

/// Sizes a calendar to its day tiles: seven columns plus the 12px padding on
/// each side.
///
/// The widgets merge the caller's style over this.
CalendarStyler {{valuePrefix}}CalendarGeometry(BuildContext context) => CalendarStyler()
    .minWidth({{valuePrefix}}CalendarDayWidth(context) * DateTime.daysPerWeek + 2 * 12.0)
    .day(
      CalendarDayStyler()
          .minWidth({{valuePrefix}}CalendarDayWidth(context))
          .minHeight({{valuePrefix}}CalendarDayWidth(context)),
    );

/// The month navigation buttons: 24px ghost squares that grow with text.
IconButtonStyler {{valuePrefix}}CalendarNavigationStyle(BuildContext context) {
  final scaler = MediaQuery.textScalerOf(context);

  return IconButtonStyler()
      .size(scaler.scale(24), scaler.scale(24))
      .padding(.all(0))
      .alignment(.center)
      .borderRadius(.all({{typePrefix}}Tokens.radius2xl()))
      .icon(.size(scaler.scale(16)).color({{typePrefix}}Tokens.accentSoftForeground()))
      .onHovered(.color({{typePrefix}}Tokens.defaultColor()))
      .onPressed(IconButtonStyler().scale(.95))
      .onFocusVisible(.containerEffects({{valuePrefix}}FocusRing()))
      .onDisabled(
        IconButtonStyler().wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
      );
}

/// The month and year selectors: the secondary select, shrunk to a 24px-tall
/// trigger that grows with text.
SelectStyler {{valuePrefix}}CalendarSelectorStyle(BuildContext context) {
  final scaler = MediaQuery.textScalerOf(context);

  return {{valuePrefix}}SelectStyle(variant: .secondary)
      .trigger(
        SelectTriggerStyler()
            .minHeight(24)
            .padding(.horizontal(8))
            .width(scaler.scale(118))
            .indicator(.size(scaler.scale(11))),
      )
      .content(
        SelectContentStyler()
            // Four complete day rows plus their gap below the selector.
            .maxHeight(38 + scaler.scale(160))
            .maxWidth(remixAnchorWidth())
            .wrap(WidgetModifierConfig.modifier(const _CalendarScrollCueMix())),
      )
      // Keep full month names on one line at the trigger's narrow width.
      .menuContainer(FlexBoxStyler().padding(.all(4)).spacing(4))
      .item(
        SelectMenuItemStyler()
            .padding(.horizontal(4))
            .spacing(4)
            .icon(.size(12))
            .onFocusVisible(
              SelectMenuItemStyler().containerEffects({{valuePrefix}}InsetFocusRing),
            ),
      );
}

/// A modifier that keeps the selector list's scrollbar visible, so a
/// scrolling list is discoverable.
final class _CalendarScrollCueMix extends ModifierMix<_CalendarScrollCue> {
  const _CalendarScrollCueMix();

  @override
  _CalendarScrollCue resolve(BuildContext context) =>
      const _CalendarScrollCue();

  @override
  _CalendarScrollCueMix merge(_CalendarScrollCueMix? other) => other ?? this;

  @override
  List<Object?> get props => const [];
}

final class _CalendarScrollCue extends WidgetModifier<_CalendarScrollCue> {
  const _CalendarScrollCue();

  @override
  Widget build(Widget child) => ScrollConfiguration(
    behavior: const _CalendarScrollBehavior(),
    child: child,
  );

  @override
  _CalendarScrollCue copyWith() => this;

  @override
  _CalendarScrollCue lerp(_CalendarScrollCue? other, double t) => this;

  @override
  List<Object?> get props => const [];
}

class _CalendarScrollBehavior extends ScrollBehavior {
  const _CalendarScrollBehavior();

  @override
  Widget buildScrollbar(
    BuildContext context,
    Widget child,
    ScrollableDetails details,
  ) => RawScrollbar(
    controller: details.controller,
    thumbVisibility: true,
    thumbColor: {{typePrefix}}Tokens.muted.resolve(context),
    thickness: 4.0,
    child: child,
  );
}

/// HeroUI's three-letter English weekday headings; callers can localize labels.
const {{valuePrefix}}CalendarLabels = RemixCalendarLabels(weekday: _{{valuePrefix}}Weekday);

String _{{valuePrefix}}Weekday(int day) =>
    const ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][day - 1];

/// HeroUI reference Calendar composition.
///
/// Remix owns civil-date selection, focus, keyboard navigation and semantics.
/// Multiple independent child styles require a hand-written facade; caller
/// overrides merge last and there is no generated adapter.
class {{typePrefix}}Calendar extends StatelessWidget {
  const {{typePrefix}}Calendar({
    super.key,
    required this.value,
    required this.firstDate,
    required this.lastDate,
    this.onChanged,
    this.currentDate,
    this.isDateUnavailable,
    this.firstDayOfWeek = DateTime.sunday,
    this.enabled = true,
    this.semanticLabel,
    this.focusNode,
    this.autofocus = false,
    this.labels = {{valuePrefix}}CalendarLabels,
    this.headerBuilder,
    this.navigationStyle = const IconButtonStyler.create(),
    this.selectorStyle = const SelectStyler.create(),
    this.style = const CalendarStyler.create(),
    this.styleSpec,
  });

  /// Parent-owned selected date, compared by year/month/day fields.
  final DateTime? value;

  /// Inclusive earliest selectable date; time and UTC flag are ignored.
  final DateTime firstDate;

  /// Inclusive latest selectable date, on or after [firstDate].
  final DateTime lastDate;

  /// Requests a selected date. Null disables the calendar.
  ///
  /// The parent decides whether to accept it by updating [value].
  final ValueChanged<DateTime>? onChanged;

  /// Today, for the `onToday` variant and fallback focus; defaults to now.
  final DateTime? currentDate;

  /// Marks in-range dates unselectable; they stay keyboard-focusable.
  final bool Function(DateTime)? isDateUnavailable;

  /// First weekday column, from Monday=1 through Sunday=7.
  final int firstDayOfWeek;

  /// Whether navigation, focus and selection are enabled.
  final bool enabled;

  /// Accessible name of the calendar group.
  final String? semanticLabel;

  /// Focus entry point; requesting it focuses the current day.
  final FocusNode? focusNode;

  /// Whether to focus the current day on mount.
  final bool autofocus;

  /// Caller-owned labels and date formatters; English by default.
  final RemixCalendarLabels labels;

  /// Replaces header visuals/navigation only. Day behavior remains owned.
  final Widget Function(BuildContext, NakedCalendarState)? headerBuilder;

  /// Independent button styling, resolved in each navigation button state.
  final IconButtonStyler navigationStyle;

  /// Independent month/year selector styling.
  final SelectStyler selectorStyle;

  /// Calendar and day styling, resolved in each part's own state.
  final CalendarStyler style;

  /// Raw resolved spec; bypasses [style] and inherited styles.
  final CalendarSpec? styleSpec;

  /// Creates a [CalendarStyler], for `RemixCalendar.styleFrom(...)`.
  static const styleFrom = CalendarStyler.new;

  @override
  Widget build(BuildContext context) => RemixCalendar(
    value: value,
    firstDate: firstDate,
    lastDate: lastDate,
    onChanged: onChanged,
    currentDate: currentDate,
    isDateUnavailable: isDateUnavailable,
    firstDayOfWeek: firstDayOfWeek,
    enabled: enabled,
    semanticLabel: semanticLabel,
    focusNode: focusNode,
    autofocus: autofocus,
    labels: labels,
    headerBuilder: headerBuilder,
    navigationStyle: {{valuePrefix}}CalendarNavigationStyle(
      context,
    ).merge(navigationStyle),
    selectorStyle: {{valuePrefix}}CalendarSelectorStyle(context).merge(selectorStyle),
    style: {{valuePrefix}}CalendarStyle(
      style: {{valuePrefix}}CalendarGeometry(context).merge(style),
    ),
    styleSpec: styleSpec,
  );
}
