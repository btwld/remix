import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'toggle_button.g.dart';

/// HeroUI toggle button variants, with the `--toggle-button-bg`, `-bg-hover`,
/// and `-fg` tokens of each. `defaultToggle` is the `default` variant, on the
/// default fill; `ghost` is transparent until hovered. A null [fill] is
/// transparent.
enum {{typePrefix}}ToggleButtonVariant {
  defaultToggle(
    fill: {{typePrefix}}Tokens.defaultColor,
    hover: {{typePrefix}}Tokens.defaultHover,
    foreground: {{typePrefix}}Tokens.foreground,
  ),
  ghost(
    hover: {{typePrefix}}Tokens.defaultColor,
    foreground: {{typePrefix}}Tokens.defaultForeground,
  );

  const {{typePrefix}}ToggleButtonVariant({
    this.fill,
    required this.hover,
    required this.foreground,
  });

  final ColorToken? fill;
  final ColorToken hover;
  final ColorToken foreground;
}

/// A value that changes at a breakpoint: [mobile] by default, [desktop] from
/// the one the CSS names.
typedef {{typePrefix}}Responsive = ({double mobile, double desktop});

/// HeroUI toggle button sizes, with the `.toggle-button` and `--sm`/`--lg`
/// metrics of each. Heights step down from `md` (768px), icons from `sm`
/// (640px).
enum {{typePrefix}}ToggleButtonSize {
  // `h-9 px-3 md:h-8`, icons `size-4`, `scale(0.98)` while pressed.
  sm(
    height: (mobile: 36, desktop: 32),
    paddingX: 12,
    text: {{typePrefix}}Tokens.textSm,
    icon: (mobile: 16, desktop: 16),
    pressedScale: 0.98,
  ),
  // `h-10 px-4 md:h-9`, icons `size-5 sm:size-4`, `scale(0.97)`.
  md(
    height: (mobile: 40, desktop: 36),
    paddingX: 16,
    text: {{typePrefix}}Tokens.textSm,
    icon: (mobile: 20, desktop: 16),
    pressedScale: 0.97,
  ),
  // `h-11 px-4 text-base md:h-10`, icons as `md`, `scale(0.96)`.
  lg(
    height: (mobile: 44, desktop: 40),
    paddingX: 16,
    text: {{typePrefix}}Tokens.textBase,
    icon: (mobile: 20, desktop: 16),
    pressedScale: 0.96,
  );

  const {{typePrefix}}ToggleButtonSize({
    required this.height,
    required this.paddingX,
    required this.text,
    required this.icon,
    required this.pressedScale,
  });

  final {{typePrefix}}Responsive height;
  final double paddingX;
  final TextStyleToken text;
  final {{typePrefix}}Responsive icon;
  final double pressedScale;
}

/// HeroUI recipe for [RemixToggle].
///
/// Sizes are mobile-first, as in the CSS: heights step down at the `md`
/// breakpoint and icons at `sm`. [iconOnly] makes the button square, for a
/// toggle with an icon and no label.
///
/// A transparent ring-width border is always present so keyboard focus
/// recolors it without moving the label; upstream draws the ring outside,
/// which the toggle styler cannot. The pressed scale shares the 100ms fill
/// motion; upstream eases `transform` over 250ms.
@MixWidget(target: RemixToggle.new)
ToggleStyler {{valuePrefix}}ToggleButtonStyle({
  {{typePrefix}}ToggleButtonVariant variant = .defaultToggle,
  {{typePrefix}}ToggleButtonSize size = .md,
  bool iconOnly = false,
  ToggleStyler style = const ToggleStyler.create(),
}) {
  final fill = variant.fill?.call() ?? {{typePrefix}}Tokens.transparent;
  final hover = variant.hover();
  final foreground = variant.foreground();

  var result =
      ToggleStyler(
            container: FlexBoxStyler()
                .mainAxisSize(.min)
                .mainAxisAlignment(.center)
                .spacing({{valuePrefix}}ToggleButtonGap),
            label: TextStyler()
                .style(size.text.mix())
                .fontWeight(.w500)
                .color(foreground),
            icon: IconStyler().size(size.icon.mobile).color(foreground),
          )
          .height(size.height.mobile)
          .border({{valuePrefix}}RingBorder())
          .borderRadius(.all({{typePrefix}}Tokens.radius3xl()))
          .color(fill)
          .onBreakpoint(
            const Breakpoint.minWidth({{typePrefix}}Tokens.breakpointSm),
            ToggleStyler().icon(IconStyler().size(size.icon.desktop)),
          )
          .onBreakpoint(
            const Breakpoint.minWidth({{typePrefix}}Tokens.breakpointMd),
            ToggleStyler().height(size.height.desktop),
          );

  // `p-0 w-10 md:w-9` square the icon-only button.
  result = iconOnly
      ? result
            .width(size.height.mobile)
            .onBreakpoint(
              const Breakpoint.minWidth({{typePrefix}}Tokens.breakpointMd),
              ToggleStyler().width(size.height.desktop),
            )
      : result.padding(.horizontal({{valuePrefix}}InsideRing(size.paddingX)));

  return result
      .onHovered(ToggleStyler().color(hover))
      .onPressed(ToggleStyler().color(hover).scale(size.pressedScale))
      .onSelected(
        ToggleStyler()
            .color({{typePrefix}}Tokens.accentSoft())
            .labelColor({{typePrefix}}Tokens.accentSoftForeground())
            .iconColor({{typePrefix}}Tokens.accentSoftForeground())
            .onHovered(ToggleStyler().color({{typePrefix}}Tokens.accentSoftHover()))
            .onPressed(ToggleStyler().color({{typePrefix}}Tokens.accentSoftHover())),
      )
      .onFocusVisible(ToggleStyler().border({{valuePrefix}}RingBorder(focused: true)))
      .onDisabled(ToggleStyler().wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)))
      .animate({{typePrefix}}Tokens.fillMotion)
      .merge(style);
}

/// `.toggle-button`: `gap-2`, between an icon and its label. Shared with
/// `{{valuePrefix}}ToggleButtonGroupStyle`.
const {{valuePrefix}}ToggleButtonGap = 8.0;
