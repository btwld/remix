import 'package:flutter/widgets.dart';
import 'package:remix/agent.dart';
import 'package:remix/remix.dart';

import '../components/button.dart';
import '../components/disclosure.dart';
import '../theme/theme.dart';

/// Styles for a tool call: the quiet row, its output well and the approval
/// card.
@immutable
final class {{typePrefix}}AgentToolCallRecipe {
  const {{typePrefix}}AgentToolCallRecipe({
    required this.style,
    required this.disclosureStyle,
    required this.inputStyle,
    required this.allowOnceStyle,
    required this.alwaysAllowStyle,
    required this.denyStyle,
  });

  /// Styles for the row, the output well and the approval card.
  final AgentToolCallStyler style;

  /// Styles for the disclosure that opens and closes the output well.
  final DisclosureStyler disclosureStyle;

  /// Styles for the list of inputs on the approval card.
  final DataListStyler inputStyle;

  /// Styles for the card's primary action.
  final ButtonStyler allowOnceStyle;

  /// Styles for the card's scoped action.
  final ButtonStyler alwaysAllowStyle;

  /// Styles for the card's refusal.
  final ButtonStyler denyStyle;
}

/// Builds the recipe; each argument is merged last, so callers can override.
///
/// The 32px row opens an output well capped at 200px. A failed call colors
/// the well's frame and tints only the failing lines, preserving the output.
{{typePrefix}}AgentToolCallRecipe {{valuePrefix}}AgentToolCallRecipe({
  AgentToolCallStyler style = const AgentToolCallStyler.create(),
  DisclosureStyler disclosureStyle = const DisclosureStyler.create(),
  DataListStyler inputStyle = const DataListStyler.create(),
  ButtonStyler allowOnceStyle = const ButtonStyler.create(),
  ButtonStyler alwaysAllowStyle = const ButtonStyler.create(),
  ButtonStyler denyStyle = const ButtonStyler.create(),
}) => {{typePrefix}}AgentToolCallRecipe(
  style: _row().merge(_status()).merge(_well()).merge(_card()).merge(style),
  disclosureStyle: _quietDisclosure().merge(disclosureStyle),
  inputStyle: DataListStyler()
      .label(.style({{typePrefix}}Tokens.textSm.mix()).color({{typePrefix}}Tokens.muted()))
      .value(_mono({{typePrefix}}Tokens.textSm).color({{typePrefix}}Tokens.foreground()))
      .rowSpacing(4)
      .columnSpacing(24)
      .labelValueSpacing(8)
      .minLabelWidth(88)
      .merge(inputStyle),
  allowOnceStyle: {{valuePrefix}}ButtonStyle(
    variant: .primary,
    size: .sm,
    style: allowOnceStyle,
  ),
  alwaysAllowStyle: {{valuePrefix}}ButtonStyle(
    variant: .ghost,
    size: .sm,
    style: ButtonStyler()
        .label(.color({{typePrefix}}Tokens.muted()))
        .merge(alwaysAllowStyle),
  ),
  denyStyle: {{valuePrefix}}ButtonStyle(variant: .outline, size: .sm, style: denyStyle),
);

/// The row: tool icon, summary, then the meta with the tool id in monospace.
AgentToolCallStyler _row() =>
    AgentToolCallStyler(
          row: FlexBoxStyler()
              .spacing(8)
              .crossAxisAlignment(.center)
              .minHeight(32)
              .padding(.horizontal(8))
              .transform(Matrix4.translationValues(-8, 0, 0))
              .borderRadius(.all({{typePrefix}}Tokens.radiusMd())),
          icon: _glyph(),
          summary: TextStyler()
              .style({{typePrefix}}Tokens.textSm.mix())
              .fontWeight(FontWeight.w500)
              .color({{typePrefix}}Tokens.foreground()),
          meta: TextStyler()
              .style({{typePrefix}}Tokens.textXs.mix())
              .color({{typePrefix}}Tokens.muted()),
          toolId: _mono({{typePrefix}}Tokens.textXs),
          indicator: _glyph(),
        )
        .onFocused(.row(.color({{typePrefix}}Tokens.defaultColor())))
        .onHovered(.row(.color({{typePrefix}}Tokens.defaultColor())))
        .onPressed(.row(.color({{typePrefix}}Tokens.defaultHover())));

/// The status word and glyph: quiet gray, red when the call failed, and a
/// badge on the approval card.
AgentToolCallStyler _status() =>
    AgentToolCallStyler(
          status: FlexBoxStyler().spacing(4).crossAxisAlignment(.center),
          statusIcon: _glyph(size: 12),
          statusLabel: TextStyler()
              .style({{typePrefix}}Tokens.textXs.mix())
              .fontWeight(FontWeight.w500)
              .color({{typePrefix}}Tokens.muted()),
        )
        .onStatus(
          .failed,
          AgentToolCallStyler(
            statusIcon: _glyph(size: 12, color: {{typePrefix}}Tokens.danger()),
            statusLabel: TextStyler().color({{typePrefix}}Tokens.danger()),
          ),
        )
        .onStatus(
          .awaitingApproval,
          AgentToolCallStyler(
            status: FlexBoxStyler()
                .color({{typePrefix}}Tokens.accentSoft())
                .borderRadius(.all({{typePrefix}}Tokens.radiusSm()))
                .padding(.symmetric(horizontal: 8))
                .minHeight(24),
            statusLabel: TextStyler().color(
              {{typePrefix}}Tokens.accentSoftForeground(),
            ),
          ),
        );

/// The output well. Its padding sits on the text, so the tinted failing lines
/// reach the well's edges.
AgentToolCallStyler _well() =>
    AgentToolCallStyler(
          output: BoxStyler()
              .margin(.only(left: 24, top: 4))
              .padding(.vertical(8))
              .color({{typePrefix}}Tokens.surfaceSecondary())
              .borderRadius(.all({{typePrefix}}Tokens.radiusMd()))
              .border(.all(.color({{typePrefix}}Tokens.separator()).width(1))),
          outputToggle: FlexBoxStyler()
              .minHeight(32)
              .padding(.horizontal(8))
              .borderRadius(.all({{typePrefix}}Tokens.radiusMd())),
          outputToggleLabel: TextStyler()
              .style({{typePrefix}}Tokens.textXs.mix())
              .color({{typePrefix}}Tokens.muted()),
          outputMaxHeight: _wellMaxHeight,
          outputContent: BoxStyler().padding(.horizontal(12)),
          outputText: _mono(
            {{typePrefix}}Tokens.textXs,
          ).color({{typePrefix}}Tokens.foreground()).height(_wellLineHeight),
          error: BoxStyler()
              .color({{typePrefix}}Tokens.dangerSoft())
              .padding(.horizontal(12)),
          errorText: _mono(
            {{typePrefix}}Tokens.textXs,
          ).color({{typePrefix}}Tokens.danger()).height(_wellLineHeight),
        )
        .onHovered(
          AgentToolCallStyler(
            outputToggle: FlexBoxStyler().color({{typePrefix}}Tokens.defaultColor()),
            outputToggleLabel: TextStyler().color({{typePrefix}}Tokens.foreground()),
          ),
        )
        .onPressed(
          AgentToolCallStyler(
            outputToggle: FlexBoxStyler().color({{typePrefix}}Tokens.defaultHover()),
            outputToggleLabel: TextStyler().color({{typePrefix}}Tokens.foreground()),
          ),
        )
        .onFocused(.outputToggleLabel(.decoration(TextDecoration.underline)))
        .onStatus(
          .failed,
          AgentToolCallStyler(
            output: BoxStyler().border(.all(.color({{typePrefix}}Tokens.danger()))),
          ),
        );

/// The approval card: a flat panel with no shadow, an icon tile beside the
/// question, tool id, description and inputs, and a footer rule above the
/// actions.
AgentToolCallStyler _card() => AgentToolCallStyler(
  card: BoxStyler()
      .color({{typePrefix}}Tokens.surface())
      .borderRadius(.all({{typePrefix}}Tokens.radiusXl()))
      .clipBehavior(.antiAlias)
      .border(.all(.color({{typePrefix}}Tokens.border()).width(1))),
  cardBody: FlexBoxStyler().spacing(12).padding(.all(16)),
  cardIcon: BoxStyler()
      .width(32)
      .height(32)
      .color({{typePrefix}}Tokens.defaultColor())
      .borderRadius(.all({{typePrefix}}Tokens.radiusLg()))
      .alignment(.center),
  cardGlyph: _glyph(color: {{typePrefix}}Tokens.foreground()),
  cardContent: FlexBoxStyler().spacing(8),
  cardTitleRow: FlexBoxStyler().spacing(8).crossAxisAlignment(.center),
  title: TextStyler()
      .style({{typePrefix}}Tokens.textSm.mix())
      .fontWeight(FontWeight.w600)
      .color({{typePrefix}}Tokens.foreground()),
  description: TextStyler()
      .style({{typePrefix}}Tokens.textSm.mix())
      .color({{typePrefix}}Tokens.muted()),
  footer: FlexBoxStyler()
      .spacing(8)
      .crossAxisAlignment(.center)
      .padding(.symmetric(horizontal: 16, vertical: 12))
      .border(.top(.color({{typePrefix}}Tokens.separator()).width(1))),
);

/// The well's line box is 18px at 12px type.
const _wellLineHeight = 1.5;

/// The tallest the output well grows before it scrolls.
const _wellMaxHeight = 200.0;

/// A 16px glyph in quiet gray, unless [size] or [color] say otherwise.
IconStyler _glyph({double? size, Color? color}) =>
    IconStyler().size(size ?? 16).color(color ?? {{typePrefix}}Tokens.muted());

/// Tool ids, commands and output in the platform monospace stack.
TextStyler _mono(TextStyleToken size) => TextStyler()
    .style(size.mix())
    .fontFamily('Menlo')
    .fontFamilyFallback(const ['Consolas', 'monospace'])
    .color({{typePrefix}}Tokens.muted());

/// A disclosure with no frame, fill or padding of its own.
DisclosureStyler _quietDisclosure() => {{valuePrefix}}DisclosureStyle(
  style: DisclosureStyler()
      .container(
        BoxStyler()
            .color(const Color(0x00000000))
            .foregroundDecoration(BoxDecorationMix.border(.style(.none))),
      )
      .trigger(BoxStyler().color(const Color(0x00000000)).padding(.all(0)))
      .content(
        BoxStyler()
            .padding(.all(0))
            .foregroundDecoration(BoxDecorationMix.border(.style(.none))),
      )
      .onHovered(.trigger(.color(const Color(0x00000000))))
      .onPressed(.trigger(.color(const Color(0x00000000)))),
);
