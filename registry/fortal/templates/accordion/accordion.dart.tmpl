import 'dart:math' as math;

import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'accordion.g.dart';

/// The sizes an accordion comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}AccordionSize {
  /// 14px title, 16px icons and 8px padding.
  size1,

  /// 14px title, 20px icons and 12px padding. The default.
  size2,

  /// 16px title, 24px icons and 16px padding.
  size3,
}

/// The looks an accordion comes in.
enum {{typePrefix}}AccordionVariant {
  /// A near-white panel inside a 1px gray frame.
  surface,

  /// An accent-tinted panel inside a 1px accent frame.
  soft,
}

/// The {{typePrefix}} Accordion recipe.
///
/// It reads top to bottom: what every accordion shares, then the size, then
/// the variant's panel colors for rest, hover, press, focus and disabled.
@MixWidget(target: RemixAccordion.new)
AccordionStyler {{valuePrefix}}AccordionStyle({
  {{typePrefix}}AccordionVariant variant = .surface,
  {{typePrefix}}AccordionSize size = .size2,
  AccordionStyler style = const AccordionStyler.create(),
}) => _base(size)
    .merge(_scale(size))
    .merge(switch (variant) {
      .surface => _surface(size),
      .soft => _soft(size),
    })
    // Clip each painted part so its effects can extend beyond the panel.
    .container(BoxStyler().clipBehavior(.none))
    .merge(style);

/// The trigger and content shapes every accordion shares: the corners, the
/// gray text and icons, and the open state's flat joint and turned chevron.
///
/// The container owns the fill and the frame. Each part clips its own content,
/// leaving trigger effects free to paint outside the panel's edges.
AccordionStyler _base({{typePrefix}}AccordionSize size) {
  final radius = _radius(size);

  return AccordionStyler()
      .trigger(
        FlexBoxStyler()
            .direction(.horizontal)
            .minHeight({{typePrefix}}Tokens.touchTargetMin())
            .borderRadius(.all(radius))
            .clipBehavior(.antiAlias),
      )
      .leadingIcon(.color({{typePrefix}}Tokens.gray11()))
      .title(
        .fontWeight(
          {{typePrefix}}Tokens.fontWeightMedium(),
        ).color({{typePrefix}}Tokens.gray12()),
      )
      .trailingIcon(.color({{typePrefix}}Tokens.gray11()))
      .content(
        BoxStyler()
            .width(.infinity)
            .clipBehavior(.antiAlias)
            .borderRadius(
              BorderRadiusMix(bottomLeft: radius, bottomRight: radius),
            ),
      )
      .onExpanded(
        AccordionStyler()
            .trigger(
              FlexBoxStyler().borderRadius(
                BorderRadiusMix(
                  topLeft: radius,
                  topRight: radius,
                  bottomLeft: Radius.zero,
                  bottomRight: Radius.zero,
                ),
              ),
            )
            .trailingIcon(
              IconStyler().wrap(
                WidgetModifierConfig.transform(
                  transform: Matrix4.rotationZ(math.pi),
                  alignment: .center,
                ),
              ),
            ),
      );
}

/// The icon size, padding and title size of each step.
AccordionStyler _scale({{typePrefix}}AccordionSize size) => switch (size) {
  .size1 => AccordionStyler(
    trigger: FlexBoxStyler().padding(.all({{typePrefix}}Tokens.space2())),
    leadingIcon: .size({{typePrefix}}Tokens.space4()),
    title: .style({{typePrefix}}Tokens.text2.mix()),
    trailingIcon: .size({{typePrefix}}Tokens.space4()),
    content: .padding(.all({{typePrefix}}Tokens.space2())),
  ),
  .size2 => AccordionStyler(
    trigger: FlexBoxStyler().padding(.all({{typePrefix}}Tokens.space3())),
    leadingIcon: .size({{typePrefix}}Tokens.spinnerSize3()),
    title: .style({{typePrefix}}Tokens.text2.mix()),
    trailingIcon: .size({{typePrefix}}Tokens.spinnerSize3()),
    content: .padding(.all({{typePrefix}}Tokens.space3())),
  ),
  .size3 => AccordionStyler(
    trigger: FlexBoxStyler().padding(.all({{typePrefix}}Tokens.space4())),
    leadingIcon: .size({{typePrefix}}Tokens.space5()),
    title: .style({{typePrefix}}Tokens.text3.mix()),
    trailingIcon: .size({{typePrefix}}Tokens.space5()),
    content: .padding(.all({{typePrefix}}Tokens.space4())),
  ),
};

AccordionStyler _surface({{typePrefix}}AccordionSize size) => AccordionStyler()
    .container(
      {{valuePrefix}}SurfaceFrame(
        fillColor: {{typePrefix}}Tokens.gray2(),
        borderColor: {{typePrefix}}Tokens.gray6(),
        borderWidth: {{typePrefix}}Tokens.borderWidth1(),
        radius: _radius(size),
      ),
    )
    .trigger(.color({{typePrefix}}Tokens.gray1()))
    .content(
      BoxStyler()
          .foregroundDecoration(_dividerAbove({{typePrefix}}Tokens.gray6()))
          .wrap(_contentText({{typePrefix}}Tokens.gray12())),
    )
    .onHovered(.trigger(.color({{typePrefix}}Tokens.gray2())))
    .onPressed(.trigger(.color({{typePrefix}}Tokens.gray3())))
    .onFocusVisible(.triggerEffects({{valuePrefix}}FocusOutline()))
    .onDisabled(_disabled());

AccordionStyler _soft({{typePrefix}}AccordionSize size) => AccordionStyler()
    .container(
      {{valuePrefix}}SurfaceFrame(
        fillColor: {{typePrefix}}Tokens.accent2(),
        borderColor: {{typePrefix}}Tokens.accent6(),
        borderWidth: {{typePrefix}}Tokens.borderWidth1(),
        radius: _radius(size),
      ),
    )
    .trigger(.color({{typePrefix}}Tokens.accent2()))
    .title(.color({{typePrefix}}Tokens.accent12()))
    .trailingIcon(.color({{typePrefix}}Tokens.accentContent()))
    .content(
      BoxStyler()
          .foregroundDecoration(_dividerAbove({{typePrefix}}Tokens.accent6()))
          .wrap(_contentText({{typePrefix}}Tokens.accent12())),
    )
    .onHovered(.trigger(.color({{typePrefix}}Tokens.accent3())))
    .onPressed(.trigger(.color({{typePrefix}}Tokens.accent4())))
    .onFocusVisible(.triggerEffects({{valuePrefix}}FocusOutline()))
    .onDisabled(_disabled());

AccordionStyler _disabled() => AccordionStyler()
    .triggerEffects(RemixBoxEffectsMix(outline: BorderSideMix(style: .none)))
    .trigger(.color({{typePrefix}}Tokens.grayA3()))
    .leadingIcon(.color({{typePrefix}}Tokens.gray8()))
    .title(.color({{typePrefix}}Tokens.gray8()))
    .trailingIcon(.color({{typePrefix}}Tokens.gray8()));

/// The 1px line between the trigger and the content.
///
/// It uses the same edge as the panel's frame, so the seam reads as a
/// continuation of the frame rather than an unrelated line.
BoxDecorationMix _dividerAbove(Color color) => BoxDecorationMix(
  border: BoxBorderMix.top(
    BorderSideMix(color: color, width: {{typePrefix}}Tokens.borderWidth1()),
  ),
);

/// Pins bare [Text] accordion content to the 14px type-scale step (`text2`)
/// regardless of accordion size, so content never renders larger than its own
/// trigger's title. This design system's text children pin their own run.
/// [color] supplies the variant's own content tint.
WidgetModifierConfig _contentText(Color color) =>
    WidgetModifierConfig.defaultTextStyle(
      style: {{typePrefix}}Tokens.text2.mix(),
    ).defaultTextStyle(style: TextStyleMix().color(color));

Radius _radius({{typePrefix}}AccordionSize size) => switch (size) {
  .size1 => {{typePrefix}}Tokens.radius3(),
  .size2 => {{typePrefix}}Tokens.radius4(),
  .size3 => {{typePrefix}}Tokens.radius5(),
};
