import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'callout.g.dart';

/// The sizes a callout comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}CalloutSize {
  /// 14px text with 12px padding and an 8px gap.
  size1,

  /// 14px text with 16px padding and a 12px gap. The default.
  size2,

  /// 16px text with 24px padding and a 16px gap.
  size3,
}

/// The looks a callout comes in.
enum {{typePrefix}}CalloutVariant {
  /// A tinted accent fill.
  soft,

  /// A faint accent fill inside a 1px accent frame.
  surface,

  /// No fill inside a 1px accent frame.
  outline,
}

/// The {{typePrefix}} Callout recipe.
///
/// It reads top to bottom: the size, the color the icon and text share, then
/// the variant's fill and frame.
///
/// [highContrast] moves the text and icon to accent step 12.
@MixWidget(target: RemixCallout.new)
CalloutStyler {{valuePrefix}}CalloutStyle({
  {{typePrefix}}CalloutVariant variant = .soft,
  {{typePrefix}}CalloutSize size = .size2,
  bool highContrast = false,
  CalloutStyler style = const CalloutStyler.create(),
}) => _scale(size)
    .merge(_content(highContrast))
    .merge(switch (variant) {
      .soft => CalloutStyler().color({{typePrefix}}Tokens.accentA3()),
      .surface => _surface(),
      .outline => _outline(),
    })
    .merge(style);

/// The text, icon, padding, gap and corner size of each step.
CalloutStyler _scale({{typePrefix}}CalloutSize size) {
  final (:padding, :gap, :text, :icon, :radius) = switch (size) {
    .size1 => (
      padding: {{typePrefix}}Tokens.space3(),
      gap: {{typePrefix}}Tokens.space2(),
      text: {{typePrefix}}Tokens.text2,
      icon: {{typePrefix}}Tokens.space4(),
      radius: {{typePrefix}}Tokens.radius3(),
    ),
    .size2 => (
      padding: {{typePrefix}}Tokens.space4(),
      gap: {{typePrefix}}Tokens.space3(),
      text: {{typePrefix}}Tokens.text2,
      icon: {{typePrefix}}Tokens.space4(),
      radius: {{typePrefix}}Tokens.radius4(),
    ),
    .size3 => (
      padding: {{typePrefix}}Tokens.space5(),
      gap: {{typePrefix}}Tokens.space4(),
      text: {{typePrefix}}Tokens.text3,
      icon: {{typePrefix}}Tokens.spinnerSize3(),
      radius: {{typePrefix}}Tokens.radius5(),
    ),
  };

  return CalloutStyler(
    container: .direction(.horizontal)
        .mainAxisSize(.min)
        .crossAxisAlignment(.start)
        .spacing(gap)
        .padding(EdgeInsetsGeometryMix.all(padding)),
    text: .style(text.mix()),
    icon: .size(icon),
  ).borderRadius(.all(radius));
}

/// The one color the icon and text share.
CalloutStyler _content(bool highContrast) {
  final color = highContrast
      ? {{typePrefix}}Tokens.accent12()
      : {{typePrefix}}Tokens.accentContentAlpha();

  return CalloutStyler().iconColor(color).textColor(color);
}

CalloutStyler _surface() => CalloutStyler()
    .color({{typePrefix}}Tokens.accentA2())
    .containerEffects(
      .behindContent({{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.accentA6()])),
    );

CalloutStyler _outline() => CalloutStyler().containerEffects(
  .behindContent({{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.accentA7()])),
);
