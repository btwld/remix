import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';
import 'card.dart';

/// How loudly a surface speaks, from the ordinary panel to the one block a
/// page leads with. Fortal casts no shadow under a surface, so emphasis comes
/// from fill and contrast alone.
enum {{typePrefix}}SurfaceVariant {
  /// The surface card: a panel inside a hairline frame. For content of
  /// ordinary weight.
  surface,

  /// An accent wash inside an accent hairline, for supporting content that
  /// belongs to the accent: a goal, a tip, a plan.
  soft,

  /// A faint neutral wash, for content that should recede behind its
  /// neighbours.
  quiet,

  /// The surface card in the opposite appearance: a dark panel in light mode
  /// and a light one in dark mode. Reserve it for the one block a page leads
  /// with.
  inverse,
}

/// The Fortal Surface recipe: the surface card, with [variant]'s fill and
/// frame.
///
/// Pressing, hovering and focus resolve from the widget states above it, as
/// they do for the card. An unpadded surface runs its content to the frame,
/// as a cover image or a table does. [style] merges last.
///
/// The inverse variant is the surface card itself: [{{typePrefix}}Surface] resolves
/// it in the opposite appearance.
CardStyler {{valuePrefix}}SurfaceStyle({
  {{typePrefix}}SurfaceVariant variant = .surface,
  {{typePrefix}}CardSize size = .size2,
  bool padded = true,
  CardStyler style = const CardStyler.create(),
}) => {{valuePrefix}}CardStyle(size: size)
    .merge(switch (variant) {
      .surface || .inverse => null,
      .soft => _soft(),
      .quiet => _quiet(),
    })
    .merge(padded ? null : CardStyler().padding(.all(0)))
    .merge(style);

/// An accent wash and hairline, each a step deeper under the pointer.
CardStyler _soft() => CardStyler()
    .color({{typePrefix}}Tokens.accentA3())
    .border(.all(.color({{typePrefix}}Tokens.accentA4())))
    .onHovered(.border(.all(.color({{typePrefix}}Tokens.accentA5()))))
    .onPressed(.color({{typePrefix}}Tokens.accentA4()));

/// A faint neutral wash and hairline, each a step deeper under the pointer.
CardStyler _quiet() => CardStyler()
    .color({{typePrefix}}Tokens.grayA2())
    .border(.all(.color({{typePrefix}}Tokens.grayA3())))
    .onHovered(.border(.all(.color({{typePrefix}}Tokens.grayA4()))))
    .onPressed(.color({{typePrefix}}Tokens.grayA3()));

/// A card at one of the [{{typePrefix}}SurfaceVariant] levels of emphasis.
///
/// With [onPressed] the whole surface is one button: it takes the press, the
/// hover, the focus ring, Enter and Space. [semanticLabel] then names it, and
/// the child's own text is hidden from assistive technology. Without
/// [onPressed], a [semanticLabel] names the surface as one group.
///
/// The inverse variant resolves everything inside it, text, controls and
/// charts included, in the opposite appearance, so they keep their contrast
/// without special cases.
class {{typePrefix}}Surface extends StatelessWidget {
  const {{typePrefix}}Surface({
    super.key,
    this.variant = .surface,
    this.size = .size2,
    this.padded = true,
    this.onPressed,
    this.semanticLabel,
    this.style = const CardStyler.create(),
    required this.child,
  }) : assert(onPressed == null || semanticLabel != null),
       assert(semanticLabel == null || semanticLabel != '');

  /// The surface card: a panel inside a hairline frame.
  const {{typePrefix}}Surface.surface({
    super.key,
    this.size = .size2,
    this.padded = true,
    this.onPressed,
    this.semanticLabel,
    this.style = const CardStyler.create(),
    required this.child,
  }) : variant = {{typePrefix}}SurfaceVariant.surface,
       assert(onPressed == null || semanticLabel != null),
       assert(semanticLabel == null || semanticLabel != '');

  /// An accent wash inside an accent hairline.
  const {{typePrefix}}Surface.soft({
    super.key,
    this.size = .size2,
    this.padded = true,
    this.onPressed,
    this.semanticLabel,
    this.style = const CardStyler.create(),
    required this.child,
  }) : variant = {{typePrefix}}SurfaceVariant.soft,
       assert(onPressed == null || semanticLabel != null),
       assert(semanticLabel == null || semanticLabel != '');

  /// A faint neutral wash.
  const {{typePrefix}}Surface.quiet({
    super.key,
    this.size = .size2,
    this.padded = true,
    this.onPressed,
    this.semanticLabel,
    this.style = const CardStyler.create(),
    required this.child,
  }) : variant = {{typePrefix}}SurfaceVariant.quiet,
       assert(onPressed == null || semanticLabel != null),
       assert(semanticLabel == null || semanticLabel != '');

  /// The surface card in the opposite appearance.
  const {{typePrefix}}Surface.inverse({
    super.key,
    this.size = .size2,
    this.padded = true,
    this.onPressed,
    this.semanticLabel,
    this.style = const CardStyler.create(),
    required this.child,
  }) : variant = {{typePrefix}}SurfaceVariant.inverse,
       assert(onPressed == null || semanticLabel != null),
       assert(semanticLabel == null || semanticLabel != '');

  /// How much attention the surface asks for.
  final {{typePrefix}}SurfaceVariant variant;

  /// The padding and corner size.
  final {{typePrefix}}CardSize size;

  /// Whether the surface pads its [child].
  final bool padded;

  /// Makes the whole surface one button.
  final VoidCallback? onPressed;

  /// The button's accessible name, or the group's without [onPressed].
  final String? semanticLabel;

  /// Merged last into the surface's style.
  final CardStyler style;

  /// The surface's content.
  final Widget child;

  @override
  Widget build(BuildContext context) {
    Widget surface = RemixCard(
      style: {{valuePrefix}}SurfaceStyle(
        variant: variant,
        size: size,
        padded: padded,
        style: style,
      ),
      child: child,
    );
    if (variant == .inverse) {
      // Only the brightness is configured, for both of the parent's themes,
      // so the scope follows whichever the parent uses and inherits its
      // accent, radius and scaling. A `mode` would pick one of the parent's
      // themes instead, and an app that gives only `theme` has one.
      final opposite = {{typePrefix}}ThemeConfig(
        brightness: {{typePrefix}}Theme.of(context).isDark ? .light : .dark,
      );
      surface = {{typePrefix}}Theme(
        theme: opposite,
        darkTheme: opposite,
        hasBackground: false,
        child: surface,
      );
    }
    if (onPressed case final onPressed?) {
      return Pressable(
        onPress: onPressed,
        semanticsLabel: semanticLabel,
        mouseCursor: SystemMouseCursors.click,
        child: ExcludeSemantics(child: surface),
      );
    }
    if (semanticLabel == null) return surface;

    return Semantics(container: true, label: semanticLabel, child: surface);
  }
}
