import 'dart:math' as math;

import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../icons.dart';
import '../motion/motion.dart';
import '../theme/theme.dart';

part 'menu.g.dart';

/// The sizes a menu comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}MenuSize {
  /// 32px items with 13px text.
  size1,

  /// 36px items with 13px text. The default.
  size2,
}

/// How a menu marks the item under the pointer or keyboard.
enum {{typePrefix}}MenuVariant {
  /// The muted neutral fill.
  solid,

  /// A faint accent tint.
  soft,
}

/// The Fortal Menu recipe: the trigger, the floating panel, its items,
/// submenu items and dividers.
///
/// The trigger is a 32px framed control with a chevron that turns over while
/// the menu is open. The panel opens below the trigger's end edge, rising and
/// growing in from it while its rows fade in one after another, and leaves
/// faster than it came.
///
/// [highContrast] marks the highlighted item with a focus ring as well and
/// draws the trigger frame in the strong border.
@MixWidget(target: RemixMenu.new)
MenuStyler {{valuePrefix}}MenuStyle({
  {{typePrefix}}MenuVariant variant = .solid,
  {{typePrefix}}MenuSize size = .size2,
  bool highContrast = false,
  MenuStyler style = const MenuStyler.create(),
}) {
  final metrics = _metrics(size);
  final radius = {{typePrefix}}Tokens.radius6();

  return MenuStyler()
      .containerEffects(
        RemixBoxEffectsMix.backdropBlur({{typePrefix}}Tokens.panelBlur()),
      )
      .positioning(
        const OverlayPositionConfig(
          alignment: OverlayAlignment.end,
          sideOffset: _panelGap,
          collisionPadding: EdgeInsets.all(_viewportInset),
        ),
      )
      .trigger(_trigger(highContrast: highContrast))
      .overlay(
        FlexBoxStyler()
            .minWidth(_panelMinWidth)
            .padding(.all(_panelPadding))
            .borderRadius(.all(radius))
            // The panel edge, drawn in the foreground to take no layout space.
            .foregroundDecoration(
              BoxDecorationMix(
                border: BoxBorderMix.all(
                  BorderSideMix(
                    color: {{typePrefix}}Tokens.gray7(),
                    width: {{typePrefix}}Tokens.borderWidth1(),
                  ),
                ),
                borderRadius: BorderRadiusMix.all(radius),
              ),
            )
            .color({{typePrefix}}Tokens.colorPanel())
            .decoration(
              BoxDecorationMix.create(boxShadow: {{typePrefix}}Tokens.shadow5.mix()),
            )
            .clipBehavior(Clip.antiAlias),
      )
      .item(_item(variant, metrics, highContrast: highContrast))
      .submenuItem(_submenuItem(variant, metrics, highContrast: highContrast))
      .divider(_divider())
      .panelTransition(
        const RemixPanelTransition(
          duration: {{typePrefix}}Motion.spring,
          reverseDuration: {{typePrefix}}Motion.instant,
          builder: _panelMotion,
        ),
      )
      .itemTransition(const RemixMenuItemTransition(builder: _rowMotion))
      .merge(style);
}

/// The Fortal menu item recipe, for styling one item on its own.
///
/// It is the item style [{{valuePrefix}}MenuStyle] gives every item, so a call site can
/// match a menu's items outside the menu. [destructive] draws the label and
/// icon in the error tone over an error tint.
MenuItemStyler {{valuePrefix}}MenuItemStyle({
  {{typePrefix}}MenuVariant variant = .solid,
  {{typePrefix}}MenuSize size = .size2,
  bool highContrast = false,
  bool destructive = false,
}) {
  final item = _item(variant, _metrics(size), highContrast: highContrast);
  if (!destructive) return item;

  final tone = {{typePrefix}}Tokens.error11();
  final highlighted = MenuItemStyler().color({{typePrefix}}Tokens.error3());

  return item
      .label(.color(tone))
      .leadingIcon(.color(tone))
      .onHovered(highlighted)
      .onFocused(highlighted)
      .onPressed(highlighted);
}

const _panelMinWidth = 192.0;
// 5px inside the 1px edge, which is painted in the foreground.
const _panelPadding = 6.0;
const _panelGap = 6.0;
const _viewportInset = 12.0;
const _itemInset = 11.0;
const _iconGap = 10.0;
// The icon sits in a 17px box; a 16px glyph with one more pixel of gap puts
// the label at the same x.
const _iconSize = 16.0;
const _chevronSize = 15.0;
const _disabledOpacity = 0.45;

// The panel rises 5px and grows from 97% toward the trigger as it opens, and
// sinks half as far toward 98.5% as it closes.
const _enterRise = 5.0;
const _enterScale = 0.97;
const _exitRise = 2.5;
const _exitScale = 0.985;

const _rowRise = 2.0;
const _rowStaggerLimit = 4;
const _rowDuration = {{typePrefix}}Motion.standard;

const _transparent = Color(0x00000000);

final _fill = AnimationConfig.curve(
  duration: {{typePrefix}}Motion.fast,
  curve: {{typePrefix}}Motion.easeStandard,
);

/// The trigger's side padding: 12px inside its 1px frame.
final _triggerInline = ContextToken<double>(
  (context) =>
      {{typePrefix}}Tokens.space3.resolve(context) +
      {{typePrefix}}Tokens.borderWidth1.resolve(context),
);

RemixBoxEffectsMix _frame(Color color) =>
    .behindContent({{valuePrefix}}InsetSurface(strokes: [color]));

/// A 32px framed control: surface fill in a border, a muted fill and strong
/// border under the pointer and while open, and a chevron that turns over
/// while open.
MenuTriggerStyler _trigger({required bool highContrast}) {
  final strong = {{typePrefix}}Tokens.gray8();
  final muted = MenuTriggerStyler()
      .color({{typePrefix}}Tokens.gray3())
      .containerEffects(_frame(strong));

  // No 40px hit target: the panel anchors to the trigger's box, and a taller
  // target would push it below the 6px gap.
  return MenuTriggerStyler()
      .animate(_fill)
      .minHeight({{typePrefix}}Tokens.controlHeight1())
      .padding(.horizontal(_triggerInline()))
      .spacing({{typePrefix}}Tokens.space2())
      .borderRadius(.all({{typePrefix}}Tokens.radius4OrFull()))
      .color({{typePrefix}}Tokens.gray2())
      .containerEffects(_frame(highContrast ? strong : {{typePrefix}}Tokens.gray7()))
      .label(
        .style({{typePrefix}}Tokens.text2.mix())
            .fontWeight({{typePrefix}}Tokens.fontWeightMedium())
            .color({{typePrefix}}Tokens.gray12()),
      )
      .icon(.color({{typePrefix}}Tokens.gray11()).size(_iconSize))
      .trailingIcon(
        IconStyler()
            .icon({{typePrefix}}Icons.chevronDown)
            .size(_chevronSize)
            .color({{typePrefix}}Tokens.gray10())
            .wrap(.rotate(radians: 0)),
      )
      .onHovered(
        muted.decoration(
          BoxDecorationMix.create(boxShadow: {{typePrefix}}Tokens.shadow1.mix()),
        ),
      )
      .onPressed(muted.color({{typePrefix}}Tokens.gray4()))
      // Open: the trigger reports `selected` while its menu is up.
      .onSelected(
        muted.trailingIcon(IconStyler().wrap(.rotate(radians: math.pi))),
      )
      .onFocusVisible(.containerEffects({{valuePrefix}}FocusOutline()))
      .onDisabled(
        MenuTriggerStyler()
            .wrap(.opacity(_disabledOpacity))
            .containerEffects(.outline(.style(.none))),
      );
}

MenuItemStyler _item(
  {{typePrefix}}MenuVariant variant,
  _Metrics metrics, {
  required bool highContrast,
}) {
  final highlighted = MenuItemStyler().color(switch (variant) {
    .solid => {{typePrefix}}Tokens.gray3(),
    .soft => {{typePrefix}}Tokens.accentA3(),
  });

  return MenuItemStyler()
      .animate(_fill)
      .direction(.horizontal)
      .spacing(_iconGap + 1)
      .height(metrics.itemHeight)
      .padding(.horizontal(_itemInset))
      .borderRadius(.all({{typePrefix}}Tokens.radius4()))
      .color(_transparent)
      .label(.style({{typePrefix}}Tokens.text2.mix()).color({{typePrefix}}Tokens.gray12()))
      .leadingIcon(.color({{typePrefix}}Tokens.gray11()).size(_iconSize))
      .trailingIcon(.color({{typePrefix}}Tokens.gray11()).size(_iconSize))
      // A shortcut or count follows the trailing icon's color in every state.
      .trailingText(.color({{typePrefix}}Tokens.gray11()))
      .indicator(.color({{typePrefix}}Tokens.gray12()).size(_iconSize))
      .onHovered(highlighted)
      .onFocused(highlighted)
      .onPressed(highlighted)
      // The highlight marks the keyboard position; high contrast adds a ring.
      .onFocusVisible(
        MenuItemStyler().container(
          highContrast
              ? FlexBoxStyler().{{valuePrefix}}FocusRing(radius: {{typePrefix}}Tokens.radius4())
              : FlexBoxStyler().wrap({{valuePrefix}}FocusRingModifier(visible: false)),
        ),
      )
      .onDisabled(
        MenuItemStyler()
            .color(_transparent)
            .wrap(.opacity(_disabledOpacity))
            .container(
              FlexBoxStyler().wrap({{valuePrefix}}FocusRingModifier(visible: false)),
            ),
      );
}

MenuItemStyler _submenuItem(
  {{typePrefix}}MenuVariant variant,
  _Metrics metrics, {
  required bool highContrast,
}) {
  final highlighted = MenuItemStyler().color(switch (variant) {
    .solid => {{typePrefix}}Tokens.gray3(),
    .soft => {{typePrefix}}Tokens.accentA3(),
  });

  return MenuItemStyler()
      .trailingIcon(.color({{typePrefix}}Tokens.gray11()).size(_iconSize))
      // An open submenu keeps its row highlighted.
      .onSelected(highlighted);
}

/// A 1px subtle line across the panel's content box, 4px above and below.
DividerStyler _divider() => DividerStyler()
    .height({{typePrefix}}Tokens.borderWidth1())
    .margin(.vertical({{typePrefix}}Tokens.space1()))
    .color({{typePrefix}}Tokens.gray6());

class _Metrics {
  const _Metrics({required this.itemHeight});

  final double itemHeight;
}

_Metrics _metrics({{typePrefix}}MenuSize size) => switch (size) {
  .size1 => _Metrics(itemHeight: {{typePrefix}}Tokens.controlHeight1()),
  .size2 => _Metrics(itemHeight: _itemHeight2()),
};

/// 36px: one 4px space over the small control height.
final _itemHeight2 = ContextToken<double>(
  (context) =>
      {{typePrefix}}Tokens.controlHeight1.resolve(context) +
      {{typePrefix}}Tokens.space1.resolve(context),
);

double _progress(Duration elapsed, Duration span) =>
    (elapsed.inMicroseconds / span.inMicroseconds).clamp(0.0, 1.0);

/// Where the panel grows from: the trigger's edge on the side it opened.
(Alignment, Offset) _towardTrigger(BuildContext context) {
  final placement = OverlayPlacement.maybeOf(context);
  final rtl = Directionality.maybeOf(context) == TextDirection.rtl;
  final x = switch (placement?.alignment ?? OverlayAlignment.end) {
    OverlayAlignment.start => rtl ? 1.0 : -1.0,
    OverlayAlignment.center => 0.0,
    OverlayAlignment.end => rtl ? -1.0 : 1.0,
  };

  return switch (placement?.side ?? OverlaySide.bottom) {
    OverlaySide.bottom => (Alignment(x, -1), const Offset(0, -1)),
    OverlaySide.top => (Alignment(x, 1), const Offset(0, 1)),
    OverlaySide.left => (const Alignment(1, 0), const Offset(1, 0)),
    OverlaySide.right => (const Alignment(-1, 0), const Offset(-1, 0)),
  };
}

Widget _panelMotion(
  BuildContext context,
  RemixPanelTransitionInfo info,
  Widget panel,
) {
  final (origin, toward) = _towardTrigger(context);

  return AnimatedBuilder(
    animation: info.animation,
    child: panel,
    builder: (context, child) {
      final animation = info.animation;
      final double opacity;
      final double scale;
      final double rise;
      if (animation.status == AnimationStatus.reverse) {
        final t = {{typePrefix}}Motion.easeStandard.transform(1 - animation.value);
        opacity = 1 - t;
        scale = 1 - (1 - _exitScale) * t;
        rise = _exitRise * t;
      } else {
        final elapsed = {{typePrefix}}Motion.spring * animation.value;
        opacity = {{typePrefix}}Motion.easeEnter.transform(
          _progress(elapsed, {{typePrefix}}Motion.fast),
        );
        final travel = {{typePrefix}}SpringCurve.css.transform(animation.value);
        scale = _enterScale + (1 - _enterScale) * travel;
        rise = _enterRise * (1 - travel);
      }
      return Opacity(
        opacity: opacity,
        alwaysIncludeSemantics: true,
        child: Transform.translate(
          offset: toward * rise,
          child: Transform.scale(scale: scale, alignment: origin, child: child),
        ),
      );
    },
  );
}

Widget _rowMotion(
  BuildContext context,
  RemixMenuItemTransitionInfo info,
  Widget entry,
) {
  final delay =
      {{typePrefix}}Motion.staggerItem * math.min(info.index, _rowStaggerLimit);

  return AnimatedBuilder(
    animation: info.animation,
    child: entry,
    builder: (context, child) {
      final animation = info.animation;
      if (animation.status == AnimationStatus.reverse || animation.value == 1) {
        return child!;
      }
      final elapsed = {{typePrefix}}Motion.spring * animation.value - delay;
      final t = {{typePrefix}}Motion.easeEnter.transform(
        elapsed.isNegative ? 0 : _progress(elapsed, _rowDuration),
      );
      return Opacity(
        opacity: t,
        alwaysIncludeSemantics: true,
        child: Transform.translate(
          offset: Offset(0, -_rowRise * (1 - t)),
          child: child,
        ),
      );
    },
  );
}
