import 'dart:math' as math;

import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
{{icon:import}}

import 'dashboard_demo_text.dart';
import 'dashboard_demo_theme.dart';
import 'dashboard_demo_ui.dart';

/// Interactive {{typePrefix}} theme customizer panel.
class {{typePrefix}}ThemePanel extends StatelessWidget {
  const {{typePrefix}}ThemePanel({super.key});

  @override
  Widget build(BuildContext context) {
    final scope = {{typePrefix}}DashboardThemeScope.of(context);
    final settings = scope.settings;

    Widget choice<T extends Object>({
      required String label,
      required T selectedValue,
      required List<RemixSegmentedControlItem<T>> items,
      required {{typePrefix}}ThemeSettings Function(T value) apply,
    }) => _Control(
      label: label,
      child: {{typePrefix}}SegmentedControl<T>(
        size: .size1,
        selectedValue: selectedValue,
        semanticLabel: label,
        items: items,
        onChanged: (value) => scope.onChanged(apply(value)),
      ),
    );

    // A swatch ring reaches its offset plus its width past the swatch. The
    // hosting scroll views clip at the panel's edge, so the panel insets its
    // content by that much and grows by the same amount to stay 360 wide.
    final ringReach = math.max(
      0.0,
      MixScope.tokenOf({{typePrefix}}Tokens.focusRingOffset, context) +
          MixScope.tokenOf({{typePrefix}}Tokens.focusRingWidth, context),
    );

    return Box(
      key: const ValueKey('theme-panel'),
      style: BoxStyler()
          .width(360 + 2 * ringReach)
          .padding(.horizontal(ringReach)),
      child: ColumnBox(
        style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(18),
        children: [
          choice<{{typePrefix}}ThemeMode>(
            label: 'Appearance',
            selectedValue: settings.appearance,
            items: _enumSegmentedItems({{typePrefix}}ThemeMode.values),
            apply: (value) => settings.copyWith(appearance: value),
          ),
          _Control(
            label: 'Accent color',
            child: WrapBox(
              style: WrapBoxStyler().spacing(8).runSpacing(8),
              children: [
                for (final accent in {{typePrefix}}AccentColor.values)
                  _AccentSwatch(
                    key: ValueKey('accent-${accent.name}'),
                    accent: accent,
                    selected: accent == settings.accentColor,
                    onPressed: () =>
                        scope.onChanged(settings.copyWith(accentColor: accent)),
                  ),
              ],
            ),
          ),
          _Control(
            label: 'Gray color',
            child: {{typePrefix}}Select<{{typePrefix}}GrayColor>(
              trigger: const RemixSelectTrigger(placeholder: 'Choose gray'),
              selectedValue: settings.grayColor,
              items: [
                for (final gray in {{typePrefix}}GrayColor.values)
                  RemixSelectItem(value: gray, label: enumLabel(gray)),
              ],
              onChanged: (value) {
                if (value != null) {
                  scope.onChanged(settings.copyWith(grayColor: value));
                }
              },
            ),
          ),
          choice<{{typePrefix}}PanelBackground>(
            label: 'Panel background',
            selectedValue: settings.panelBackground,
            items: _enumSegmentedItems({{typePrefix}}PanelBackground.values),
            apply: (value) => settings.copyWith(panelBackground: value),
          ),
          RowBox(
            style: FlexBoxStyler().spacing(10),
            children: [
              Expanded(
                child: choice<{{typePrefix}}Radius>(
                  label: 'Radius',
                  selectedValue: settings.radius,
                  items: _enumSegmentedItems(
                    {{typePrefix}}Radius.values,
                    labelBuilder: _radiusLabel,
                  ),
                  apply: (value) => settings.copyWith(radius: value),
                ),
              ),
              Box(
                style: BoxStyler()
                    .width(28)
                    .height(28)
                    .color({{typePrefix}}Tokens.accent9())
                    .borderRadius(.all({{typePrefix}}Tokens.radius3())),
              ),
            ],
          ),
          SingleChildScrollView(
            scrollDirection: Axis.horizontal,
            child: choice<{{typePrefix}}Scaling>(
              label: 'Scaling',
              selectedValue: settings.scaling,
              items: _enumSegmentedItems(
                {{typePrefix}}Scaling.values,
                labelBuilder: _scalingLabel,
              ),
              apply: (value) => settings.copyWith(scaling: value),
            ),
          ),
          Box(
            style: BoxStyler().alignment(.centerStart),
            child: {{typePrefix}}Button.ghost(
              key: const ValueKey('theme-reset'),
              size: .size1,
              onPressed: () => scope.onChanged(const {{typePrefix}}ThemeSettings()),
              label: 'Reset theme',
              leadingIcon: {{icon:reload}},
            ),
          ),
        ],
      ),
    );
  }
}

List<RemixSegmentedControlItem<T>> _enumSegmentedItems<T extends Enum>(
  List<T> values, {
  String Function(T value)? labelBuilder,
}) => [
  for (final value in values)
    RemixSegmentedControlItem(
      value: value,
      label: labelBuilder?.call(value) ?? enumLabel(value),
    ),
];

String _radiusLabel({{typePrefix}}Radius radius) => switch (radius) {
  .none => 'None',
  .small => 'S',
  .medium => 'M',
  .large => 'L',
  .full => 'Full',
};

String _scalingLabel({{typePrefix}}Scaling scaling) =>
    '${(scaling.factor * 100).round()}%';

class _Control extends StatelessWidget {
  const _Control({required this.label, required this.child});
  final String label;
  final Widget child;

  @override
  Widget build(BuildContext context) => ColumnBox(
    style: FlexBoxStyler().crossAxisAlignment(.start).spacing(8),
    children: [
      {{typePrefix}}Text(label, size: .size2, weight: .medium),
      child,
    ],
  );
}

class _AccentSwatch extends StatelessWidget {
  const _AccentSwatch({
    super.key,
    required this.accent,
    required this.selected,
    required this.onPressed,
  });

  static final _style =
      ToggleStyler(
            container: FlexBoxStyler()
                .size(30, 30)
                .alignment(.center)
                .mainAxisSize(.min)
                .borderRadius(.all(const Radius.circular(15))),
            icon: .size(15),
          )
          .color({{typePrefix}}Tokens.accent9())
          .iconColor(const Color(0x00000000))
          .onHovered(ToggleStyler().color({{typePrefix}}Tokens.accent10()))
          .onPressed(ToggleStyler().color({{typePrefix}}Tokens.accent10()))
          .onSelected(ToggleStyler().iconColor({{typePrefix}}Tokens.accentContrast()));

  final {{typePrefix}}AccentColor accent;
  final bool selected;
  final VoidCallback onPressed;

  @override
  Widget build(BuildContext context) {
    // The swatch changes its fill palette, while its ring belongs to the
    // surrounding panel and must retain that scope's token overrides.
    final outline = {{valuePrefix}}FocusOutline().resolve(context);
    final ring = ToggleStyler().containerEffects(
      RemixBoxEffectsMix.create(
        outline: Prop.value(outline.outline),
        outlineOffset: Prop.value(outline.outlineOffset),
      ),
    );
    return {{typePrefix}}AccentScope(
      accent: accent,
      child: RemixToggle(
        selected: selected,
        onChanged: (_) => onPressed(),
        icon: {{icon:check}},
        semanticLabel: '${enumLabel(accent)} accent',
        style: _style.onSelected(ring).onFocusVisible(ring),
      ),
    );
  }
}
