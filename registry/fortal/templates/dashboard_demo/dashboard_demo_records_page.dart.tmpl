class _{{typePrefix}}DashboardOrdersPageState extends State<{{typePrefix}}DashboardOrdersPage> {
  TextEditingController? _ownSearch;
  _OrderFilter _status = .all;
  RemixDataTableSort _sort = const RemixDataTableSort(
    columnId: 'date',
    direction: .descending,
  );
  int _page = 0;
  int _rowsPerPage = 10;

  /// See `_{{typePrefix}}DashboardCustomersPageState._rows`.
  List<{{typePrefix}}DashboardOrder>? _rows;

  /// The table columns. Built once per data set: the edition column looks a
  /// cover up by title.
  List<RemixDataTableColumn<{{typePrefix}}DashboardOrder>>? _columns;

  {{typePrefix}}DashboardData get _data => widget.data ?? {{valuePrefix}}DashboardSampleData;

  TextEditingController get _search =>
      widget.searchController ?? (_ownSearch ??= TextEditingController());

  @override
  void initState() {
    super.initState();
    _search.addListener(_onFilterChanged);
  }

  @override
  void didUpdateWidget({{typePrefix}}DashboardOrdersPage oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.data != oldWidget.data) {
      _rows = null;
      _columns = null;
    }
    if (widget.searchController == oldWidget.searchController) return;
    (oldWidget.searchController ?? _ownSearch)?.removeListener(
      _onFilterChanged,
    );
    _search.addListener(_onFilterChanged);
    _rows = null;
  }

  @override
  void dispose() {
    _search.removeListener(_onFilterChanged);
    _ownSearch?.dispose();
    super.dispose();
  }

  void _onFilterChanged() => setState(() {
    _rows = null;
    _page = 0;
  });

  List<{{typePrefix}}DashboardOrder> _computeRows() {
    final query = _search.text.trim().toLowerCase();
    return [
      for (final order in _data.orders)
        if (_status.matches(order.status) &&
            '${order.id} ${order.customer} ${order.edition} ${order.channel}'
                .toLowerCase()
                .contains(query))
          order,
    ]..sort((a, b) {
      final result = _sort.columnId == 'amount'
          ? a.amount.compareTo(b.amount)
          : a.date.compareTo(b.date);
      return _sort.direction == .ascending ? result : -result;
    });
  }

  @override
  Widget build(BuildContext context) {
    final orders = _data.orders;
    final rows = _rows ??= _computeRows();
    final page = {{valuePrefix}}DashboardPaginate(
      rows,
      page: _page,
      rowsPerPage: _rowsPerPage,
    );
    Iterable<{{typePrefix}}DashboardOrder> having({{typePrefix}}DashboardOrderStatus status) =>
        orders.where((order) => order.status == status);
    double total(Iterable<{{typePrefix}}DashboardOrder> orders) =>
        orders.fold(0, (sum, order) => sum + order.amount);

    return {{typePrefix}}Page(
      key: const ValueKey('dashboard-orders'),
      title: 'Orders',
      description: 'Every order, from payment to the collector’s door.',
      actions: [
        {{typePrefix}}Button.soft(
          label: 'Export',
          leadingIcon: {{icon:download}},
          onPressed: () =>
              {{valuePrefix}}DashboardToast(context, 'Order export prepared'),
        ),
      ],
      children: [
        GridBox(
          key: const ValueKey('orders-summary'),
          style: {{valuePrefix}}MetricsGrid,
          children: [
            {{typePrefix}}RecordStat(
              label: 'Orders',
              value: {{valuePrefix}}DashboardCount(orders.length),
              detail:
                  '${{{valuePrefix}}DashboardCurrency(total(orders), cents: false)} in total',
            ),
            {{typePrefix}}RecordStat(
              label: 'Awaiting payment',
              value: {{valuePrefix}}DashboardCount(having(.pending).length),
              detail:
                  '${{{valuePrefix}}DashboardCurrency(total(having(.pending)), cents: false)} outstanding',
            ),
            {{typePrefix}}RecordStat(
              label: 'On the way',
              value: {{valuePrefix}}DashboardCount(having(.shipped).length),
              detail: 'Shipped, not yet delivered',
            ),
            {{typePrefix}}RecordStat(
              label: 'Refunded',
              value: {{valuePrefix}}DashboardCurrency(
                total(having(.refunded)),
                cents: false,
              ),
              detail: '${having(.refunded).length} orders returned',
            ),
          ],
        ),
        WrapBox(
          style: WrapBoxStyler()
              .wrapAlignment(.spaceBetween)
              .crossAxisAlignment(.center)
              .spacing({{typePrefix}}Tokens.space3())
              .runSpacing({{typePrefix}}Tokens.space3()),
          children: [
            {{typePrefix}}FilterTabs<_OrderFilter>(
              key: const ValueKey('order-status'),
              semanticLabel: 'Filter orders by status',
              values: _OrderFilter.values,
              selected: _status,
              labelOf: (status) => capitalize(status.name),
              onChanged: (status) => setState(() {
                _status = status;
                _rows = null;
                _page = 0;
              }),
            ),
            Box(
              style: BoxStyler().width(280),
              child: {{typePrefix}}TextField(
                key: const ValueKey('order-search'),
                controller: _search,
                leading: const StyledIcon(icon: {{icon:magnifyingGlass}}),
                hintText: 'Search orders…',
                semanticLabel: 'Search orders',
              ),
            ),
          ],
        ),
        {{typePrefix}}DataTable<{{typePrefix}}DashboardOrder>.surface(
          key: const ValueKey('data-grid-orders'),
          rows: page.items,
          columns: _columns ??= _orderColumns(_data.editions),
          semanticLabel: 'Orders',
          minimumWidth: 980,
          sort: _sort,
          onSortChanged: (sort) => setState(() {
            _sort = sort;
            _rows = null;
            _page = 0;
          }),
          totalRows: rows.length,
          pageIndex: page.page,
          pageSize: _rowsPerPage,
          pageSizeOptions: const [5, 10, 20],
          onPageChanged: (value) => setState(() => _page = value),
          onPageSizeChanged: (value) => setState(() {
            _rowsPerPage = value;
            _page = 0;
          }),
          emptyBuilder: (_) => {{typePrefix}}EmptyState(
            icon: {{icon:table}},
            title: 'No matching orders',
            body: 'Try another status or search term.',
            action: {{typePrefix}}Button.soft(
              size: .size1,
              label: 'Clear filters',
              onPressed: () {
                _search.clear();
                setState(() {
                  _status = .all;
                  _rows = null;
                });
              },
            ),
          ),
        ),
      ],
    );
  }
}

/// Returns the [items] on [page] with [rowsPerPage] rows per page.
///
/// A [page] past either end is clamped to the nearest page, and the returned
/// `page` is the one actually used.
({int page, List<T> items}) {{valuePrefix}}DashboardPaginate<T>(
  List<T> items, {
  required int page,
  required int rowsPerPage,
}) {
  final pages = (items.length / rowsPerPage).ceil();
  final safePage = pages == 0 ? 0 : page.clamp(0, pages - 1);
  final start = safePage * rowsPerPage;
  final end = (start + rowsPerPage).clamp(0, items.length);
  return (page: safePage, items: items.sublist(start, end));
}

