/// The tiers the Customers page filters by, after everyone.
enum _TierFilter {
  all('All'),
  patron('Patron'),
  collector('Collector'),
  member('Member');

  const _TierFilter(this.label);

  final String label;

  bool matches({{typePrefix}}DashboardCustomerTier tier) =>
      this == all || name == tier.name;
}

/// The statuses the Orders page filters by, after everything.
enum _OrderFilter {
  all,
  paid,
  pending,
  shipped,
  refunded,
  cancelled;

  bool matches({{typePrefix}}DashboardOrderStatus status) =>
      this == all || name == status.name;
}

/// One figure summarizing a table, on a quiet surface.
class {{typePrefix}}RecordStat extends StatelessWidget {
  const {{typePrefix}}RecordStat({
    super.key,
    required this.label,
    required this.value,
    required this.detail,
  });

  /// What the figure counts.
  final String label;

  /// The figure, already formatted.
  final String value;

  /// A line of context under the figure.
  final String detail;

  @override
  Widget build(BuildContext context) => {{typePrefix}}Surface(
    emphasis: .quiet,
    child: ColumnBox(
      style: FlexBoxStyler()
          .crossAxisAlignment(.start)
          .spacing({{typePrefix}}Tokens.space1()),
      children: [
        StyledText(label, style: dashboardTextLine(.size2, tone: .muted)),
        {{typePrefix}}Text(value, size: .size6, weight: .bold, truncate: true),
        StyledText(detail, style: dashboardTextLine(.size1, tone: .subtle)),
      ],
    ),
  );
}

/// The Customers page: a searchable, sortable, selectable table of
/// collectors under four summary figures.
class {{typePrefix}}DashboardCustomersPage extends StatefulWidget {
  const {{typePrefix}}DashboardCustomersPage({
    super.key,
    this.data,
    this.searchController,
  });

  /// The records the page shows. Defaults to [{{valuePrefix}}DashboardSampleData].
  final {{typePrefix}}DashboardData? data;

  /// Controls the search field, so a host can fill it. The page creates its
  /// own when null.
  final TextEditingController? searchController;

  @override
  State<{{typePrefix}}DashboardCustomersPage> createState() =>
      _{{typePrefix}}DashboardCustomersPageState();
}

class _{{typePrefix}}DashboardCustomersPageState
    extends State<{{typePrefix}}DashboardCustomersPage> {
  TextEditingController? _ownSearch;
  _TierFilter _tier = .all;
  RemixDataTableSort _sort = const RemixDataTableSort(
    columnId: 'joined',
    direction: .descending,
  );
  Set<Object> _selectedIds = {};
  int _page = 0;
  int _rowsPerPage = 10;

  /// The filtered, sorted rows. Kept until a filter or the sort changes, so a
  /// rebuild for any other reason, such as a theme change, does not redo it.
  List<{{typePrefix}}DashboardCustomer>? _rows;

  {{typePrefix}}DashboardData get _data => widget.data ?? {{valuePrefix}}DashboardSampleData;

  TextEditingController get _search =>
      widget.searchController ?? (_ownSearch ??= TextEditingController());

  @override
  void initState() {
    super.initState();
    _search.addListener(_onFilterChanged);
  }

  @override
  void didUpdateWidget({{typePrefix}}DashboardCustomersPage oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.data != oldWidget.data) _rows = null;
    if (widget.searchController == oldWidget.searchController) return;
    (oldWidget.searchController ?? _ownSearch)?.removeListener(
      _onFilterChanged,
    );
    _search.addListener(_onFilterChanged);
    _rows = null;
  }

  @override
  void dispose() {
    _search.removeListener(_onFilterChanged);
    _ownSearch?.dispose();
    super.dispose();
  }

  void _onFilterChanged() => setState(() {
    _rows = null;
    _page = 0;
  });

  List<{{typePrefix}}DashboardCustomer> _computeRows() {
    final query = _search.text.trim().toLowerCase();
    return [
      for (final customer in _data.customers)
        if (_tier.matches(customer.tier) &&
            '${customer.name} ${customer.email} ${customer.city}'
                .toLowerCase()
                .contains(query))
          customer,
    ]..sort((a, b) {
      final result = switch (_sort.columnId) {
        'name' => a.name.compareTo(b.name),
        'spent' => a.spent.compareTo(b.spent),
        _ => a.joinedAt.compareTo(b.joinedAt),
      };
      return _sort.direction == .ascending ? result : -result;
    });
  }

  @override
  Widget build(BuildContext context) {
    final customers = _data.customers;
    final rows = _rows ??= _computeRows();
    final page = {{valuePrefix}}DashboardPaginate(
      rows,
      page: _page,
      rowsPerPage: _rowsPerPage,
    );
    final spent = customers.fold(0.0, (sum, customer) => sum + customer.spent);
    int count(bool Function({{typePrefix}}DashboardCustomer) test) =>
        customers.where(test).length;

    return {{typePrefix}}Page(
      key: const ValueKey('dashboard-customers'),
      title: 'Customers',
      description: 'The collectors behind every edition.',
      actions: [
        {{typePrefix}}Button(
          label: 'Invite collector',
          leadingIcon: {{icon:plus}},
          onPressed: () =>
              {{valuePrefix}}DashboardToast(context, 'Collector invitation started'),
        ),
      ],
      children: [
        GridBox(
          key: const ValueKey('customers-summary'),
          style: {{valuePrefix}}MetricsGrid,
          children: [
            {{typePrefix}}RecordStat(
              label: 'Collectors',
              value: {{valuePrefix}}DashboardCount(customers.length),
              detail: '${count((c) => c.status == .active)} active',
            ),
            {{typePrefix}}RecordStat(
              label: 'Patrons',
              value: {{valuePrefix}}DashboardCount(count((c) => c.tier == .patron)),
              detail: 'The top collecting tier',
            ),
            {{typePrefix}}RecordStat(
              label: 'Invitations',
              value: {{valuePrefix}}DashboardCount(count((c) => c.status == .invited)),
              detail: 'Waiting to be accepted',
            ),
            {{typePrefix}}RecordStat(
              label: 'Lifetime value',
              value: {{valuePrefix}}DashboardCurrency(spent, cents: false),
              detail: 'Across every collector',
            ),
          ],
        ),
        WrapBox(
          style: WrapBoxStyler()
              .wrapAlignment(.spaceBetween)
              .crossAxisAlignment(.center)
              .spacing({{typePrefix}}Tokens.space3())
              .runSpacing({{typePrefix}}Tokens.space3()),
          children: [
            WrapBox(
              style: WrapBoxStyler()
                  .crossAxisAlignment(.center)
                  .spacing({{typePrefix}}Tokens.space3())
                  .runSpacing({{typePrefix}}Tokens.space3()),
              children: [
                Box(
                  style: BoxStyler().width(280),
                  child: {{typePrefix}}TextField(
                    key: const ValueKey('customer-search'),
                    controller: _search,
                    leading: const StyledIcon(icon: {{icon:magnifyingGlass}}),
                    hintText: 'Search customers…',
                    semanticLabel: 'Search customers',
                  ),
                ),
                {{typePrefix}}FilterTabs<_TierFilter>(
                  key: const ValueKey('customer-tier'),
                  semanticLabel: 'Filter customers by tier',
                  values: _TierFilter.values,
                  selected: _tier,
                  labelOf: (tier) => tier.label,
                  onChanged: (tier) => setState(() {
                    _tier = tier;
                    _rows = null;
                    _page = 0;
                  }),
                ),
              ],
            ),
            if (_selectedIds.isNotEmpty)
              WrapBox(
                key: const ValueKey('customer-selection-actions'),
                style: WrapBoxStyler()
                    .crossAxisAlignment(.center)
                    .spacing({{typePrefix}}Tokens.space2())
                    .runSpacing({{typePrefix}}Tokens.space2()),
                children: [
                  {{typePrefix}}Badge(
                    size: .size2,
                    highContrast: true,
                    label: '${_selectedIds.length} selected',
                  ),
                  {{typePrefix}}Button.ghost(
                    size: .size1,
                    label: 'Export',
                    onPressed: () => {{valuePrefix}}DashboardToast(
                      context,
                      'Export prepared for ${_selectedIds.length} customers',
                    ),
                  ),
                  {{typePrefix}}Button.ghost(
                    size: .size1,
                    label: 'Archive',
                    onPressed: () => {{valuePrefix}}DashboardToast(
                      context,
                      '${_selectedIds.length} customers archived',
                    ),
                  ),
                ],
              ),
          ],
        ),
        {{typePrefix}}DataTable<{{typePrefix}}DashboardCustomer>.surface(
          key: const ValueKey('data-grid-customers'),
          rows: page.items,
          columns: _customerColumns,
          semanticLabel: 'Customers',
          minimumWidth: 940,
          sort: _sort,
          onSortChanged: (sort) => setState(() {
            _sort = sort;
            _rows = null;
            _page = 0;
          }),
          rowId: (customer) => customer.id,
          selectedRowIds: _selectedIds,
          onSelectionChanged: (ids) => setState(() => _selectedIds = ids),
          totalRows: rows.length,
          pageIndex: page.page,
          pageSize: _rowsPerPage,
          pageSizeOptions: const [5, 10, 20],
          onPageChanged: (value) => setState(() => _page = value),
          onPageSizeChanged: (value) => setState(() {
            _rowsPerPage = value;
            _page = 0;
          }),
          emptyBuilder: (_) => {{typePrefix}}EmptyState(
            icon: {{icon:magnifyingGlass}},
            title: 'No customers found',
            body: 'Try a different name, email or city.',
            action: {{typePrefix}}Button.soft(
              size: .size1,
              label: 'Clear filters',
              onPressed: () {
                _search.clear();
                setState(() {
                  _tier = .all;
                  _rows = null;
                });
              },
            ),
          ),
        ),
      ],
    );
  }
}

