/// The statuses the Collection page filters by, after everything.
enum _StatusFilter {
  all('All'),
  live('Live'),
  lowStock('Low stock'),
  soldOut('Sold out'),
  draft('Draft');

  const _StatusFilter(this.label);

  final String label;

  bool matches({{typePrefix}}DashboardEditionStatus status) =>
      this == all || name == status.name;
}

/// How the Collection page lays out its editions.
enum {{typePrefix}}CollectionLayout { grid, list }

/// The Collection page: every edition as a cover card or a table row.
///
/// The featured edition leads on a wide split card. Below it, a status
/// filter, a search field and a layout switch narrow and re-present the rest.
/// Activating a card opens the edition in a dialog.
class {{typePrefix}}DashboardCollectionPage extends StatefulWidget {
  const {{typePrefix}}DashboardCollectionPage({
    super.key,
    this.data,
    this.searchController,
  });

  /// The records the page shows. Defaults to [{{valuePrefix}}DashboardSampleData].
  final {{typePrefix}}DashboardData? data;

  /// Controls the search field, so a host can fill it. The page creates its
  /// own when null.
  final TextEditingController? searchController;

  @override
  State<{{typePrefix}}DashboardCollectionPage> createState() =>
      _{{typePrefix}}DashboardCollectionPageState();
}

class _{{typePrefix}}DashboardCollectionPageState
    extends State<{{typePrefix}}DashboardCollectionPage> {
  static final _grid = GridBoxStyler.equalColumns(4)
      .gap({{valuePrefix}}DashboardGap)
      .onConstraints(
        const .maxWidth(1079),
        .equalColumns(3).gap({{valuePrefix}}DashboardGap),
      )
      .onConstraints(
        const .maxWidth(799),
        .equalColumns(2).gap({{valuePrefix}}DashboardGap),
      )
      .onConstraints(
        const .maxWidth(499),
        .equalColumns(1).gap({{valuePrefix}}DashboardGap),
      );

  TextEditingController? _ownSearch;
  _StatusFilter _status = .all;
  {{typePrefix}}CollectionLayout _layout = .grid;

  /// The price range shown, as fractions of the collection's own range.
  List<double> _price = const [0, 1];

  TextEditingController get _search =>
      widget.searchController ?? (_ownSearch ??= TextEditingController());

  @override
  void initState() {
    super.initState();
    _search.addListener(_onSearchChanged);
  }

  @override
  void didUpdateWidget({{typePrefix}}DashboardCollectionPage oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.searchController == oldWidget.searchController) return;
    (oldWidget.searchController ?? _ownSearch)?.removeListener(
      _onSearchChanged,
    );
    _search.addListener(_onSearchChanged);
  }

  @override
  void dispose() {
    _search.removeListener(_onSearchChanged);
    _ownSearch?.dispose();
    super.dispose();
  }

  void _onSearchChanged() => setState(() {});

  @override
  Widget build(BuildContext context) {
    final data = widget.data ?? {{valuePrefix}}DashboardSampleData;
    final query = _search.text.trim().toLowerCase();
    final prices = [for (final edition in data.editions) edition.price];
    final cheapest = prices.fold(double.infinity, math.min);
    final dearest = prices.fold(0.0, math.max);
    double priceAt(double fraction) =>
        prices.isEmpty ? 0 : cheapest + (dearest - cheapest) * fraction;
    final editions = [
      for (final edition in data.editions)
        if (_status.matches(edition.status) &&
            edition.price >= priceAt(_price.first) - 0.5 &&
            edition.price <= priceAt(_price.last) + 0.5 &&
            '${edition.title} ${edition.artist} ${edition.series}'
                .toLowerCase()
                .contains(query))
          edition,
    ];
    final series = {for (final edition in data.editions) edition.series};

    return {{typePrefix}}Page(
      key: const ValueKey('dashboard-collection'),
      title: 'Collection',
      description:
          '${data.editions.length} editions across ${series.length} series.',
      actions: [
        {{typePrefix}}Button(
          label: 'New edition',
          leadingIcon: {{icon:plus}},
          onPressed: () =>
              {{valuePrefix}}DashboardToast(context, 'Draft edition created'),
        ),
      ],
      children: [
        if (data.editions.isNotEmpty)
          {{typePrefix}}EditionSpotlight(
            edition: data.editions.first,
            onPressed: () =>
                show{{typePrefix}}EditionDialog(context, data.editions.first),
          ),
        WrapBox(
          style: WrapBoxStyler()
              .wrapAlignment(.spaceBetween)
              .crossAxisAlignment(.center)
              .spacing({{typePrefix}}Tokens.space3())
              .runSpacing({{typePrefix}}Tokens.space3()),
          children: [
            {{typePrefix}}FilterTabs<_StatusFilter>(
              key: const ValueKey('collection-status'),
              semanticLabel: 'Filter editions by status',
              values: _StatusFilter.values,
              selected: _status,
              labelOf: (status) => status.label,
              onChanged: (status) => setState(() => _status = status),
            ),
            WrapBox(
              style: WrapBoxStyler()
                  .crossAxisAlignment(.center)
                  .spacing({{typePrefix}}Tokens.space3())
                  .runSpacing({{typePrefix}}Tokens.space3()),
              children: [
                Box(
                  style: BoxStyler().width(240),
                  child: {{typePrefix}}TextField(
                    key: const ValueKey('collection-search'),
                    controller: _search,
                    leading: const StyledIcon(icon: {{icon:magnifyingGlass}}),
                    hintText: 'Search editions…',
                    semanticLabel: 'Search editions',
                  ),
                ),
                {{typePrefix}}ToggleGroup<{{typePrefix}}CollectionLayout>(
                  key: const ValueKey('collection-layout'),
                  semanticLabel: 'Collection layout',
                  selectedValue: _layout,
                  items: const [
                    RemixToggleGroupItem(value: .grid, label: 'Grid'),
                    RemixToggleGroupItem(value: .list, label: 'List'),
                  ],
                  onChanged: (layout) {
                    if (layout != null) setState(() => _layout = layout);
                  },
                ),
              ],
            ),
          ],
        ),
        if (prices.length > 1)
          RowBox(
            key: const ValueKey('collection-price'),
            style: FlexBoxStyler()
                .crossAxisAlignment(.center)
                .spacing({{typePrefix}}Tokens.space4()),
            children: [
              StyledText(
                'Price',
                style: dashboardText(.size2, weight: .medium),
              ),
              Flexible(
                child: Box(
                  style: BoxStyler().maxWidth(320),
                  child: {{typePrefix}}RangeSlider(
                    values: _price,
                    snapDivisions: 13,
                    semanticLabels: const ['Lowest price', 'Highest price'],
                    onChanged: (values) => setState(() => _price = values),
                  ),
                ),
              ),
              Flexible(
                child: StyledText(
                  '${{{valuePrefix}}DashboardCurrency(priceAt(_price.first), cents: false)}'
                  ' – '
                  '${{{valuePrefix}}DashboardCurrency(priceAt(_price.last), cents: false)}',
                  style: dashboardTextLine(.size2, tone: .muted),
                ),
              ),
            ],
          ),
        if (editions.isEmpty)
          {{typePrefix}}Surface(
            emphasis: .quiet,
            child: {{typePrefix}}EmptyState(
              icon: {{icon:magnifyingGlass}},
              title: 'No editions found',
              body: 'Try another title, artist, status or price.',
              action: {{typePrefix}}Button.soft(
                size: .size1,
                label: 'Clear filters',
                onPressed: () {
                  _search.clear();
                  setState(() {
                    _status = .all;
                    _price = const [0, 1];
                  });
                },
              ),
            ),
          )
        else if (_layout == .grid)
          GridBox(
            key: const ValueKey('collection-grid'),
            style: _grid,
            children: [
              for (final edition in editions)
                {{typePrefix}}EditionCard(
                  key: ValueKey('edition-${edition.id}'),
                  edition: edition,
                  onPressed: () => show{{typePrefix}}EditionDialog(context, edition),
                ),
            ],
          )
        else
          {{typePrefix}}EditionTable(
            editions: editions,
            onOpen: (edition) => show{{typePrefix}}EditionDialog(context, edition),
          ),
      ],
    );
  }
}

