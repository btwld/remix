/// Opens [edition] in a dialog: its cover, its story and its numbers.
Future<void> show{{typePrefix}}EditionDialog(
  BuildContext context,
  {{typePrefix}}DashboardEdition edition,
) => showRemixDialog<void>(
  context: context,
  barrierLabel: 'Dismiss',
  builder: (context) => {{typePrefix}}Dialog(
    key: const ValueKey('edition-dialog'),
    title: edition.title,
    description: '${edition.artist} · ${edition.series}',
    scrollable: true,
    actions: [
      {{typePrefix}}Button.soft(
        label: 'Close',
        onPressed: () => Navigator.of(context).pop(),
      ),
      {{typePrefix}}Button(
        label: 'Edit edition',
        onPressed: () {
          Navigator.of(context).pop();
          {{valuePrefix}}DashboardToast(context, 'Editing ${edition.title}');
        },
      ),
    ],
    child: ColumnBox(
      style: FlexBoxStyler()
          .mainAxisSize(.min)
          .crossAxisAlignment(.stretch)
          .spacing({{typePrefix}}Tokens.space4()),
      children: [
        Box(
          style: BoxStyler()
              .borderRadius(.all({{typePrefix}}Tokens.radius3()))
              .clipBehavior(.antiAlias),
          child: AspectRatio(
            aspectRatio: 16 / 9,
            child: {{typePrefix}}EditionCover(edition, described: true),
          ),
        ),
        StyledText(
          edition.description,
          style: dashboardText(.size2, tone: .muted),
        ),
        {{typePrefix}}EditionProgress(edition),
        const _EditionNotes(),
        {{typePrefix}}DataList(
          size: .size1,
          semanticLabel: '${edition.title} details',
          items: [
            RemixDataListItem(label: 'Format', value: edition.format),
            RemixDataListItem(
              label: 'Price',
              value: {{valuePrefix}}DashboardCurrency(edition.price, cents: false),
            ),
            RemixDataListItem(
              label: 'Revenue',
              value: {{valuePrefix}}DashboardCurrency(edition.revenue, cents: false),
            ),
            RemixDataListItem(label: 'Status', value: edition.status.label),
          ],
        ),
      ],
    ),
  ),
);

/// What every edition shares, folded away until asked for.
class _EditionNotes extends StatefulWidget {
  const _EditionNotes();

  @override
  State<_EditionNotes> createState() => _EditionNotesState();
}

class _EditionNotesState extends State<_EditionNotes> {
  final _controller = RemixAccordionController<String>(min: 0, max: 1);

  static const _notes = [
    (
      'signing',
      'Signed and numbered',
      'Each print is signed and numbered by the artist, with a certificate.',
    ),
    (
      'shipping',
      'Shipping',
      'Rolled in a tube within five working days, tracked worldwide.',
    ),
    ('care', 'Care', 'Frame behind UV glass and keep out of direct sun.'),
  ];

  @override
  void dispose() {
    _controller.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) => RemixAccordionGroup(
    controller: _controller,
    child: ColumnBox(
      style: FlexBoxStyler()
          .crossAxisAlignment(.stretch)
          .spacing({{typePrefix}}Tokens.space2()),
      children: [
        for (final (value, title, body) in _notes)
          {{typePrefix}}Accordion<String>(
            value: value,
            title: title,
            child: StyledText(body, style: dashboardText(.size2, tone: .muted)),
          ),
      ],
    ),
  );
}
