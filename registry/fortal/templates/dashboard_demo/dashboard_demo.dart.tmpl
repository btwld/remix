          ColumnBox(
            style: FlexBoxStyler().crossAxisAlignment(.start).spacing(4),
            children: [
              {{typePrefix}}Heading(title, headingLevel: 3, size: .size3),
              {{typePrefix}}Text(description, size: .size1, highContrast: false),
            ],
          ),
          Box(style: BoxStyler().height(240), child: chart),
        ],
      ),
    );

