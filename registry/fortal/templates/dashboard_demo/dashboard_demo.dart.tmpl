/// Full {{typePrefix}} dashboard demo.
///
/// This is the open-code equivalent of the repository's {{typePrefix}} showcase: it
/// includes the same Workspace, Data, Manage, and Components destinations,
/// while demonstrating the Radix-aligned {{typePrefix}} vocabulary honestly.
class {{typePrefix}}DashboardDemo extends StatefulWidget {
  const {{typePrefix}}DashboardDemo({
    super.key,
    this.brand = const {{typePrefix}}Text(
      'Northstar',
      size: .size3,
      weight: .bold,
      softWrap: false,
      truncate: true,
    ),
    this.account,
    this.headerActions = const [],
    this.onSearchChanged,
    this.data = {{valuePrefix}}DashboardSampleData,
    this.initialPage = {{typePrefix}}DashboardDemoPage.overview,
    this.collapsed,
    this.initiallyCollapsed = false,
    this.onCollapsedChanged,
    this.builtInChrome = true,
    this.chatStepDelay = const Duration(milliseconds: 320),
  });

  final Widget brand;
  final Widget? account;
  final List<Widget> headerActions;
  final ValueChanged<String>? onSearchChanged;
  final {{typePrefix}}DashboardSampleData data;
  final {{typePrefix}}DashboardDemoPage initialPage;
  final bool? collapsed;
  final bool initiallyCollapsed;
  final ValueChanged<bool>? onCollapsedChanged;
  final bool builtInChrome;
  final Duration chatStepDelay;

  @override
  State<{{typePrefix}}DashboardDemo> createState() => _{{typePrefix}}DashboardDemoState();
}

class _{{typePrefix}}DashboardDemoState extends State<{{typePrefix}}DashboardDemo> {
  /// The appearance the toggle chose, or null to follow the scope this demo
  /// is placed in.
  bool? _dark;
  bool? _ambientIsDark;

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    final ambient = {{typePrefix}}Theme.maybeOf(context)?.isDark;
    if (_ambientIsDark != null && ambient != _ambientIsDark) {
      _dark = null;
    }
    _ambientIsDark = ambient;
  }

  bool get _isDark => _dark ?? ({{typePrefix}}Theme.maybeOf(context)?.isDark ?? false);

  @override
  Widget build(BuildContext context) {
    const kit = _{{typePrefix}}DashboardDemoKit();
    final demo = {{typePrefix}}DashboardDemoBase(
      initialPage: widget.initialPage,
      shellBuilder:
          (
            context, {
            required sections,
            required selectedValue,
            required onSelected,
            required body,
            required title,
            required onSearchChanged,
          }) => {{typePrefix}}DashboardShell<{{typePrefix}}DashboardDemoPage>(
            sections: sections,
            selectedValue: selectedValue,
            onSelected: onSelected,
            body: body,
            title: title,
            headerTitle: widget.builtInChrome
                ? _{{typePrefix}}Breadcrumb(page: selectedValue)
                : null,
            brand: widget.brand,
            account:
                widget.account ??
                (widget.builtInChrome ? const _{{typePrefix}}Account() : null),
            headerActions: [
              if (widget.builtInChrome) ..._chromeActions(),
              ...widget.headerActions,
            ],
            onSearchChanged:
                widget.builtInChrome || widget.onSearchChanged != null
                ? (value) {
                    onSearchChanged(value);
                    widget.onSearchChanged?.call(value);
                  }
                : null,
            collapsed: widget.collapsed,
            initiallyCollapsed: widget.initiallyCollapsed,
            onCollapsedChanged: widget.onCollapsedChanged,
          ),
      pageBuilder: (context, page, query, onSelected) => switch (page) {
        .overview => {{typePrefix}}DashboardOverview(
          data: widget.data,
          onViewOrders: () => onSelected({{typePrefix}}DashboardDemoPage.orders),
        ),
        .chat => {{typePrefix}}DashboardChatPage(
          styles: _{{valuePrefix}}AgentStyles(),
          stepDelay: widget.chatStepDelay,
        ),
        .customers => {{typePrefix}}DashboardCustomersPage(globalQuery: query),
        .orders => {{typePrefix}}DashboardOrdersPage(globalQuery: query),
        .settings => {{typePrefix}}DashboardSettingsPage(
          darkMode: _dark,
          onDarkModeChanged: (value) => setState(() => _dark = value),
        ),
        .actions => const GalleryActionsPage(),
        .forms => const GalleryFormsPage(),
        .dataDisplay => const GalleryDisplayPage(),
        .overlays => const GalleryOverlaysPage(),
        .navigation => const GalleryNavigationPage(),
        .typography => const GalleryTypographyPage(),
        _ => {{typePrefix}}DashboardDemoContent(
          page: page,
          kit: kit,
          data: widget.data,
        ),
      },
    );
    if (!widget.builtInChrome) return demo;
    return {{typePrefix}}Theme(
      mode: _isDark ? {{typePrefix}}ThemeMode.dark : {{typePrefix}}ThemeMode.light,
      child: RemixToastScope(style: {{valuePrefix}}ToastStyle(), child: demo),
    );
  }

  List<Widget> _chromeActions() => [
    {{typePrefix}}IconButton.ghost(
      key: const ValueKey('dashboard-appearance-toggle'),
      icon: _isDark ? {{icon:sun}} : {{icon:moon}},
      semanticLabel: _isDark ? 'Use light appearance' : 'Use dark appearance',
      onPressed: () => setState(() => _dark = !_isDark),
    ),
    {{typePrefix}}Popover(
      semanticLabel: 'Notifications',
      popoverChild: Box(
        style: BoxStyler().width(280).padding(.all(16)),
        child: ColumnBox(
          style: FlexBoxStyler()
              .mainAxisSize(.min)
              .crossAxisAlignment(.start)
              .spacing(6),
          children: const [
            {{typePrefix}}Text('Notifications', weight: .bold),
            {{typePrefix}}Text('Order ORD-1047 requires review.', size: .size2),
            {{typePrefix}}Text('Three customer invitations are pending.', size: .size2),
          ],
        ),
      ),
      child: const {{typePrefix}}IconButton.ghost(
        icon: {{icon:bell}},
        semanticLabel: 'Open notifications',
      ),
    ),
    {{typePrefix}}Popover(
      semanticLabel: 'Theme settings',
      popoverChild: Box(
        style: BoxStyler().width(300).padding(.all(16)),
        child: ColumnBox(
          style: FlexBoxStyler()
              .mainAxisSize(.min)
              .crossAxisAlignment(.stretch)
              .spacing(12),
          children: [
            const {{typePrefix}}Text('Theme settings', size: .size4, weight: .bold),
            ColumnBox(
              style: FlexBoxStyler().crossAxisAlignment(.stretch).spacing(8),
              children: [
                _settingLine('Appearance', _isDark ? 'Dark' : 'Light'),
                _settingLine('Accent color', 'Indigo'),
                _settingLine('Gray color', 'Slate'),
                _settingLine('Radius', 'Medium'),
                _settingLine('Scaling', '100%'),
              ],
            ),
          ],
        ),
      ),
      child: const {{typePrefix}}IconButton.ghost(
        icon: {{icon:gear}},
        semanticLabel: 'Open theme settings',
      ),
    ),
  ];

  Widget _settingLine(String label, String value) => RowBox(
    style: FlexBoxStyler().crossAxisAlignment(.center),
    children: [
      Expanded(child: {{typePrefix}}Text(label, size: .size2)),
      {{typePrefix}}Text(value, size: .size1, highContrast: false),
    ],
  );
}

