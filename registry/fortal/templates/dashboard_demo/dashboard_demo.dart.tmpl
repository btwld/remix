class _{{typePrefix}}DashboardTopBarState extends State<{{typePrefix}}DashboardTopBar> {
  final _notificationsController = MenuController();
  final _themeController = MenuController();
  bool _notificationsRead = false;
  bool? _wasDark;

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    final dark = {{typePrefix}}Theme.of(context).isDark;
    // Appearance changes used to dismiss these by remounting the demo.
    // Keep that behavior while retaining the dashboard's page state.
    if (_wasDark != null && _wasDark != dark) {
      _themeController.close();
      _notificationsController.close();
    }
    _wasDark = dark;
  }

  @override
  Widget build(BuildContext context) {
    final compact = MediaQuery.sizeOf(context).width < 600;
    final isDark = {{typePrefix}}Theme.of(context).isDark;

    return RowBox(
      style: FlexBoxStyler().spacing({{typePrefix}}Tokens.space2()),
      children: [
        KeyedSubtree(
          key: const ValueKey('dashboard-appearance-toggle'),
          child: RemixIconButton(
            key: const ValueKey('theme-quick-toggle'),
            semanticLabel: isDark
                ? 'Use light appearance'
                : 'Use dark appearance',
            style: _toolbarButtonStyle,
            onPressed: () {
              final theme = {{typePrefix}}DashboardThemeScope.of(context);
              theme.onChanged(
                theme.settings.copyWith(appearance: isDark ? .light : .dark),
              );
            },
            icon: isDark ? {{icon:sun}} : {{icon:moon}},
          ),
        ),
        if (!compact)
          {{typePrefix}}Popover(
            controller: _notificationsController,
            openOnTap: false,
            semanticLabel: 'Notifications',
            positioning: const OverlayPositionConfig(
              side: .bottom,
              alignment: .end,
              sideOffset: 8,
            ),
            popoverChild: Box(
              key: const ValueKey('topbar-notifications-content'),
              style: BoxStyler().width(330),
              child: ColumnBox(
                style: FlexBoxStyler()
                    .mainAxisSize(.min)
                    .crossAxisAlignment(.stretch)
                    .spacing(10),
                children: [
                  RowBox(
                    style: FlexBoxStyler().crossAxisAlignment(.center),
                    children: [
                      const Expanded(
                        child: {{typePrefix}}Heading(
                          'Notifications',
                          headingLevel: 2,
                          size: .size3,
                          weight: .medium,
                        ),
                      ),
                      if (!_notificationsRead)
                        {{typePrefix}}Button.ghost(
                          size: .size1,
                          onPressed: () {
                            setState(() => _notificationsRead = true);
                            _notificationsController.close();
                            showRemixToast(
                              context,
                              const RemixToastData(
                                title: 'All notifications marked read',
                                icon: {{icon:checkCircled}},
                              ),
                            );
                          },
                          label: 'Mark all read',
                        ),
                    ],
                  ),
                  for (final event in widget.activities.take(4))
                    RowBox(
                      style: FlexBoxStyler()
                          .crossAxisAlignment(.start)
                          .spacing(9),
                      children: [
                        Box(
                          style: BoxStyler()
                              .width(7)
                              .height(7)
                              .margin(.top(6))
                              .color(
                                _notificationsRead
                                    ? {{typePrefix}}Tokens.gray6()
                                    : {{typePrefix}}Tokens.accentIndicator(),
                              )
                              .borderRadius(.circular(4)),
                        ),
                        Expanded(
                          child: ColumnBox(
                            style: FlexBoxStyler()
                                .crossAxisAlignment(.start)
                                .spacing(2),
                            children: [
                              {{typePrefix}}Text(
                                event.title,
                                size: .size2,
                                weight: _notificationsRead ? .regular : .medium,
                              ),
                              StyledText(
                                event.relativeTime,
                                style: dashboardText(.size1, tone: .muted),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                ],
              ),
            ),
            child: Stack(
              clipBehavior: Clip.none,
              children: [
                RemixIconButton(
                  semanticLabel: 'Notifications',
                  style: _toolbarButtonStyle,
                  onPressed: _toggleNotifications,
                  icon: {{icon:bell}},
                ),
                // Sits in the button's top-right corner, outside the glyph's
                // box, so the icon builder's clip cannot cut it.
                if (!_notificationsRead)
                  const PositionedDirectional(
                    end: 8,
                    top: 8,
                    child: ExcludeSemantics(
                      child: IgnorePointer(child: _{{typePrefix}}UnreadDot()),
                    ),
                  ),
              ],
            ),
          ),
        {{typePrefix}}Popover(
          controller: _themeController,
          openOnTap: false,
          semanticLabel: 'Theme settings',
          positioning: const OverlayPositionConfig(
            side: .bottom,
            alignment: .end,
            sideOffset: 8,
          ),
          popoverChild: Box(
            // The popover surface adds `space4` padding on each side; leave a
            // 16px margin to the viewport edges on narrow phones.
            style: BoxStyler()
                .width(
                  math.min(
                    400,
                    MediaQuery.sizeOf(context).width -
                        32 -
                        2 * {{typePrefix}}Tokens.space4.resolve(context),
                  ),
                )
                .maxHeight(650),
            child: const SingleChildScrollView(child: {{typePrefix}}ThemePanel()),
          ),
          child: RemixIconButton(
            key: const ValueKey('theme-panel-trigger'),
            semanticLabel: 'Theme settings',
            style: _toolbarButtonStyle,
            onPressed: _toggleTheme,
            icon: {{icon:mixerHorizontal}},
          ),
        ),
        if (!compact)
          {{typePrefix}}ActionMenu(
            key: const ValueKey('topbar-account-trigger'),
            positioning: const OverlayPositionConfig(
              side: .bottom,
              alignment: .end,
              sideOffset: 8,
            ),
            trigger: RemixMenuTrigger.control(
              builder: (_, menu) => RemixIconButton(
                semanticLabel: 'Account menu',
                style: _toolbarButtonStyle,
                focusNode: menu.focusNode,
                onPressed: menu.toggle,
                icon: null,
                iconBuilder: (_, _, _) =>
                    const {{typePrefix}}Avatar(label: 'LF', size: .size2),
              ),
            ),
            actions: const [
              {{typePrefix}}Action(value: 'profile', label: 'Profile'),
              {{typePrefix}}Action(value: 'preferences', label: 'Preferences'),
              {{typePrefix}}Action(
                value: 'signout',
                label: 'Sign out',
                dividerBefore: true,
              ),
            ],
            onSelected: (value) => showRemixToast(
              context,
              RemixToastData(
                title: value == 'signout'
                    ? 'Signed out of demo'
                    : 'Opened $value',
                icon: {{icon:checkCircled}},
              ),
            ),
          ),
      ],
    );
  }

  void _toggleNotifications() {
    _notificationsController.isOpen
        ? _notificationsController.close()
        : _notificationsController.open();
  }

  void _toggleTheme() {
    _themeController.isOpen
        ? _themeController.close()
        : _themeController.open();
  }
}

