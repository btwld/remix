Widget? _chartLegend({{typePrefix}}DashboardChartCase chart, List<Color> palette) =>
    switch (chart) {
      .revenueMomentum => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Revenue series legend',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'revenue',
            label: 'Revenue',
            color: palette[0],
          ),
        ],
      ),
      .linePatterns => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Actual and plan line patterns',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'actual',
            label: 'Actual',
            color: palette[0],
          ),
          {{typePrefix}}DashboardChartLegendItem(
            id: 'plan',
            label: 'Plan',
            color: palette[1],
            pattern: .dashed,
          ),
        ],
      ),
      .stepGaps => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Inventory series legend',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'inventory',
            label: 'Inventory',
            color: palette[0],
          ),
        ],
      ),
      .viewportLabels => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Viewport revenue legend',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'viewport-revenue',
            label: 'Revenue',
            color: palette[0],
          ),
        ],
      ),
      .groupedBars => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Actual and plan bar patterns',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'actual',
            label: 'Actual',
            color: palette[0],
          ),
          {{typePrefix}}DashboardChartLegendItem(
            id: 'plan',
            label: 'Plan',
            color: palette[1],
            pattern: .dashed,
          ),
        ],
      ),
      .stackedBars => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Revenue mix legend',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'product',
            label: 'Product',
            color: palette[0],
          ),
          {{typePrefix}}DashboardChartLegendItem(
            id: 'services',
            label: 'Services',
            color: palette[1],
          ),
        ],
      ),
      .floatingBars => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Floating changes legend',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'change',
            label: 'Change range',
            color: palette[2],
          ),
        ],
      ),
      .trackedBars => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Tracked revenue legend',
        items: [
          {{typePrefix}}DashboardChartLegendItem(
            id: 'tracked',
            label: 'Revenue',
            color: palette[0],
          ),
        ],
      ),
      .trafficPie => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Traffic channel legend',
        items: {{valuePrefix}}PercentagePieLegendItems(
          slices: {{valuePrefix}}DashboardChannelSlices(),
          palette: palette,
        ),
      ),
      .badgePie => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Badge marker chart legend',
        items: {{valuePrefix}}PercentagePieLegendItems(
          slices: {{valuePrefix}}DashboardChannelSlices(),
          palette: palette,
        ),
      ),
      .interactivePie => {{typePrefix}}DashboardChartLegend(
        semanticLabel: 'Product mix legend',
        items: {{valuePrefix}}PercentagePieLegendItems(
          slices: {{valuePrefix}}DashboardProductSlices(),
          palette: palette,
        ),
      ),
      .emptyPie => null,
    };

{{typePrefix}}DashboardAgentStyles _{{valuePrefix}}AgentStyles() {
  final message = {{valuePrefix}}AgentMessageRecipe();
  final answer = {{valuePrefix}}AgentAnswerRecipe();
  final transcript = {{valuePrefix}}AgentTranscriptRecipe();
  final plan = {{valuePrefix}}AgentPlanRecipe();
  final activity = {{valuePrefix}}AgentActivityRecipe();
  final permission = {{valuePrefix}}AgentPermissionRecipe();
  final execution = {{valuePrefix}}AgentExecutionRecipe();
  final composer = {{valuePrefix}}AgentComposerRecipe();
  return {{typePrefix}}DashboardAgentStyles(
    buttonBuilder: (label, onPressed, tone) => switch (tone) {
      .primary => {{typePrefix}}Button(label: label, onPressed: onPressed),
      .soft => {{typePrefix}}Button.soft(label: label, onPressed: onPressed),
      .outline => {{typePrefix}}Button.outline(label: label, onPressed: onPressed),
    },
    heading: {{valuePrefix}}TextStyle(size: .size6, weight: .bold),
    body: {{valuePrefix}}TextStyle(size: .size2, highContrast: false),
    messageStyle: message.style,
    messageSurfaceStyle: message.surfaceStyle,
    answerStyle: answer.style,
    answerSurfaceStyle: answer.surfaceStyle,
    answerSourcesStyle: answer.sourcesStyle,
    answerCopyStyle: answer.copyStyle,
    answerRetryStyle: answer.retryStyle,
    transcriptStyle: transcript.style,
    planStyle: plan.style,
    planDisclosureStyle: plan.disclosureStyle,
    activityStyle: activity.style,
    activityDisclosureStyle: activity.disclosureStyle,
    permissionStyle: permission.style,
    permissionSurfaceStyle: permission.surfaceStyle,
    permissionDetailsStyle: permission.detailsStyle,
    permissionParametersStyle: permission.parametersStyle,
    permissionAllowOnceStyle: permission.allowOnceStyle,
    permissionAlwaysAllowStyle: permission.alwaysAllowStyle,
    permissionDenyStyle: permission.denyStyle,
    executionStyle: execution.style,
    executionSurfaceStyle: execution.surfaceStyle,
    executionDisclosureStyle: execution.disclosureStyle,
    executionCopyStyle: execution.copyStyle,
    executionRetryStyle: execution.retryStyle,
    composerStyle: composer.style,
    composerSurfaceStyle: composer.surfaceStyle,
    composerFieldStyle: composer.fieldStyle,
    composerSubmitStyle: composer.submitStyle,
    composerStopStyle: composer.stopStyle,
  );
}
