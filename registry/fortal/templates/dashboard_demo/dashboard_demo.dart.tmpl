/// Full {{typePrefix}} dashboard demo.
///
/// This is the open-code {{typePrefix}} showcase: it includes the Workspace, Data,
/// Manage, and Components destinations, live Radix theme customization,
/// interactive Agent chat, and 12 chart patterns.
class {{typePrefix}}DashboardDemo extends StatefulWidget {
  const {{typePrefix}}DashboardDemo({
    super.key,
    this.brand = const {{typePrefix}}DashboardBrand(),
    this.account,
    this.headerActions = const [],
    this.onSearchChanged,
    this.data = {{valuePrefix}}DashboardSampleData,
    this.initialPage = {{typePrefix}}DashboardDemoPage.overview,
    this.initialSettings = const {{typePrefix}}ThemeSettings(),
    this.collapsed,
    this.initiallyCollapsed = false,
    this.onCollapsedChanged,
    this.builtInChrome = true,
    this.chatStepDelay = const Duration(milliseconds: 320),
  });

  final Widget brand;
  final Widget? account;
  final List<Widget> headerActions;
  final ValueChanged<String>? onSearchChanged;
  final {{typePrefix}}DashboardSampleData data;
  final {{typePrefix}}DashboardDemoPage initialPage;
  final {{typePrefix}}ThemeSettings initialSettings;
  final bool? collapsed;
  final bool initiallyCollapsed;
  final ValueChanged<bool>? onCollapsedChanged;
  final bool builtInChrome;
  final Duration chatStepDelay;

  @override
  State<{{typePrefix}}DashboardDemo> createState() => _{{typePrefix}}DashboardDemoState();
}

class _{{typePrefix}}DashboardDemoState extends State<{{typePrefix}}DashboardDemo> {
  late {{typePrefix}}ThemeSettings _settings = widget.initialSettings;
  bool? _ambientIsDark;

  @override
  void didUpdateWidget(covariant {{typePrefix}}DashboardDemo oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.initialSettings != oldWidget.initialSettings) {
      _settings = widget.initialSettings;
    }
  }

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    final ambient = {{typePrefix}}Theme.maybeOf(context)?.isDark;
    if (_ambientIsDark != null && ambient != _ambientIsDark) {
      _settings = _settings.copyWith(appearance: .system);
    }
    _ambientIsDark = ambient;
  }

  bool _resolveIsDark(BuildContext context, {{typePrefix}}ThemeSettings settings) {
    final platformDark =
        MediaQuery.platformBrightnessOf(context) == Brightness.dark;
    final ambientDark = {{typePrefix}}Theme.maybeOf(context)?.isDark ?? false;
    return switch (settings.appearance) {
      .light => false,
      .dark => true,
      .system => platformDark || ambientDark,
    };
  }

  @override
  Widget build(BuildContext context) {
    final ambientScope = {{typePrefix}}DashboardThemeScope.maybeOf(context);
    final activeSettings = ambientScope?.settings ?? _settings;
    final onSettingsChanged =
        ambientScope?.onChanged ??
        ({{typePrefix}}ThemeSettings next) => setState(() => _settings = next);
    final isDark = _resolveIsDark(context, activeSettings);
    final demo = {{typePrefix}}DashboardDemoBase(
      initialPage: widget.initialPage,
      shellBuilder:
          (
            context, {
            required sections,
            required selectedValue,
            required onSelected,
            required body,
            required title,
            required onSearchChanged,
          }) => {{typePrefix}}DashboardShell<{{typePrefix}}DashboardDemoPage>(
            sections: sections,
            selectedValue: selectedValue,
            onSelected: onSelected,
            body: body,
            title: title,
            brand: widget.brand,
            account:
                widget.account ??
                (widget.builtInChrome
                    ? const {{typePrefix}}DashboardSidebarAccount()
                    : null),
            headerActions: [
              if (widget.builtInChrome)
                {{typePrefix}}DashboardTopBar(activities: widget.data.activities),
              ...widget.headerActions,
            ],
            onSearchChanged:
                widget.builtInChrome || widget.onSearchChanged != null
                ? (value) {
                    onSearchChanged(value);
                    widget.onSearchChanged?.call(value);
                  }
                : null,
            collapsed: widget.collapsed,
            initiallyCollapsed: widget.initiallyCollapsed,
            onCollapsedChanged: widget.onCollapsedChanged,
          ),
      pageBuilder: (context, page, query, onSelected) => switch (page) {
        .overview => {{typePrefix}}DashboardOverview(
          data: widget.data,
          onViewOrders: () => onSelected({{typePrefix}}DashboardDemoPage.orders),
        ),
        .chat => {{typePrefix}}DashboardChatPage(
          styles: _{{valuePrefix}}AgentStyles(),
          stepDelay: widget.chatStepDelay,
        ),
        .customers => {{typePrefix}}DashboardCustomersPage(globalQuery: query),
        .orders => {{typePrefix}}DashboardOrdersPage(globalQuery: query),
        .settings => {{typePrefix}}DashboardSettingsPage(
          darkMode: switch (activeSettings.appearance) {
            .light => false,
            .dark => true,
            .system => null,
          },
          onDarkModeChanged: (value) => onSettingsChanged(
            activeSettings.copyWith(
              appearance: switch (value) {
                false => .light,
                true => .dark,
                null => .system,
              },
            ),
          ),
        ),
      },
    );
    if (!widget.builtInChrome || ambientScope != null) return demo;
    return {{typePrefix}}DashboardThemeScope(
      settings: _settings,
      onChanged: onSettingsChanged,
      child: {{typePrefix}}Theme(
        key: const ValueKey('dashboard-theme-scope'),
        mode: isDark ? {{typePrefix}}ThemeMode.dark : {{typePrefix}}ThemeMode.light,
        accent: _settings.accentColor,
        gray: _settings.grayColor,
        panelBackground: _settings.panelBackground,
        radius: _settings.radius,
        scaling: _settings.scaling,
        child: RemixToastScope(style: {{valuePrefix}}ToastStyle(), child: demo),
      ),
    );
  }
}

