/// The Analytics page: where revenue comes from and how editions sell.
class {{typePrefix}}DashboardAnalyticsPage extends StatelessWidget {
  const {{typePrefix}}DashboardAnalyticsPage({super.key, this.data});

  /// The records the page analyzes. Defaults to [{{valuePrefix}}DashboardSampleData].
  final {{typePrefix}}DashboardData? data;

  @override
  Widget build(BuildContext context) {
    final data = this.data ?? {{valuePrefix}}DashboardSampleData;
    return {{typePrefix}}Page(
      key: const ValueKey('dashboard-analytics'),
      title: 'Analytics',
      description: 'Where revenue comes from and how each edition sells.',
      actions: [
        {{typePrefix}}Button.soft(
          label: 'Download report',
          leadingIcon: {{icon:download}},
          onPressed: () => showRemixToast(
            context,
            const RemixToastData(
              title: 'Analytics report prepared',
              icon: {{icon:checkCircled}},
            ),
          ),
        ),
      ],
      children: [
        {{typePrefix}}SummaryStrip(metrics: data.metrics),
        {{typePrefix}}RevenueCard(
          data: data,
          emphasis: .standard,
          initialRange: .month,
        ),
        GridBox(
          key: const ValueKey('analytics-breakdown'),
          style: {{valuePrefix}}HalvesGrid,
          children: [
            {{typePrefix}}ChannelOrdersCard(channels: data.channels, weeks: data.weeks),
            {{typePrefix}}SellThroughCard(editions: data.editions),
          ],
        ),
        GridBox(
          key: const ValueKey('analytics-channels'),
          style: {{valuePrefix}}LeadGrid,
          children: [
            {{typePrefix}}ChannelTableCard(channels: data.channels),
            const {{typePrefix}}InsightsCard(),
          ],
        ),
      ],
    );
  }
}

/// Headline figures in one surface, a divider apart: the compact alternative
/// to a row of stat cards.
class {{typePrefix}}SummaryStrip extends StatelessWidget {
  const {{typePrefix}}SummaryStrip({super.key, required this.metrics});

  // A one-pixel gap over a divider-coloured ground draws the rules between
  // cells, and none around the outside, at every column count.
  static final _grid = GridBoxStyler.equalColumns(4)
      .gap(1)
      .onConstraints(const .maxWidth(799), .equalColumns(2).gap(1))
      .onConstraints(const .maxWidth(419), .equalColumns(1).gap(1));

  /// The figures shown, in order.
  final List<{{typePrefix}}DashboardMetric> metrics;

  @override
  Widget build(BuildContext context) => {{typePrefix}}Surface(
    key: const ValueKey('analytics-summary'),
    padded: false,
    child: Box(
      style: BoxStyler().color({{typePrefix}}Tokens.gray5()),
      child: GridBox(
        style: _grid,
        children: [
          for (final metric in metrics)
            Box(
              style: BoxStyler()
                  .padding(.all({{typePrefix}}Tokens.space4()))
                  .color({{typePrefix}}Tokens.colorPanelSolid()),
              child: ColumnBox(
                style: FlexBoxStyler()
                    .crossAxisAlignment(.start)
                    .spacing({{typePrefix}}Tokens.space2()),
                children: [
                  StyledText(
                    metric.label,
                    style: dashboardTextLine(.size2, tone: .muted),
                  ),
                  RowBox(
                    style: FlexBoxStyler()
                        .mainAxisSize(.min)
                        .crossAxisAlignment(.center)
                        .spacing({{typePrefix}}Tokens.space2()),
                    children: [
                      Flexible(
                        child: {{typePrefix}}Text(
                          metric.value,
                          size: .size6,
                          weight: .bold,
                          truncate: true,
                        ),
                      ),
                      {{typePrefix}}DeltaBadge(metric.delta, positive: metric.positive),
                    ],
                  ),
                ],
              ),
            ),
        ],
      ),
    ),
  );
}

/// Weekly orders as bars stacked by channel.
class {{typePrefix}}ChannelOrdersCard extends StatelessWidget {
  const {{typePrefix}}ChannelOrdersCard({
    super.key,
    required this.channels,
    required this.weeks,
  });

  /// The channels, in the order each week's counts follow.
  final List<{{typePrefix}}DashboardChannel> channels;

  /// The weeks plotted, oldest first.
  final List<{{typePrefix}}DashboardWeek> weeks;

  @override
  Widget build(BuildContext context) {
    final palette = resolve{{typePrefix}}ChartPalette(context);
    Color colorOf(int channel) => palette[channel % palette.length];

    return {{typePrefix}}Surface(
      child: ColumnBox(
        style: FlexBoxStyler()
            .crossAxisAlignment(.stretch)
            .spacing({{typePrefix}}Tokens.space4()),
        children: [
          const {{typePrefix}}CardHeader(
            title: 'Orders by channel',
            description: 'Weekly orders, last six weeks',
          ),
          SizedBox(
            height: 240 * {{typePrefix}}Theme.of(context).scaling.factor,
            child: RepaintBoundary(
              child: {{typePrefix}}BarChart(
                key: const ValueKey('analytics-orders-chart'),
                palette: palette,
                semanticsLabel: 'Weekly orders by channel',
                groups: [
                  for (final week in weeks)
                    BarGroup(
                      id: week.label,
                      label: week.label,
                      bars: [_stack(week, colorOf)],
                    ),
                ],
                yAxis: {{valuePrefix}}DashboardDataAxis(
                  weeks.map(
                    (week) => week.orders.fold(0, (sum, count) => sum + count),
                  ),
                  targetIntervals: 4,
                ),
                style: {{valuePrefix}}DashboardBarStyle().bar(
                  BarStyler().width({{typePrefix}}Tokens.space5()),
                ),
              ),
            ),
          ),
          {{typePrefix}}DashboardChartLegend(
            semanticLabel: 'Channels',
            items: [
              for (final (index, channel) in channels.indexed)
                {{typePrefix}}DashboardChartLegendItem(
                  id: channel.id,
                  label: channel.label,
                  color: colorOf(index),
                ),
            ],
          ),
        ],
      ),
    );
  }

  /// One week's bar: a segment per channel, each starting where the last
  /// one ended.
  BarValue _stack({{typePrefix}}DashboardWeek week, Color Function(int) colorOf) {
    var from = 0.0;
    final segments = <BarSegment>[];
    for (final (index, count) in week.orders.indexed) {
      segments.add(
        BarSegment(
          id: channels[index].id,
          label: channels[index].label,
          fromY: from,
          toY: from + count,
          style: BarSegmentStyler().color(colorOf(index)),
        ),
      );
      from += count;
    }

    return BarValue(
      id: 'orders',
      label: 'Orders',
      toY: from,
      segments: segments,
    );
  }
}

/// How much of each released edition has sold, with its cover.
class {{typePrefix}}SellThroughCard extends StatelessWidget {
  const {{typePrefix}}SellThroughCard({
    super.key,
    required this.editions,
    this.count = 6,
  });

  /// The collection. Drafts are left out.
  final List<{{typePrefix}}DashboardEdition> editions;

  /// How many editions to list.
  final int count;

  @override
  Widget build(BuildContext context) {
    final released =
        editions.where((edition) => edition.status != .draft).toList()
          ..sort((a, b) => b.soldFraction.compareTo(a.soldFraction));
    return {{typePrefix}}Surface(
      child: ColumnBox(
        style: FlexBoxStyler()
            .crossAxisAlignment(.stretch)
            .spacing({{typePrefix}}Tokens.space3()),
        children: [
          const {{typePrefix}}CardHeader(
            title: 'Sell-through',
            description: 'Share of each edition sold',
          ),
          for (final edition in released.take(count))
            RowBox(
              style: FlexBoxStyler()
                  .crossAxisAlignment(.center)
                  .spacing({{typePrefix}}Tokens.space3()),
              children: [
                {{typePrefix}}EditionThumbnail(edition, extent: 36),
                Expanded(
                  child: ColumnBox(
                    style: FlexBoxStyler()
                        .crossAxisAlignment(.stretch)
                        .spacing({{typePrefix}}Tokens.space1()),
                    children: [
                      RowBox(
                        style: FlexBoxStyler().spacing({{typePrefix}}Tokens.space2()),
                        children: [
                          Expanded(
                            child: {{typePrefix}}Text(
                              edition.title,
                              size: .size2,
                              weight: .medium,
                              truncate: true,
                            ),
                          ),
                          StyledText(
                            '${(edition.soldFraction * 100).round()}%',
                            style: dashboardText(.size1, tone: .muted),
                          ),
                        ],
                      ),
                      {{typePrefix}}Progress(
                        value: edition.soldFraction,
                        size: .size1,
                        semanticsLabel: '${edition.title} sold',
                      ),
                    ],
                  ),
                ),
              ],
            ),
        ],
      ),
    );
  }
}

/// Each channel's revenue, share and change, as a table.
class {{typePrefix}}ChannelTableCard extends StatelessWidget {
  const {{typePrefix}}ChannelTableCard({super.key, required this.channels});

  static final _columns = <RemixDataTableColumn<{{typePrefix}}DashboardChannel>>[
    RemixDataTableColumn(
      id: 'channel',
      label: 'Channel',
      width: const FlexColumnWidth(2),
      cellBuilder: (_, channel) =>
          {{typePrefix}}DataTableCellText(channel.label, primary: true),
    ),
    RemixDataTableColumn(
      id: 'revenue',
      label: 'Revenue',
      width: const FixedColumnWidth(120),
      alignment: AlignmentDirectional.centerEnd,
      cellBuilder: (_, channel) => {{typePrefix}}DataTableCellText(
        {{valuePrefix}}DashboardCurrency(channel.revenue, cents: false),
        primary: true,
      ),
    ),
    RemixDataTableColumn(
      id: 'share',
      label: 'Share',
      width: const FixedColumnWidth(88),
      alignment: AlignmentDirectional.centerEnd,
      cellBuilder: (_, channel) =>
          {{typePrefix}}DataTableCellText('${channel.share.toInt()}%'),
    ),
    RemixDataTableColumn(
      id: 'change',
      label: 'Change',
      width: const FixedColumnWidth(104),
      cellBuilder: (_, channel) => {{typePrefix}}DeltaBadge(
        channel.delta,
        positive: !channel.delta.startsWith('-'),
      ),
    ),
  ];

  /// The channels compared.
  final List<{{typePrefix}}DashboardChannel> channels;

  @override
  Widget build(BuildContext context) => {{typePrefix}}Surface(
    padded: false,
    child: ColumnBox(
      style: FlexBoxStyler().crossAxisAlignment(.stretch),
      children: [
        Box(
          style: BoxStyler().padding(
            .symmetric(
              horizontal: {{typePrefix}}Tokens.space3(),
              vertical: {{typePrefix}}Tokens.space4(),
            ),
          ),
          child: const {{typePrefix}}CardHeader(
            title: 'Channel performance',
            description: 'This week against last',
          ),
        ),
        {{typePrefix}}DataTable<{{typePrefix}}DashboardChannel>(
          key: const ValueKey('analytics-channel-table'),
          semanticLabel: 'Channel performance',
          rows: channels,
          minimumWidth: 440,
          columns: _columns,
        ),
      ],
    ),
  );
}

