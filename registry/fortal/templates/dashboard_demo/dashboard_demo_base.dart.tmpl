import 'package:flutter/rendering.dart';
import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
{{icon:import}}

/// The navigation groups shared across dashboard showcase presets.
enum {{typePrefix}}DashboardDemoSection {
  workspace('Workspace'),
  data('Data'),
  manage('Manage');

  const {{typePrefix}}DashboardDemoSection(this.label);

  final String label;
}

/// The navigation destinations in the dashboard demo.
enum {{typePrefix}}DashboardDemoPage {
  overview({{typePrefix}}DashboardDemoSection.workspace, 'Overview', {{icon:dashboard}}),
  chat({{typePrefix}}DashboardDemoSection.workspace, 'Chat', {{icon:chatBubble}}),
  customers({{typePrefix}}DashboardDemoSection.data, 'Customers', {{icon:group}}),
  orders({{typePrefix}}DashboardDemoSection.data, 'Orders', {{icon:table}}),
  settings({{typePrefix}}DashboardDemoSection.manage, 'Settings', {{icon:mixerHorizontal}});

  const {{typePrefix}}DashboardDemoPage(this.section, this.label, this.icon);

  final {{typePrefix}}DashboardDemoSection section;
  final String label;
  final IconData icon;
}

/// The section identifiers for each page in the dashboard demo.
const {{valuePrefix}}DashboardDemoSectionIds = {
  {{typePrefix}}DashboardDemoPage.overview: [
    'metrics',
    'analytics',
    'activity',
    'recent-orders',
  ],
  {{typePrefix}}DashboardDemoPage.chat: [
    'starters',
    'transcript',
    'plan',
    'activity',
    'permission',
    'execution',
    'answer',
    'composer',
  ],
  {{typePrefix}}DashboardDemoPage.customers: [
    'search',
    'selection-actions',
    'customer-table',
  ],
  {{typePrefix}}DashboardDemoPage.orders: ['status-filters', 'order-table'],
  {{typePrefix}}DashboardDemoPage.settings: [
    'profile',
    'preferences',
    'appearance',
    'danger-zone',
  ],
};

/// The sidebar sections and destinations for the dashboard demo.
final {{valuePrefix}}DashboardDemoSections =
    List<RemixSidebarSection<{{typePrefix}}DashboardDemoPage>>.unmodifiable([
      for (final section in {{typePrefix}}DashboardDemoSection.values)
        RemixSidebarSection(
          label: section.label,
          destinations: [
            for (final page in {{typePrefix}}DashboardDemoPage.values)
              if (page.section == section)
                RemixSidebarDestination(
                  value: page,
                  label: page.label,
                  icon: page.icon,
                ),
          ],
        ),
    ]);

/// Returns the dashboard destinations whose label, section, or component
/// section identifiers match [query].
Set<{{typePrefix}}DashboardDemoPage> {{valuePrefix}}DashboardMatchingPages(String query) {
  final normalized = query.trim().toLowerCase();
  if (normalized.isEmpty) {
    return {{typePrefix}}DashboardDemoPage.values.toSet();
  }
  return {
    for (final page in {{typePrefix}}DashboardDemoPage.values)
      if (page.label.toLowerCase().contains(normalized) ||
          page.section.label.toLowerCase().contains(normalized) ||
          ({{valuePrefix}}DashboardDemoSectionIds[page]?.any(
                (id) =>
                    id.contains(normalized) ||
                    id.replaceAll('-', ' ').contains(normalized),
              ) ??
              false))
        page,
  };
}

typedef {{typePrefix}}DashboardDemoShellBuilder =
    Widget Function(
      BuildContext context, {
      required List<RemixSidebarSection<{{typePrefix}}DashboardDemoPage>> sections,
      required {{typePrefix}}DashboardDemoPage selectedValue,
      required ValueChanged<{{typePrefix}}DashboardDemoPage> onSelected,
      required Widget body,
      required String title,
      required ValueChanged<String> onSearchChanged,
    });

typedef {{typePrefix}}DashboardDemoPageBuilder =
    Widget Function(
      BuildContext context,
      {{typePrefix}}DashboardDemoPage page,
      String searchQuery,
      ValueChanged<{{typePrefix}}DashboardDemoPage> onSelected,
    );

/// Shared state and navigation for the dashboard demo.
///
/// Displays pages in an [IndexedStack] to preserve state across navigation.
class {{typePrefix}}DashboardDemoBase extends StatefulWidget {
  const {{typePrefix}}DashboardDemoBase({
    super.key,
    required this.shellBuilder,
    required this.pageBuilder,
    this.initialPage = {{typePrefix}}DashboardDemoPage.overview,
  });

  final {{typePrefix}}DashboardDemoShellBuilder shellBuilder;
  final {{typePrefix}}DashboardDemoPageBuilder pageBuilder;
  final {{typePrefix}}DashboardDemoPage initialPage;

  @override
  State<{{typePrefix}}DashboardDemoBase> createState() =>
      _{{typePrefix}}DashboardDemoBaseState();
}

class _{{typePrefix}}DashboardDemoBaseState extends State<{{typePrefix}}DashboardDemoBase> {
  late {{typePrefix}}DashboardDemoPage _selected = widget.initialPage;
  late final _visitedPages = <{{typePrefix}}DashboardDemoPage>{widget.initialPage};
  String _searchQuery = '';

  @override
  void didUpdateWidget(covariant {{typePrefix}}DashboardDemoBase oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.initialPage != oldWidget.initialPage &&
        _selected == oldWidget.initialPage) {
      _selected = widget.initialPage;
      _visitedPages.add(_selected);
    }
  }

  void _select({{typePrefix}}DashboardDemoPage page) {
    if (_selected == page) return;
    setState(() {
      _selected = page;
      _visitedPages.add(page);
    });
  }

  void _handleSearchChanged(String value) {
    final nextQuery = value.trim().toLowerCase();
    if (_searchQuery == nextQuery) return;
    setState(() {
      _searchQuery = nextQuery;
      if (nextQuery.isEmpty) return;
      final matches = {{valuePrefix}}DashboardMatchingPages(nextQuery);
      if (matches.isNotEmpty &&
          !matches.contains(_selected) &&
          _selected != {{typePrefix}}DashboardDemoPage.customers &&
          _selected != {{typePrefix}}DashboardDemoPage.orders) {
        _selected = matches.first;
        _visitedPages.add(_selected);
      }
    });
  }

  List<RemixSidebarSection<{{typePrefix}}DashboardDemoPage>> _visibleSections() {
    if (_searchQuery.isEmpty) return {{valuePrefix}}DashboardDemoSections;
    final matches = {{valuePrefix}}DashboardMatchingPages(_searchQuery);
    if (matches.isEmpty) return {{valuePrefix}}DashboardDemoSections;
    final visible = {...matches, _selected};
    return [
      for (final section in {{typePrefix}}DashboardDemoSection.values)
        if ({{typePrefix}}DashboardDemoPage.values.any(
          (page) => page.section == section && visible.contains(page),
        ))
          RemixSidebarSection(
            label: section.label,
            destinations: [
              for (final page in {{typePrefix}}DashboardDemoPage.values)
                if (page.section == section && visible.contains(page))
                  RemixSidebarDestination(
                    value: page,
                    label: page.label,
                    icon: page.icon,
                  ),
            ],
          ),
    ];
  }

  @override
  Widget build(BuildContext context) => widget.shellBuilder(
    context,
    sections: _visibleSections(),
    selectedValue: _selected,
    onSelected: _select,
    title: _selected.label,
    onSearchChanged: _handleSearchChanged,
    body: IndexedStack(
      key: const ValueKey('dashboard-demo-pages'),
      index: _selected.index,
      children: [
        for (final page in {{typePrefix}}DashboardDemoPage.values)
          if (_visitedPages.contains(page))
            TickerMode(
              key: ValueKey('dashboard-page-${page.name}'),
              enabled: page == _selected,
              child: RepaintBoundary(
                child: _FreezeInactiveConstraints(
                  active: page == _selected,
                  child: widget.pageBuilder(
                    context,
                    page,
                    _searchQuery,
                    _select,
                  ),
                ),
              ),
            )
          else
            const SizedBox.shrink(),
      ],
    ),
  );
}

class _FreezeInactiveConstraints extends SingleChildRenderObjectWidget {
  const _FreezeInactiveConstraints({
    required this.active,
    required super.child,
  });

  final bool active;

  @override
  RenderObject createRenderObject(BuildContext context) =>
      _RenderFreezeInactiveConstraints(active);

  @override
  void updateRenderObject(
    BuildContext context,
    covariant _RenderFreezeInactiveConstraints renderObject,
  ) {
    renderObject.active = active;
  }
}

class _RenderFreezeInactiveConstraints extends RenderBox
    with RenderObjectWithChildMixin<RenderBox> {
  _RenderFreezeInactiveConstraints(this._active);

  bool _active;
  BoxConstraints? _frozenConstraints;

  bool get active => _active;
  set active(bool value) {
    if (_active == value) return;
    _active = value;
    if (value) {
      markNeedsLayout();
    }
  }

  @override
  void performLayout() {
    final child = this.child;
    if (child == null) {
      size = constraints.smallest;
      return;
    }
    final effectiveConstraints = _active
        ? (_frozenConstraints = constraints)
        : (_frozenConstraints ?? constraints);
    if (constraints.isTight) {
      child.layout(effectiveConstraints);
      size = constraints.biggest;
    } else {
      child.layout(effectiveConstraints, parentUsesSize: true);
      size = constraints.constrain(child.size);
    }
  }

  @override
  void paint(PaintingContext context, Offset offset) {
    if (!_active) return;
    final child = this.child;
    if (child != null) {
      context.paintChild(child, offset);
    }
  }

  @override
  bool hitTestChildren(BoxHitTestResult result, {required Offset position}) =>
      _active && (child?.hitTest(result, position: position) ?? false);
}
