import 'package:flutter/widgets.dart';

import '../../theme/theme.dart';

/// Immutable theme configuration controlled by the dashboard demo.
@immutable
class {{typePrefix}}ThemeSettings {
  const {{typePrefix}}ThemeSettings({
    this.appearance = .system,
    this.accentColor = .orla,
    this.panelBackground = .solid,
    this.radius = .medium,
    this.scaling = .percent100,
  });

  /// Light, dark or system appearance.
  final {{typePrefix}}ThemeMode appearance;

  /// The accent color.
  final {{typePrefix}}AccentColor accentColor;

  /// Whether panels are solid or translucent.
  final {{typePrefix}}PanelBackground panelBackground;

  /// The corner radius scale.
  final {{typePrefix}}Radius radius;

  /// The size scale applied to the whole interface.
  final {{typePrefix}}Scaling scaling;

  {{typePrefix}}ThemeSettings copyWith({
    {{typePrefix}}ThemeMode? appearance,
    {{typePrefix}}AccentColor? accentColor,
    {{typePrefix}}PanelBackground? panelBackground,
    {{typePrefix}}Radius? radius,
    {{typePrefix}}Scaling? scaling,
  }) => {{typePrefix}}ThemeSettings(
    appearance: appearance ?? this.appearance,
    accentColor: accentColor ?? this.accentColor,
    panelBackground: panelBackground ?? this.panelBackground,
    radius: radius ?? this.radius,
    scaling: scaling ?? this.scaling,
  );

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is {{typePrefix}}ThemeSettings &&
          other.appearance == appearance &&
          other.accentColor == accentColor &&
          other.panelBackground == panelBackground &&
          other.radius == radius &&
          other.scaling == scaling;

  @override
  int get hashCode =>
      Object.hash(appearance, accentColor, panelBackground, radius, scaling);
}

/// Provides live [{{typePrefix}}ThemeSettings] to the dashboard demo subtree.
class {{typePrefix}}DashboardThemeScope extends InheritedWidget {
  const {{typePrefix}}DashboardThemeScope({
    super.key,
    required this.settings,
    required this.onChanged,
    required super.child,
  });

  /// The current theme settings.
  final {{typePrefix}}ThemeSettings settings;

  /// Called with the new settings when the user changes one.
  final ValueChanged<{{typePrefix}}ThemeSettings> onChanged;

  static {{typePrefix}}DashboardThemeScope? maybeOf(BuildContext context) =>
      context.dependOnInheritedWidgetOfExactType<{{typePrefix}}DashboardThemeScope>();

  static {{typePrefix}}DashboardThemeScope of(BuildContext context) {
    final scope = maybeOf(context);
    assert(
      scope != null,
      '{{typePrefix}}DashboardThemeScope is missing above this context.',
    );
    return scope!;
  }

  @override
  bool updateShouldNotify({{typePrefix}}DashboardThemeScope oldWidget) =>
      settings != oldWidget.settings || onChanged != oldWidget.onChanged;
}

/// Applies a local accent without painting a background surface.
class {{typePrefix}}AccentScope extends StatelessWidget {
  const {{typePrefix}}AccentScope({
    super.key,
    required {{typePrefix}}AccentColor this.accent,
    required this.child,
  });

  /// Applies the dedicated error red to destructive or negative content.
  /// Error is a semantic palette, not a selectable accent.
  const {{typePrefix}}AccentScope.error({super.key, required this.child})
    : accent = null;

  /// The local accent, or null for the error palette.
  final {{typePrefix}}AccentColor? accent;

  /// The subtree that uses the accent.
  final Widget child;

  @override
  Widget build(BuildContext context) => {{typePrefix}}Theme(
    accent: accent,
    accentPalette: accent == null ? {{valuePrefix}}Error : null,
    hasBackground: false,
    child: child,
  );
}
