/// One headline value shown by the dashboard overview.
final class {{typePrefix}}DashboardMetric {
  const {{typePrefix}}DashboardMetric({
    required this.label,
    required this.value,
    required this.change,
  });

  final String label;
  final String value;
  final String change;
}

/// One point in the overview's primary time series.
final class {{typePrefix}}DashboardPoint {
  const {{typePrefix}}DashboardPoint({required this.label, required this.value});

  final String label;
  final double value;
}

/// One row in the overview's recent-records table.
final class {{typePrefix}}DashboardRecord {
  const {{typePrefix}}DashboardRecord({
    required this.id,
    required this.customer,
    required this.status,
    required this.amount,
  });

  final String id;
  final String customer;
  final String status;
  final String amount;
}

/// One event in the overview activity feed.
final class {{typePrefix}}DashboardActivity {
  const {{typePrefix}}DashboardActivity({
    required this.title,
    required this.detail,
    required this.relativeTime,
  });

  final String title;
  final String detail;
  final String relativeTime;
}

/// Local, deterministic starter content intended to be edited after install.
final class {{typePrefix}}DashboardSampleData {
  const {{typePrefix}}DashboardSampleData({
    required this.metrics,
    required this.revenue,
    required this.records,
    this.activities = const [],
  });

  final List<{{typePrefix}}DashboardMetric> metrics;
  final List<{{typePrefix}}DashboardPoint> revenue;
  final List<{{typePrefix}}DashboardRecord> records;
  final List<{{typePrefix}}DashboardActivity> activities;
}

