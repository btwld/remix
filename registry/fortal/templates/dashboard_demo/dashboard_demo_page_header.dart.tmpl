import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';

import 'dashboard_demo_typography.dart';
import 'dashboard_demo_ui.dart';

/// The widest a page's content grows, so lines stay readable on a large
/// display.
const {{valuePrefix}}PageMaxWidth = 1440.0;

/// The one gutter every dashboard page uses: 24 wide, 16 on a phone.
///
/// It follows the window, not the page's own width, so a page does not
/// rebuild on every frame while the sidebar beside it animates.
EdgeInsets {{valuePrefix}}PagePadding(BuildContext context) =>
    EdgeInsets.all(MediaQuery.sizeOf(context).width < 600 ? 16 : 24);

/// A dashboard page: a title block above a column of sections, scrolling
/// together inside [{{valuePrefix}}PagePadding].
class {{typePrefix}}Page extends StatelessWidget {
  const {{typePrefix}}Page({
    super.key,
    required this.title,
    required this.description,
    this.actions = const [],
    this.maxWidth = {{valuePrefix}}PageMaxWidth,
    this.scrollController,
    required this.children,
  });

  /// The page title, published as the page's level-one heading.
  final String title;

  /// A line of supporting copy under the title.
  final String description;

  /// Controls beside the title. They wrap under it when space runs out.
  final List<Widget> actions;

  /// The widest the content grows.
  final double maxWidth;

  /// Controls the page's scroll position.
  final ScrollController? scrollController;

  /// The page's sections, top to bottom.
  final List<Widget> children;

  @override
  Widget build(BuildContext context) => SingleChildScrollView(
    controller: scrollController,
    padding: {{valuePrefix}}PagePadding(context),
    child: Box(
      style: BoxStyler().alignment(.topStart),
      child: ColumnBox(
        style: FlexBoxStyler()
            .maxWidth(maxWidth)
            .crossAxisAlignment(.stretch)
            .spacing({{typePrefix}}Tokens.space5()),
        children: [
          {{typePrefix}}PageHeader(
            title: title,
            description: description,
            actions: actions,
          ),
          ...children,
        ],
      ),
    ),
  );
}

/// The title, description and actions at the top of a page.
class {{typePrefix}}PageHeader extends StatelessWidget {
  const {{typePrefix}}PageHeader({
    super.key,
    required this.title,
    required this.description,
    this.actions = const [],
  });

  /// The page title, published as the page's level-one heading.
  final String title;

  /// A line of supporting copy under the title.
  final String description;

  /// Controls beside the title. They wrap under it when space runs out.
  final List<Widget> actions;

  @override
  Widget build(BuildContext context) => WrapBox(
    style: WrapBoxStyler()
        .wrapAlignment(.spaceBetween)
        .crossAxisAlignment(.end)
        .spacing({{typePrefix}}Tokens.space4())
        .runSpacing({{typePrefix}}Tokens.space3()),
    children: [
      ColumnBox(
        style: FlexBoxStyler()
            .mainAxisSize(.min)
            .crossAxisAlignment(.start)
            .spacing({{typePrefix}}Tokens.space1()),
        children: [
          {{typePrefix}}Heading(title, size: .size6, weight: .bold),
          StyledText(description, style: dashboardText(.size2, tone: .muted)),
        ],
      ),
      if (actions.isNotEmpty)
        WrapBox(
          style: WrapBoxStyler()
              .crossAxisAlignment(.center)
              .spacing({{typePrefix}}Tokens.space2())
              .runSpacing({{typePrefix}}Tokens.space2()),
          children: actions,
        ),
    ],
  );
}
