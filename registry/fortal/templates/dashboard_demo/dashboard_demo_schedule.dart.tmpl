/// The Schedule page: the studio calendar beside the day and the weeks ahead.
///
/// Picking a day on the calendar shows what is on it. The agenda lists
/// everything inside a date range the user can change, and new events are
/// dated with a date picker.
class {{typePrefix}}DashboardSchedulePage extends StatefulWidget {
  const {{typePrefix}}DashboardSchedulePage({super.key, this.data});

  /// The records the page shows. Defaults to [{{valuePrefix}}DashboardSampleData].
  final {{typePrefix}}DashboardData? data;

  @override
  State<{{typePrefix}}DashboardSchedulePage> createState() =>
      _{{typePrefix}}DashboardSchedulePageState();
}

class _{{typePrefix}}DashboardSchedulePageState
    extends State<{{typePrefix}}DashboardSchedulePage> {
  static final _split = GridBoxStyler.columns(const [.fixed(372), .fr(1)])
      .gap({{valuePrefix}}DashboardGap)
      .onConstraints(
        const .maxWidth(859),
        .equalColumns(1).gap({{valuePrefix}}DashboardGap),
      );

  /// Events the user added on this page, kept apart from the caller's data.
  final _added = <{{typePrefix}}DashboardEvent>[];
  late DateTime _day = _data.today;
  late CivilDateRange _range = CivilDateRange(
    start: _data.today,
    end: _data.today.add(const Duration(days: 30)),
  );

  {{typePrefix}}DashboardData get _data => widget.data ?? {{valuePrefix}}DashboardSampleData;

  DateTime get _first => DateTime(_data.today.year - 1);

  DateTime get _last => DateTime(_data.today.year + 2, 12, 31);

  List<{{typePrefix}}DashboardEvent> get _events =>
      [..._data.events, ..._added]..sort((a, b) => a.date.compareTo(b.date));

  @override
  Widget build(BuildContext context) {
    final events = _events;
    final onDay = [
      for (final event in events)
        if (_sameDay(event.date, _day)) event,
    ];
    final inRange = [
      for (final event in events)
        if (!event.date.isBefore(_range.start) &&
            !event.date.isAfter(_range.end))
          event,
    ];

    return {{typePrefix}}Page(
      key: const ValueKey('dashboard-schedule'),
      title: 'Schedule',
      description: 'Releases, proofs and pickups on the studio calendar.',
      actions: [
        {{typePrefix}}Button(
          key: const ValueKey('schedule-new-event'),
          label: 'New event',
          leadingIcon: {{icon:plus}},
          onPressed: _addEvent,
        ),
      ],
      children: [
        GridBox(
          key: const ValueKey('schedule-split'),
          style: _split,
          children: [
            {{typePrefix}}Surface(
              child: ColumnBox(
                style: FlexBoxStyler()
                    .crossAxisAlignment(.center)
                    .spacing({{typePrefix}}Tokens.space3()),
                children: [
                  {{typePrefix}}Calendar(
                    key: const ValueKey('schedule-calendar'),
                    value: _day,
                    firstDate: _first,
                    lastDate: _last,
                    currentDate: _data.today,
                    semanticLabel: 'Studio calendar',
                    onChanged: (day) => setState(() => _day = day),
                  ),
                  const {{typePrefix}}Divider(size: .size4),
                  ColumnBox(
                    key: const ValueKey('schedule-day'),
                    style: FlexBoxStyler()
                        .crossAxisAlignment(.stretch)
                        .spacing({{typePrefix}}Tokens.space3()),
                    children: [
                      {{typePrefix}}CardHeader(
                        title: {{valuePrefix}}DashboardDay(_day),
                        description: switch (onDay.length) {
                          0 => 'Nothing scheduled',
                          1 => '1 event',
                          final count => '$count events',
                        },
                      ),
                      for (final event in onDay)
                        {{typePrefix}}EventTile(event, showKind: true),
                    ],
                  ),
                ],
              ),
            ),
            {{typePrefix}}Surface(
              child: ColumnBox(
                style: FlexBoxStyler()
                    .crossAxisAlignment(.stretch)
                    .spacing({{typePrefix}}Tokens.space3()),
                children: [
                  // The picker is wide, so it drops under the title when the
                  // card cannot hold both.
                  WrapBox(
                    style: WrapBoxStyler()
                        .wrapAlignment(.spaceBetween)
                        .crossAxisAlignment(.center)
                        .spacing({{typePrefix}}Tokens.space3())
                        .runSpacing({{typePrefix}}Tokens.space3()),
                    children: [
                      {{typePrefix}}CardTitle(
                        title: 'Agenda',
                        description: switch (inRange.length) {
                          1 => '1 event in range',
                          final count => '$count events in range',
                        },
                      ),
                      {{typePrefix}}DateRangePicker(
                        key: const ValueKey('schedule-range'),
                        value: _range,
                        firstDate: _first,
                        lastDate: _last,
                        currentDate: _data.today,
                        semanticLabel: 'Agenda range',
                        formatRange: (range) =>
                            '${{{valuePrefix}}DashboardMonth(range.start)} '
                            '${range.start.day} – '
                            '${{{valuePrefix}}DashboardMonth(range.end)} '
                            '${range.end.day}',
                        onChanged: (range) => setState(() => _range = range),
                      ),
                    ],
                  ),
                  if (inRange.isEmpty)
                    const {{typePrefix}}EmptyState(
                      icon: {{icon:calendar}},
                      title: 'Nothing in this range',
                      body: 'Widen the range or add an event.',
                    )
                  else
                    for (final (index, event) in inRange.indexed) ...[
                      if (index > 0) const {{typePrefix}}Divider(size: .size4),
                      {{typePrefix}}EventTile(event, showKind: true),
                    ],
                ],
              ),
            ),
          ],
        ),
      ],
    );
  }

  Future<void> _addEvent() async {
    final event = await showRemixDialog<{{typePrefix}}DashboardEvent>(
      context: context,
      barrierLabel: 'Dismiss',
      builder: (context) =>
          _NewEventDialog(initial: _day, first: _first, last: _last),
    );
    if (!mounted || event == null) return;
    setState(() {
      _added.add(event);
      _day = event.date;
    });
    showRemixToast(
      context,
      RemixToastData(
        title: '${event.title} added to ${{{valuePrefix}}DashboardDay(event.date)}',
        icon: {{icon:checkCircled}},
      ),
    );
  }
}

bool _sameDay(DateTime a, DateTime b) =>
    a.year == b.year && a.month == b.month && a.day == b.day;

class _NewEventDialog extends StatefulWidget {
  const _NewEventDialog({
    required this.initial,
    required this.first,
    required this.last,
  });

  final DateTime initial;
  final DateTime first;
  final DateTime last;

  @override
  State<_NewEventDialog> createState() => _NewEventDialogState();
}

class _NewEventDialogState extends State<_NewEventDialog> {
  final _title = TextEditingController();
  late DateTime _date = widget.initial;
  bool _submitted = false;

  @override
  void dispose() {
    _title.dispose();
    super.dispose();
  }

  void _submit() {
    final title = _title.text.trim();
    if (title.isEmpty) {
      setState(() => _submitted = true);
      return;
    }
    Navigator.of(context).pop(
      {{typePrefix}}DashboardEvent(
        title: title,
        date: _date,
        time: 'All day',
        kind: .studio,
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final missing = _submitted && _title.text.trim().isEmpty;
    return {{typePrefix}}Dialog(
      key: const ValueKey('schedule-dialog'),
      title: 'New event',
      description: 'Add something to the studio calendar.',
      actions: [
        {{typePrefix}}Button.soft(
          label: 'Cancel',
          onPressed: () => Navigator.of(context).pop(),
        ),
        {{typePrefix}}Button(
          key: const ValueKey('schedule-dialog-add'),
          label: 'Add event',
          onPressed: _submit,
        ),
      ],
      child: ColumnBox(
        style: FlexBoxStyler()
            .mainAxisSize(.min)
            .crossAxisAlignment(.stretch)
            .spacing({{typePrefix}}Tokens.space4()),
        children: [
          {{typePrefix}}TextField(
            key: const ValueKey('schedule-dialog-title'),
            controller: _title,
            label: 'Title',
            hintText: 'Proof review',
            autofocus: true,
            error: missing,
            helperText: missing ? 'Give the event a title.' : null,
            onChanged: (_) {
              if (_submitted) setState(() {});
            },
            onSubmitted: (_) => _submit(),
          ),
          ColumnBox(
            style: FlexBoxStyler()
                .crossAxisAlignment(.start)
                .spacing({{typePrefix}}Tokens.space2()),
            children: [
              // The picker below carries the accessible name.
              const ExcludeSemantics(
                child: {{typePrefix}}Text('Date', size: .size2, weight: .medium),
              ),
              {{typePrefix}}DatePicker(
                key: const ValueKey('schedule-dialog-date'),
                value: _date,
                firstDate: widget.first,
                lastDate: widget.last,
                semanticLabel: 'Event date',
                formatDate: {{valuePrefix}}DashboardShortDate,
                onChanged: (date) => setState(() => _date = date),
              ),
            ],
          ),
          StyledText(
            'It is added for this session only.',
            style: dashboardText(.size1, tone: .muted),
          ),
        ],
      ),
    );
  }
}
