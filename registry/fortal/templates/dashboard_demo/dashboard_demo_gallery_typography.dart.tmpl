import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
import 'package:remix_ui_icons/remix_ui_icons.dart';

import 'dashboard_demo_gallery_scaffold.dart';
import 'dashboard_demo_text.dart';
import 'dashboard_demo_ui.dart';

/// The five {{typePrefix}} typography families on one page.
///
/// Everything here is a `{{typePrefix}}*` widget: the dashboard's own `dashboardText`
/// helper exists only to add a neutral tone, and none of these samples want
/// one.
class GalleryTypographyPage extends StatelessWidget {
  const GalleryTypographyPage({super.key});

  @override
  Widget build(BuildContext context) {
    return GalleryPage(
      title: 'Typography',
      intro: 'Text, headings, code, keys, and links on one shared scale.',
      sections: [
        GallerySection(
          label: 'Text scale',
          description:
              'The nine-step Radix scale, from 12 to 60 logical pixels.',
          child: Column(
            crossAxisAlignment: .start,
            spacing: 6,
            children: [
              for (final size in {{typePrefix}}TextSize.values)
                Row(
                  crossAxisAlignment: .baseline,
                  textBaseline: TextBaseline.alphabetic,
                  spacing: 14,
                  children: [
                    SizedBox(
                      width: 64,
                      child: {{typePrefix}}Code.ghost(enumLabel(size), size: .size1),
                    ),
                    Flexible(
                      child: {{typePrefix}}Text(
                        'The quick brown fox',
                        size: size,
                        truncate: true,
                      ),
                    ),
                  ],
                ),
            ],
          ),
        ),
        GallerySection(
          label: 'Weights',
          description:
              'Text, heading, code, and link share all four weight presets.',
          child: GalleryEnumMatrix(
            rows: _TypographyFamily.values,
            columns: {{typePrefix}}TextWeight.values,
            cellWidth: 130,
            cellBuilder: (context, family, weight) {
              return switch (family) {
                .text => {{typePrefix}}Text('Aa', size: .size4, weight: weight),
                .heading => {{typePrefix}}Heading(
                  'Aa',
                  headingLevel: 3,
                  size: .size4,
                  weight: weight,
                ),
                .code => {{typePrefix}}Code.soft('Aa', size: .size4, weight: weight),
                .link => {{typePrefix}}Link(
                  'Aa',
                  size: .size4,
                  weight: weight,
                  onPressed: () => showRemixToast(
                    context,
                    const RemixToastData(
                      title: 'Link activated',
                      icon: RemixIcons.checkCircled,
                    ),
                  ),
                ),
              };
            },
          ),
        ),
        GallerySection(
          label: 'Heading level and size',
          description:
              'The accessibility level is independent of the visual size, '
              'exactly as Radix separates its element from its size.',
          child: Column(
            crossAxisAlignment: .start,
            spacing: 8,
            children: [
              for (final (level, size) in const [
                (1, {{typePrefix}}TextSize.size6),
                (2, {{typePrefix}}TextSize.size4),
                (3, {{typePrefix}}TextSize.size3),
              ])
                {{typePrefix}}Heading(
                  'Level $level heading at size ${size.name.substring(4)}',
                  headingLevel: level,
                  size: size,
                  weight: level == 1 ? .bold : .medium,
                ),
            ],
          ),
        ),
        GallerySection(
          label: 'Code',
          description: 'Solid, soft, outline, and ghost inline code.',
          child: GalleryMatrix<{{typePrefix}}CodeVariant, bool>(
            rows: {{typePrefix}}CodeVariant.values,
            columns: const [false, true],
            rowLabelBuilder: enumLabel,
            columnLabelBuilder: (highContrast) =>
                highContrast ? 'High contrast' : 'Default',
            cellWidth: 170,
            cellBuilder: (_, variant, highContrast) => {{typePrefix}}Code(
              'const x = 1;',
              variant: variant,
              size: .size2,
              accent: true,
              highContrast: highContrast,
            ),
          ),
        ),
        GallerySection(
          label: 'Keyboard keys',
          description:
              'Classic key caps and the flat soft variant at all nine sizes.',
          child: GalleryEnumMatrix(
            rows: {{typePrefix}}KbdVariant.values,
            columns: {{typePrefix}}TextSize.values,
            cellWidth: 130,
            cellBuilder: (_, variant, size) => {{typePrefix}}Kbd(
              '⌘K',
              variant: variant,
              size: size,
              semanticLabel: 'Command K',
            ),
          ),
        ),
        GallerySection(
          label: 'Links',
          description:
              'Only a link with a callback becomes focusable and underlined; '
              'an inert link is styled text.',
          child: Wrap(
            spacing: 20,
            runSpacing: 14,
            crossAxisAlignment: WrapCrossAlignment.center,
            children: [
              for (final underline in {{typePrefix}}LinkUnderline.values)
                {{typePrefix}}Link(
                  enumLabel(underline),
                  underline: underline,
                  onPressed: () => showRemixToast(
                    context,
                    RemixToastData(
                      title: '${enumLabel(underline)} link activated',
                      icon: RemixIcons.checkCircled,
                    ),
                  ),
                ),
              {{typePrefix}}Link(
                'High contrast',
                highContrast: true,
                onPressed: () => showRemixToast(
                  context,
                  const RemixToastData(
                    title: 'High contrast activated',
                    icon: RemixIcons.checkCircled,
                  ),
                ),
              ),
              // Two spellings of the same state: a null callback disables the
              // link exactly as `enabled: false` does.
              {{typePrefix}}Link('Disabled', enabled: false, onPressed: () {}),
              const {{typePrefix}}Link('Disabled (no callback)'),
              {{typePrefix}}Link(
                'Documentation',
                linkUrl: Uri.parse('https://docs.page/btwld/remix/{{valuePrefix}}'),
                semanticHint: 'Opens the {{typePrefix}} documentation',
                onPressed: () => showRemixToast(
                  context,
                  const RemixToastData(
                    title: 'Navigation is the caller\'s',
                    icon: RemixIcons.checkCircled,
                  ),
                ),
              ),
            ],
          ),
        ),
        const GallerySection(
          label: 'Accent and high contrast',
          description:
              'Accent text takes accent-a11; high contrast promotes it to '
              'accent-12. Setting high contrast alone does nothing.',
          child: Wrap(
            spacing: 20,
            runSpacing: 12,
            crossAxisAlignment: WrapCrossAlignment.center,
            children: [
              {{typePrefix}}Text('Neutral', size: .size3),
              {{typePrefix}}Text(
                'High contrast alone',
                size: .size3,
                highContrast: true,
              ),
              {{typePrefix}}Text('Accent', size: .size3, accent: true),
              {{typePrefix}}Text(
                'Accent high contrast',
                size: .size3,
                accent: true,
                highContrast: true,
              ),
              {{typePrefix}}Heading(
                'Accent heading',
                headingLevel: 3,
                size: .size3,
                weight: .medium,
                accent: true,
              ),
            ],
          ),
        ),
        const GallerySection(
          label: 'Wrapping and truncation',
          description:
              'Truncate deliberately wins over softWrap and holds one '
              'ellipsized line.',
          // Both samples are pinned to the same narrow box: at full page width
          // the sentence fits on one line and the two settings look identical.
          child: Wrap(
            spacing: 32,
            runSpacing: 16,
            children: [
              SizedBox(
                width: 260,
                child: {{typePrefix}}Text(
                  'Wrap keeps the complete sentence, across as many lines as '
                  'it needs.',
                  size: .size2,
                ),
              ),
              SizedBox(
                width: 260,
                child: {{typePrefix}}Text(
                  'Truncate keeps exactly one line, across as many lines as '
                  'it needs.',
                  size: .size2,
                  truncate: true,
                ),
              ),
            ],
          ),
        ),
      ],
    );
  }
}

enum _TypographyFamily { text, heading, code, link }
