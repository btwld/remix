/// The icon of an activity, tinted by its kind.
class {{typePrefix}}ActivityIcon extends StatelessWidget {
  const {{typePrefix}}ActivityIcon({super.key, required this.kind});

  /// The event's category.
  final {{typePrefix}}DashboardActivityKind kind;

  @override
  Widget build(BuildContext context) {
    final (icon, accent) = switch (kind) {
      .customer => ({{icon:person}}, {{typePrefix}}AccentColor.ceu),
      .order => ({{icon:box}}, {{typePrefix}}AccentColor.duna),
      .payment => ({{icon:checkCircled}}, {{typePrefix}}AccentColor.mar),
      .alert => ({{icon:exclamationTriangle}}, {{typePrefix}}AccentColor.sol),
      .release => ({{icon:calendar}}, {{typePrefix}}AccentColor.caju),
    };

    return {{typePrefix}}AccentScope(
      accent: accent,
      child: {{typePrefix}}Avatar.soft(icon: icon, size: .size2),
    );
  }
}

