/// The gap between cards, on every page.
const {{valuePrefix}}DashboardGap = 16.0;

/// Two cards, the first twice as wide. One column under 900 wide.
final {{valuePrefix}}LeadGrid = GridBoxStyler.columns(const [.fr(2), .fr(1)])
    .gap({{valuePrefix}}DashboardGap)
    .onConstraints(
      const .maxWidth(899),
      .equalColumns(1).gap({{valuePrefix}}DashboardGap),
    );

/// Three equal cards. One column under 900 wide.
final {{valuePrefix}}ThirdsGrid = GridBoxStyler.equalColumns(3)
    .gap({{valuePrefix}}DashboardGap)
    .onConstraints(
      const .maxWidth(899),
      .equalColumns(1).gap({{valuePrefix}}DashboardGap),
    );

/// Two equal cards. One column under 720 wide.
final {{valuePrefix}}HalvesGrid = GridBoxStyler.equalColumns(2)
    .gap({{valuePrefix}}DashboardGap)
    .onConstraints(
      const .maxWidth(719),
      .equalColumns(1).gap({{valuePrefix}}DashboardGap),
    );

/// Four equal cards, two under 1000 wide and one under 520.
final {{valuePrefix}}MetricsGrid = GridBoxStyler.equalColumns(4)
    .gap({{valuePrefix}}DashboardGap)
    .onConstraints(
      const .maxWidth(999),
      .equalColumns(2).gap({{valuePrefix}}DashboardGap),
    )
    .onConstraints(
      const .maxWidth(519),
      .equalColumns(1).gap({{valuePrefix}}DashboardGap),
    );

/// The Overview page: what the studio leads with, then the detail.
///
/// The page is a bento. Revenue takes the one inverse surface and the widest
/// cell; the featured edition beside it is a full-bleed cover; four metrics
/// follow at ordinary weight; goals sit on an accent wash; the calendar, the
/// team and the palettes recede on quiet surfaces.
class {{typePrefix}}DashboardOverview extends StatefulWidget {
  const {{typePrefix}}DashboardOverview({
    super.key,
    this.data,
    this.scrollController,
    this.onViewOrders,
    this.onViewCollection,
    this.onViewSchedule,
    this.onViewThemes,
  });

  /// The records the overview summarizes. Defaults to
  /// [{{valuePrefix}}DashboardSampleData].
  final {{typePrefix}}DashboardData? data;

  /// Controls the page's scroll position.
  final ScrollController? scrollController;

  /// Called when the user asks to see all orders.
  final VoidCallback? onViewOrders;

  /// Called when the user asks to see the collection.
  final VoidCallback? onViewCollection;

  /// Called when the user asks to see the schedule.
  final VoidCallback? onViewSchedule;

  /// Called when the user asks to see the themes.
  final VoidCallback? onViewThemes;

  @override
  State<{{typePrefix}}DashboardOverview> createState() =>
      _{{typePrefix}}DashboardOverviewState();
}

class _{{typePrefix}}DashboardOverviewState extends State<{{typePrefix}}DashboardOverview> {
  Timer? _refresh;

  @override
  void dispose() {
    _refresh?.cancel();
    super.dispose();
  }

  /// Stands in for a fetch: the metrics show their loading state, then
  /// return.
  void _startRefresh() {
    _refresh?.cancel();
    setState(() {
      _refresh = Timer(const Duration(milliseconds: 900), () {
        if (!mounted) return;
        setState(() => _refresh = null);
        {{valuePrefix}}DashboardToast(context, 'Overview is up to date');
      });
    });
  }

  @override
  Widget build(BuildContext context) {
    final data = widget.data ?? {{valuePrefix}}DashboardSampleData;
    final refreshing = _refresh != null;
    return {{typePrefix}}Page(
      key: const ValueKey('dashboard-overview'),
      scrollController: widget.scrollController,
      title: 'Overview',
      description: 'How the studio is doing, as of a moment ago.',
      actions: [
        {{typePrefix}}Tooltip(
          tooltipChild: const StyledText('Refresh'),
          child: {{typePrefix}}IconButton.soft(
            key: const ValueKey('overview-refresh'),
            icon: {{icon:reload}},
            semanticLabel: 'Refresh overview',
            loading: refreshing,
            onPressed: _startRefresh,
          ),
        ),
        {{typePrefix}}Button.soft(
          label: 'Export',
          leadingIcon: {{icon:download}},
          onPressed: () =>
              {{valuePrefix}}DashboardToast(context, 'Overview export prepared'),
        ),
        {{typePrefix}}Button(
          label: 'New order',
          leadingIcon: {{icon:plus}},
          onPressed: () => {{valuePrefix}}DashboardToast(context, 'Draft order started'),
        ),
      ],
      children: [
        GridBox(
          key: const ValueKey('overview-lead'),
          style: {{valuePrefix}}LeadGrid,
          children: [
            {{typePrefix}}RevenueCard(data: data),
            if (data.editions.isNotEmpty)
              {{typePrefix}}FeaturedEditionCard(
                edition: data.editions.first,
                onPressed: widget.onViewCollection,
              ),
          ],
        ),
        GridBox(
          key: const ValueKey('dashboard-metrics'),
          style: {{valuePrefix}}MetricsGrid,
          children: [
            for (final metric in data.metrics)
              {{typePrefix}}Skeleton(
                loading: refreshing,
                child: {{typePrefix}}StatCard(metric: metric),
              ),
          ],
        ),
        GridBox(
          key: const ValueKey('overview-breakdown'),
          style: {{valuePrefix}}ThirdsGrid,
          children: [
            {{typePrefix}}ChannelsCard(
              channels: data.channels,
              total: data.revenueTotal(.week),
            ),
            {{typePrefix}}TopEditionsCard(
              editions: data.editions,
              onViewAll: widget.onViewCollection,
            ),
            {{typePrefix}}GoalsCard(goals: data.goals),
          ],
        ),
        GridBox(
          key: const ValueKey('overview-records'),
          style: {{valuePrefix}}LeadGrid,
          children: [
            {{typePrefix}}RecentOrdersCard(
              orders: data.orders,
              onViewAll: widget.onViewOrders,
            ),
            {{typePrefix}}ActivityCard(activities: data.activities),
          ],
        ),
        GridBox(
          key: const ValueKey('overview-studio'),
          style: {{valuePrefix}}ThirdsGrid,
          children: [
            {{typePrefix}}UpcomingCard(
              events: data.upcoming,
              onViewAll: widget.onViewSchedule,
            ),
            {{typePrefix}}TeamCard(team: data.team),
            {{typePrefix}}PalettesCard(onViewAll: widget.onViewThemes),
          ],
        ),
      ],
    );
  }
}

