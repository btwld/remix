/// The seven {{typePrefix}} palettes, one button each, on a quiet surface. Picking
/// one restyles the whole dashboard.
///
/// The buttons need a [{{typePrefix}}DashboardThemeScope] above them to apply a
/// palette; without one they are disabled.
class {{typePrefix}}PalettesCard extends StatelessWidget {
  const {{typePrefix}}PalettesCard({super.key, this.onViewAll});

  /// Called when the user asks to see the themes.
  final VoidCallback? onViewAll;

  @override
  Widget build(BuildContext context) {
    final scope = {{typePrefix}}DashboardThemeScope.maybeOf(context);
    final active =
        scope?.settings.accentColor ?? {{typePrefix}}Theme.of(context).accent;
    return {{typePrefix}}Surface(
      key: const ValueKey('overview-palettes'),
      emphasis: .quiet,
      child: ColumnBox(
        style: FlexBoxStyler()
            .crossAxisAlignment(.stretch)
            .spacing({{typePrefix}}Tokens.space3()),
        children: [
          {{typePrefix}}CardHeader(
            title: 'Palettes',
            description: 'Seven themes, one tap each',
            trailing: {{typePrefix}}Button.ghost(
              key: const ValueKey('overview-view-themes'),
              size: .size1,
              label: 'Themes',
              onPressed: onViewAll,
            ),
          ),
          WrapBox(
            style: WrapBoxStyler()
                .spacing({{typePrefix}}Tokens.space2())
                .runSpacing({{typePrefix}}Tokens.space2()),
            children: [
              for (final accent in {{typePrefix}}AccentColor.values)
                {{typePrefix}}AccentScope(
                  accent: accent,
                  child: {{typePrefix}}Button(
                    key: ValueKey('overview-palette-${accent.name}'),
                    variant: accent == active ? .solid : .soft,
                    size: .size1,
                    label: enumLabel(accent),
                    semanticLabel:
                        '${enumLabel(accent)} palette'
                        '${accent == active ? ', in use' : ''}',
                    onPressed: scope == null
                        ? null
                        : () => scope.onChanged(
                            scope.settings.copyWith(accentColor: accent),
                          ),
                  ),
                ),
            ],
          ),
          StyledText(
            'Each palette pairs an accent with its own neutral, in light and '
            'dark.',
            style: dashboardText(.size1, tone: .muted),
          ),
        ],
      ),
    );
  }
}

/// Who is on the team and who is around, on a quiet surface.
class {{typePrefix}}TeamCard extends StatelessWidget {
  const {{typePrefix}}TeamCard({super.key, required this.team});

  /// The team, in display order.
  final List<{{typePrefix}}DashboardMember> team;

  @override
  Widget build(BuildContext context) {
    final online = team.where((member) => member.online).length;
    return {{typePrefix}}Surface(
      emphasis: .quiet,
      child: ColumnBox(
        style: FlexBoxStyler()
            .crossAxisAlignment(.stretch)
            .spacing({{typePrefix}}Tokens.space3()),
        children: [
          {{typePrefix}}CardHeader(
            title: 'Team',
            description: '$online of ${team.length} online now',
            trailing: {{typePrefix}}AvatarStack(members: team),
          ),
          for (final member in team.take(3))
            RowBox(
              style: FlexBoxStyler()
                  .crossAxisAlignment(.center)
                  .spacing({{typePrefix}}Tokens.space3()),
              children: [
                {{typePrefix}}AccentScope(
                  accent: member.accent,
                  child: {{typePrefix}}Avatar(
                    label: member.initials,
                    size: .size2,
                    fallbackLength: 2,
                  ),
                ),
                Expanded(
                  child: ColumnBox(
                    style: FlexBoxStyler().crossAxisAlignment(.start),
                    children: [
                      {{typePrefix}}Text(
                        member.name,
                        size: .size2,
                        weight: .medium,
                        truncate: true,
                      ),
                      StyledText(
                        member.role,
                        style: dashboardTextLine(.size1, tone: .muted),
                      ),
                    ],
                  ),
                ),
                if (member.online)
                  const {{typePrefix}}AccentScope(
                    accent: .mar,
                    child: {{typePrefix}}Badge(highContrast: true, label: 'Online'),
                  )
                else
                  const {{typePrefix}}Badge.outline(label: 'Away'),
              ],
            ),
        ],
      ),
    );
  }
}
