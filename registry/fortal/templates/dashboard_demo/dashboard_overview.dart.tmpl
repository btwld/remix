              key: const ValueKey('overview-view-collection'),
              size: .size1,
              label: 'View all',
              onPressed: onViewAll,
            ),
          ),
          for (final edition in ranked.take(count))
            RowBox(
              style: FlexBoxStyler()
                  .crossAxisAlignment(.center)
                  .spacing({{typePrefix}}Tokens.space3()),
              children: [
                {{typePrefix}}EditionThumbnail(edition),
