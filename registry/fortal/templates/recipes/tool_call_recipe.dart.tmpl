        .all(.color({{typePrefix}}Tokens.gray6()).width({{typePrefix}}Tokens.borderWidth1())),
      ),
  cardBody: FlexBoxStyler()
      .spacing({{typePrefix}}Tokens.space3())
      .padding(.all({{typePrefix}}Tokens.space4())),
  cardIcon: BoxStyler()
      .width({{typePrefix}}Tokens.space6())
      .height({{typePrefix}}Tokens.space6())
      .color({{typePrefix}}Tokens.grayA3())
      .borderRadius(.all({{typePrefix}}Tokens.radius4()))
      .alignment(.center),
  cardGlyph: _glyph(color: {{typePrefix}}Tokens.gray12()),
  cardContent: FlexBoxStyler().spacing({{typePrefix}}Tokens.space2()),
  cardTitleRow: FlexBoxStyler()
      .spacing({{typePrefix}}Tokens.space2())
      .crossAxisAlignment(.center),
  title: TextStyler()
      .style({{typePrefix}}Tokens.text2.mix())
      .fontWeight({{typePrefix}}Tokens.fontWeightSemibold())
      .color({{typePrefix}}Tokens.gray12()),
  description: TextStyler()
      .style({{typePrefix}}Tokens.text2.mix())
      .color({{typePrefix}}Tokens.gray11()),
  footer: FlexBoxStyler()
      .spacing({{typePrefix}}Tokens.space2())
      .crossAxisAlignment(.center)
      .padding(
