                ),
            field: BoxStyler().padding(.horizontal({{typePrefix}}Tokens.space1())),
            fieldMaxHeight: _fieldMaxHeight,
            toolbar: FlexBoxStyler()
                .spacing({{typePrefix}}Tokens.space2())
                .crossAxisAlignment(.center)
                .padding(.top({{typePrefix}}Tokens.space3())),
          )
          .onFocused(
            AgentComposerStyler(
              container: BoxStyler().{{valuePrefix}}FocusRing(
                radius: {{typePrefix}}Tokens.radius6(),
              ),
            ),
          )
          .merge(style),
  fieldStyle: {{valuePrefix}}TextAreaStyle(
    size: .size3,
