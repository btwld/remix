import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'slider.g.dart';

/// The sizes a slider comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}SliderSize {
  /// A 6px track with a 13px thumb.
  size1,

  /// An 8px track with a 16px thumb. The default.
  size2,

  /// A 10px track with a 19px thumb.
  size3,
}

/// The looks a slider comes in.
enum {{typePrefix}}SliderVariant {
  /// A gray track and a solid accent range.
  surface,

  /// A gray track and a softer accent range.
  soft,
}

/// The {{typePrefix}} Slider recipe.
///
/// It reads top to bottom: the track and thumb sizes, then the variant's
/// colors, then the dark-mode thumb edge, hover, press and disabled.
///
/// [highContrast] darkens the range with an overlay.
@MixWidget(target: RemixSlider.new)
SliderStyler {{valuePrefix}}SliderStyle({
  {{typePrefix}}SliderVariant variant = .surface,
  {{typePrefix}}SliderSize size = .size2,
  bool highContrast = false,
  SliderStyler style = const SliderStyler.create(),
}) => _base(size)
    .merge(switch (variant) {
      .surface => _surface(highContrast),
      .soft => _soft(highContrast),
    })
    .variant(
      ContextVariant(
        '{{valuePrefix}}SliderDark',
        (context) => {{typePrefix}}Theme.of(context).isDark,
      ),
      SliderStyler().thumb(
        .border(
          .all(.color({{typePrefix}}Tokens.gray3()).width({{typePrefix}}Tokens.borderWidth2())),
        ),
      ),
    )
    .onHovered(
      SliderStyler().thumbEffects(
        RemixBoxEffectsMix(
          outline: .color(
            {{typePrefix}}Tokens.accentA7(),
          ).width({{typePrefix}}Tokens.borderWidth2()),
        ),
      ),
    )
    .onPressed(
      SliderStyler()
          .thumbEffects(
            RemixBoxEffectsMix(
              outline: .color(
                {{typePrefix}}Tokens.accentA6(),
              ).width({{typePrefix}}Tokens.space1()),
            ),
          )
          .thumb(
            .border(
              .all(
                .color(
                  {{typePrefix}}Tokens.accent12(),
                ).width({{typePrefix}}Tokens.borderWidth2()),
              ),
            ),
          ),
    )
    .onDisabled(_disabled(variant))
    .wrap(.sizedBox(height: {{typePrefix}}Tokens.space8()))
    .wrap({{valuePrefix}}TouchTarget())
    .merge(style);

/// The track and thumb sizes of each step, and the focus ring.
SliderStyler _base({{typePrefix}}SliderSize size) {
  final (:track, :thumb, :trackRadius) = switch (size) {
    .size1 => (
      track: {{typePrefix}}Tokens.sliderTrackSize1(),
      thumb: {{typePrefix}}Tokens.sliderThumbSize1(),
      trackRadius: {{typePrefix}}Tokens.sliderTrackRadius1(),
    ),
    .size2 => (
      track: {{typePrefix}}Tokens.space2(),
      thumb: {{typePrefix}}Tokens.space4(),
      trackRadius: {{typePrefix}}Tokens.sliderTrackRadius2(),
    ),
    .size3 => (
      track: {{typePrefix}}Tokens.sliderTrackSize3(),
      thumb: {{typePrefix}}Tokens.sliderThumbSize3(),
      trackRadius: {{typePrefix}}Tokens.sliderTrackRadius3(),
    ),
  };
  final radius = BorderRadiusMix.all(trackRadius);

  return SliderStyler()
      .track(.borderRadius(radius))
      .range(.borderRadius(radius))
      .thumb(
        .size(
          thumb,
          thumb,
        ).borderRadius(BorderRadiusMix.all({{typePrefix}}Tokens.radius1OrThumb())),
      )
      .thickness(track)
      .thumbFocusEffects({{valuePrefix}}SliderFocusOutline());
}

SliderStyler _surface(bool highContrast) => SliderStyler()
    .track(.color({{typePrefix}}Tokens.grayA3()))
    .range(.color({{typePrefix}}Tokens.accentTrack()))
    .thumbColor(const Color(0xFFFFFFFF))
    .trackEffects(
      .behindContent({{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.grayA5()])),
    )
    .rangeEffects(
      .behindContent(
        {{valuePrefix}}InsetSurface(
          strokes: [{{typePrefix}}Tokens.grayA5()],
        ).merge(RemixBoxEffectLayerMix(gradients: _overlay(highContrast))),
      ),
    )
    .thumb(_thumbRing());

SliderStyler _soft(bool highContrast) => SliderStyler()
    .track(.color({{typePrefix}}Tokens.grayA4()))
    .range(.color({{typePrefix}}Tokens.accent6()))
    .thumbColor(const Color(0xFFFFFFFF))
    .trackEffects(
      .behindContent(
        RemixBoxEffectLayerMix(
          gradients: [
            RemixLinearGradientMix(
              colors: [{{typePrefix}}Tokens.whiteA1(), {{typePrefix}}Tokens.whiteA1()],
            ),
          ],
        ),
      ),
    )
    // The range is step 6 alone. Alpha steps reconstruct their tint over the
    // page and can be opaque, so layering accent alpha 5 here would replace
    // step 6 rather than deepen it.
    .rangeEffects(
      .behindContent(RemixBoxEffectLayerMix(gradients: _overlay(highContrast))),
    )
    .thumb(_thumbRing());

/// The white thumb's ring ([{{typePrefix}}Tokens.accentThumbRing]): the range color
/// where white stands out on it and it keeps 3:1 on the page and panels, the
/// neutral control border where it does not, and a dark ink on bright ranges.
/// The thumb overhangs the track, so the ring and white face carry it.
BoxStyler _thumbRing() => BoxStyler().decoration(
  .border(
    .all(
      .color({{typePrefix}}Tokens.accentThumbRing()).width({{typePrefix}}Tokens.borderWidth2()),
    ),
  ),
);

/// The overlay that darkens the range under [highContrast], and nothing
/// otherwise.
List<RemixLinearGradientMix> _overlay(bool highContrast) => highContrast
    ? [
        RemixLinearGradientMix(
          colors: [
            {{typePrefix}}Tokens.sliderHighContrastOverlay(),
            {{typePrefix}}Tokens.sliderHighContrastOverlay(),
          ],
        ),
      ]
    : const [];

/// Gray track, range and thumb, with no ring and no overlay, whatever the
/// variant's colors were.
SliderStyler _disabled({{typePrefix}}SliderVariant variant) {
  final track = switch (variant) {
    .surface =>
      SliderStyler()
          .track(.color({{typePrefix}}Tokens.grayA3()))
          .trackEffects(
            .behindContent(
              {{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.grayA4()]),
            ),
          ),
    .soft =>
      SliderStyler()
          .track(.color({{typePrefix}}Tokens.grayA4()))
          .trackEffects(
            .behindContent(RemixBoxEffectLayerMix(gradients: const [])),
          ),
  };

  return track
      .track(.color({{typePrefix}}Tokens.gray5()))
      .range(.color({{typePrefix}}Tokens.gray8()))
      .thumbColor(_disabledThumbFill())
      .thumbEffects(.outline(.style(.none)))
      .rangeEffects(
        .behindContent(
          RemixBoxEffectLayerMix(gradients: const [], shadows: const []),
        ),
      )
      .rangeEffects(
        .overContent(
          RemixBoxEffectLayerMix(gradients: const [], shadows: const []),
        ),
      )
      .thumb(
        BoxStyler().decoration(
          .border(
            .all(
              .color({{typePrefix}}Tokens.gray9()).width({{typePrefix}}Tokens.borderWidth1()),
            ),
          ),
        ),
      )
      .thumbFocusEffects(.outline(.style(.none)))
      .blendMode(BlendMode.srcOver);
}

// Resolved inside the disabled fragment, whose priority is higher than dark
// mode.
final _disabledThumbFill = ContextToken<Color>(
  (context) =>
      ({{typePrefix}}Theme.of(context).isDark ? {{typePrefix}}Tokens.gray9 : {{typePrefix}}Tokens.gray4)
          .resolve(context),
);
