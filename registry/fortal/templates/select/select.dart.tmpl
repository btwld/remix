import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'select.g.dart';

/// The sizes a select comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}SelectSize {
  /// A 24px trigger with 12px text.
  size1,

  /// A 32px trigger with 14px text. The default.
  size2,

  /// A 40px trigger with 16px text.
  size3,
}

/// The looks a select's trigger comes in.
enum {{typePrefix}}SelectVariant {
  /// A near-white fill inside a 1px gray frame.
  surface,

  /// An accent tint under accent text.
  soft,

  /// No fill until hovered. It sits in a negative margin, so its text lines up
  /// with the text around it.
  ghost,
}

/// The {{typePrefix}} Select recipe: the trigger, the floating panel and its items.
///
/// Content icons use size-matched 12/16/20 token defaults rather than the
/// ambient icon size. Override the trigger icon through [style] when needed.
///
/// The panel is at least as wide as its trigger. A [style] that gives the
/// content a `maxWidth` below the trigger's width must also set `minWidth`,
/// which replaces the minimum, because a minimum above a maximum is invalid.
///
/// [highContrast] moves the highlighted item of the surface and ghost variants
/// to accent step 12.
@MixWidget(target: RemixSelect.new)
SelectStyler {{valuePrefix}}SelectStyle({
  {{typePrefix}}SelectVariant variant = .surface,
  {{typePrefix}}SelectSize size = .size2,
  bool highContrast = false,
  SelectStyler style = const SelectStyler.create(),
}) => SelectStyler()
    .trigger(_trigger(variant, size))
    .content(_content(size))
    .item(_item(variant, size, highContrast: highContrast))
    .merge(style);

/// The {{typePrefix}} select item recipe, for styling one item on its own.
///
/// It is the item style [{{valuePrefix}}SelectStyle] gives every item, so a call site
/// can match a select's items outside the select.
SelectMenuItemStyler {{valuePrefix}}SelectMenuItemStyle({
  {{typePrefix}}SelectVariant variant = .surface,
  {{typePrefix}}SelectSize size = .size2,
  bool highContrast = false,
}) => _item(variant, size, highContrast: highContrast);

/// The trigger: its shape and text, then the variant's colors.
SelectTriggerStyler _trigger(
  {{typePrefix}}SelectVariant variant,
  {{typePrefix}}SelectSize size,
) => _triggerBase(size)
    .merge(_triggerScale(variant, size))
    .wrap({{valuePrefix}}TouchTarget())
    .merge(switch (variant) {
      .surface => _surfaceTrigger(),
      .soft => _tintedTrigger(
        color: {{typePrefix}}Tokens.accentA3(),
        hover: {{typePrefix}}Tokens.accentA4(),
        disabled: {{typePrefix}}Tokens.grayA3(),
      ),
      .ghost => _tintedTrigger(
        color: const Color(0x00000000),
        hover: {{typePrefix}}Tokens.accentA3(),
        disabled: const Color(0x00000000),
      ),
    })
    .onDisabled(.containerEffects(.outline(.style(.none))));

/// The trigger's label, placeholder, icons and focus ring, in gray 12.
SelectTriggerStyler _triggerBase({{typePrefix}}SelectSize size) {
  final (:text, :icon, :indicator, :radius) = switch (size) {
    .size1 => (
      text: {{typePrefix}}Tokens.text1,
      icon: {{typePrefix}}Tokens.space3(),
      indicator: {{typePrefix}}Tokens.selectTriggerIndicatorSize12(),
      radius: {{typePrefix}}Tokens.radius1OrFull(),
    ),
    .size2 => (
      text: {{typePrefix}}Tokens.text2,
      icon: {{typePrefix}}Tokens.space4(),
      indicator: {{typePrefix}}Tokens.selectTriggerIndicatorSize12(),
      radius: {{typePrefix}}Tokens.radius2OrFull(),
    ),
    .size3 => (
      text: {{typePrefix}}Tokens.text3,
      icon: {{typePrefix}}Tokens.spinnerSize3(),
      indicator: {{typePrefix}}Tokens.selectTriggerIndicatorSize3(),
      radius: {{typePrefix}}Tokens.radius3OrFull(),
    ),
  };
  TextStyler regular(Color color) => TextStyler(
    style: text.mix(),
  ).fontWeight({{typePrefix}}Tokens.fontWeightRegular()).color(color);

  return SelectTriggerStyler()
      .direction(.horizontal)
      .mainAxisAlignment(.spaceBetween)
      .borderRadius(.all(radius))
      .label(regular({{typePrefix}}Tokens.gray12()))
      .placeholder(regular({{typePrefix}}Tokens.grayA10()))
      .icon(.color({{typePrefix}}Tokens.gray12()).size(icon))
      .indicator(.color({{typePrefix}}Tokens.gray12()).size(indicator))
      .onFocusVisible(.containerEffects({{valuePrefix}}FocusOutline()));
}

/// The gap, padding and height of the trigger. A ghost trigger has no height;
/// it takes its padding and cancels it with a negative margin.
SelectTriggerStyler _triggerScale(
  {{typePrefix}}SelectVariant variant,
  {{typePrefix}}SelectSize size,
) {
  final trigger = SelectTriggerStyler().spacing(switch (size) {
    .size1 => {{typePrefix}}Tokens.space1(),
    .size2 => {{typePrefix}}Tokens.space2(),
    .size3 => {{typePrefix}}Tokens.space2(),
  });

  return switch (variant) {
    .ghost => switch (size) {
      .size1 || .size2 =>
        trigger
            .padding(.horizontal({{typePrefix}}Tokens.space2()))
            .padding(.vertical({{typePrefix}}Tokens.space1()))
            .margin(.horizontal({{typePrefix}}Tokens.selectGhostMarginX12()))
            .margin(.vertical({{typePrefix}}Tokens.selectGhostMarginY12())),
      .size3 =>
        trigger
            .padding(.horizontal({{typePrefix}}Tokens.space3()))
            .padding(.vertical({{typePrefix}}Tokens.space2()))
            .margin(.horizontal({{typePrefix}}Tokens.selectGhostMarginX3()))
            .margin(.vertical({{typePrefix}}Tokens.selectGhostMarginY3())),
    },
    .surface || .soft => switch (size) {
      .size1 =>
        trigger
            .height({{typePrefix}}Tokens.space5())
            .padding(.horizontal({{typePrefix}}Tokens.space2())),
      .size2 =>
        trigger
            .height({{typePrefix}}Tokens.space6())
            .padding(.horizontal({{typePrefix}}Tokens.space3())),
      .size3 =>
        trigger
            .height({{typePrefix}}Tokens.space7())
            .padding(.horizontal({{typePrefix}}Tokens.space4())),
    },
  };
}

SelectTriggerStyler _surfaceTrigger() => SelectTriggerStyler()
    .indicatorOpacity(0.9)
    .color({{typePrefix}}Tokens.gray2())
    .containerEffects(
      .behindContent({{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.gray7()])),
    )
    .onHovered(
      .containerEffects(
        .behindContent({{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.grayA8()])),
      ),
    )
    .onSelected(
      .containerEffects(
        .behindContent({{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.grayA8()])),
      ),
    )
    .onDisabled(
      .color({{typePrefix}}Tokens.gray2())
          .label(.color({{typePrefix}}Tokens.grayA11()))
          .icon(.color({{typePrefix}}Tokens.grayA9()))
          .indicator(.color({{typePrefix}}Tokens.grayA9()))
          .containerEffects(
            .behindContent(
              {{valuePrefix}}InsetSurface(strokes: [{{typePrefix}}Tokens.grayA6()]).merge(
                RemixBoxEffectLayerMix(
                  gradients: [
                    RemixLinearGradientMix(
                      colors: [{{typePrefix}}Tokens.grayA2(), {{typePrefix}}Tokens.grayA2()],
                    ),
                  ],
                ),
              ),
            ),
          ),
    );

/// Accent text on a [color] fill that takes [hover] while hovered or open.
/// Disabled turns the text gray and the fill [disabled].
SelectTriggerStyler _tintedTrigger({
  required Color color,
  required Color hover,
  required Color disabled,
}) => SelectTriggerStyler()
    .label(.color({{typePrefix}}Tokens.accent12()))
    .placeholder(.color({{typePrefix}}Tokens.accent12()))
    .placeholderOpacity(0.6)
    .icon(.color({{typePrefix}}Tokens.accent12()))
    .indicator(.color({{typePrefix}}Tokens.accent12()))
    .color(color)
    .onHovered(.color(hover))
    .onSelected(.color(hover))
    .onDisabled(
      .label(.color({{typePrefix}}Tokens.grayA11()))
          .icon(.color({{typePrefix}}Tokens.grayA9()))
          .indicator(.color({{typePrefix}}Tokens.grayA9()))
          .color(disabled),
    );

/// The floating panel: a raised, blurred panel at least as wide as the
/// trigger.
SelectContentStyler _content({{typePrefix}}SelectSize size) {
  final (:padding, :radius) = switch (size) {
    .size1 => (padding: {{typePrefix}}Tokens.space1(), radius: {{typePrefix}}Tokens.radius3()),
    .size2 ||
    .size3 => (padding: {{typePrefix}}Tokens.space2(), radius: {{typePrefix}}Tokens.radius4()),
  };

  return SelectContentStyler()
      .maxHeight(320)
      .border(.color({{typePrefix}}Tokens.gray7()).width({{typePrefix}}Tokens.borderWidth1()))
      // The panel is never narrower than its trigger.
      .minWidth(remixAnchorWidth())
      .padding(.all(padding))
      .borderRadius(.all(radius))
      .color({{typePrefix}}Tokens.colorPanel())
      .decoration(
        BoxDecorationMix.create(boxShadow: {{typePrefix}}Tokens.shadow5.mix()),
      )
      .clipBehavior(Clip.antiAlias)
      .containerEffects(.backdropBlur({{typePrefix}}Tokens.panelBlur()));
}

/// An item in the panel: gray text, with the variant's highlight under the
/// pointer, keyboard focus and press.
SelectMenuItemStyler _item(
  {{typePrefix}}SelectVariant variant,
  {{typePrefix}}SelectSize size, {
  required bool highContrast,
}) {
  final (
    :height,
    :indicatorWidth,
    :indicatorSize,
    :radius,
    :text,
  ) = switch (size) {
    .size1 => (
      height: {{typePrefix}}Tokens.space5(),
      indicatorWidth: {{typePrefix}}Tokens.selectIndicatorWidth1(),
      indicatorSize: {{typePrefix}}Tokens.space2(),
      radius: {{typePrefix}}Tokens.radius1(),
      text: {{typePrefix}}Tokens.text1,
    ),
    .size2 => (
      height: {{typePrefix}}Tokens.space6(),
      indicatorWidth: {{typePrefix}}Tokens.space5(),
      indicatorSize: {{typePrefix}}Tokens.selectIndicatorSize2(),
      radius: {{typePrefix}}Tokens.radius2(),
      text: {{typePrefix}}Tokens.text2,
    ),
    .size3 => (
      height: {{typePrefix}}Tokens.space6(),
      indicatorWidth: {{typePrefix}}Tokens.space5(),
      indicatorSize: {{typePrefix}}Tokens.selectIndicatorSize2(),
      radius: {{typePrefix}}Tokens.radius2(),
      text: {{typePrefix}}Tokens.text3,
    ),
  };
  final highlighted = _highlighted(variant, highContrast: highContrast);

  return SelectMenuItemStyler()
      .wrap({{valuePrefix}}TouchTarget())
      .direction(.horizontal)
      .height(height)
      .padding(.horizontal(indicatorWidth))
      .borderRadius(.all(radius))
      .text(TextStyler(style: text.mix()).color({{typePrefix}}Tokens.gray12()))
      .indicator(
        BoxStyler(
          alignment: .center,
          constraints: BoxConstraintsMix.width(indicatorWidth),
        ),
      )
      .icon(IconStyler(color: {{typePrefix}}Tokens.gray12(), size: indicatorSize))
      .onHovered(highlighted)
      .onFocused(highlighted)
      .onPressed(highlighted)
      .onFocusVisible(
        SelectMenuItemStyler().container(
          FlexBoxStyler().{{valuePrefix}}FocusRing(radius: radius),
        ),
      )
      .onDisabled(
        SelectMenuItemStyler()
            .container(
              FlexBoxStyler().wrap({{valuePrefix}}FocusRingModifier(visible: false)),
            )
            .color(const Color(0x00000000))
            .text(.color({{typePrefix}}Tokens.grayA8()))
            .iconColor({{typePrefix}}Tokens.grayA8()),
      );
}

/// The item under the pointer or keyboard: the accent's solid fill under its
/// contrast text, or a tint for the soft variant.
SelectMenuItemStyler _highlighted(
  {{typePrefix}}SelectVariant variant, {
  required bool highContrast,
}) {
  final content = highContrast
      ? {{typePrefix}}Tokens.accent1()
      : {{typePrefix}}Tokens.accentContrast();

  return switch (variant) {
    .surface || .ghost =>
      SelectMenuItemStyler()
          .color(
            highContrast ? {{typePrefix}}Tokens.accent12() : {{typePrefix}}Tokens.accentSolid(),
          )
          .text(.color(content))
          .iconColor(content),
    .soft => SelectMenuItemStyler().color({{typePrefix}}Tokens.accentA4()),
  };
}
