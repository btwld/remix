import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

/// The nine steps of this design system's text scale, from [{{typePrefix}}Tokens].
/// Pixel values are at 100% theme scaling.
enum {{typePrefix}}TextSize {
  /// 12px.
  size1,

  /// 14px.
  size2,

  /// 16px. The default for body text.
  size3,

  /// 18px.
  size4,

  /// 20px.
  size5,

  /// 24px.
  size6,

  /// 28px.
  size7,

  /// 36px.
  size8,

  /// 60px.
  size9,
}

/// The font weights of the text scale.
enum {{typePrefix}}TextWeight {
  /// Light, 300. For large display text.
  light,

  /// Body text.
  regular,

  /// Labels and emphasis.
  medium,

  /// Headings.
  bold,
}

/// The text style token of a [size] on the scale.
TextStyleToken {{valuePrefix}}TextSizeToken({{typePrefix}}TextSize size) => switch (size) {
  .size1 => {{typePrefix}}Tokens.text1,
  .size2 => {{typePrefix}}Tokens.text2,
  .size3 => {{typePrefix}}Tokens.text3,
  .size4 => {{typePrefix}}Tokens.text4,
  .size5 => {{typePrefix}}Tokens.text5,
  .size6 => {{typePrefix}}Tokens.text6,
  .size7 => {{typePrefix}}Tokens.text7,
  .size8 => {{typePrefix}}Tokens.text8,
  .size9 => {{typePrefix}}Tokens.text9,
};

/// The font weight token of a [weight].
FontWeightToken {{valuePrefix}}TextWeightToken({{typePrefix}}TextWeight weight) =>
    switch (weight) {
      .light => {{typePrefix}}Tokens.fontWeightLight,
      .regular => {{typePrefix}}Tokens.fontWeightRegular,
      .medium => {{typePrefix}}Tokens.fontWeightMedium,
      .bold => {{typePrefix}}Tokens.fontWeightBold,
    };

/// [truncate] deliberately wins over [softWrap], forcing one ellipsized line.
TextStyler {{valuePrefix}}ApplyTextFlow(
  TextStyler style, {
  TextAlign? align,
  required bool softWrap,
  required bool truncate,
}) {
  if (align != null) style = style.textAlign(align);
  if (truncate) {
    return style.maxLines(1).softWrap(false).overflow(TextOverflow.ellipsis);
  }

  return style.softWrap(softWrap);
}

/// [style] with the accent's text color, or accent step 12 under
/// [highContrast].
TextStyler {{valuePrefix}}AccentForeground(
  TextStyler style, {
  required bool highContrast,
}) => style.color(
  highContrast ? {{typePrefix}}Tokens.accent12() : {{typePrefix}}Tokens.accentContentAlpha(),
);

/// The text style of [size], resolved against [context].
///
/// Code, Kbd, and Link derive em-relative geometry from the resolved font size,
/// so unlike the other recipes they cannot stay context-free.
TextStyle {{valuePrefix}}ResolveTextToken(BuildContext context, {{typePrefix}}TextSize size) =>
    MixScope.tokenOf({{valuePrefix}}TextSizeToken(size), context);

Color {{valuePrefix}}ResolveColor(BuildContext context, ColorToken token) =>
    MixScope.tokenOf(token, context);

/// The theme's radius factor, read back from the resolved `radius1`.
///
/// Derived from the resolved `radius1` rather than duplicating this design
/// system's radius table, so theme radius and scaling changes flow through.
double {{valuePrefix}}RadiusFactor(BuildContext context) {
  final scaling = {{typePrefix}}Theme.of(context).scaling.factor;
  final radius = MixScope.tokenOf({{typePrefix}}Tokens.radius1, context);

  return radius.x / (3 * scaling);
}
