import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';
import 'text.dart';

part 'app_bar.g.dart';

/// {{typePrefix}}-themed preset for [RemixAppBar].
///
/// The recipe paints the solid panel surface, sets the toolbar row to the
/// `space9` token (64 logical pixels at 100% scaling) including a bottom edge
/// border, insets it by `space4`, and separates the leading button, the
/// title, and the actions by `space3`. The title uses the bold `size4` text
/// step.
///
/// The edge belongs to the row rather than the surface so it sits inside the
/// row height instead of adding a pixel below it. Anything built the same way
/// beside the bar, such as a sidebar's brand row with a `space9` height and
/// the same edge, lines up with it under every {{typePrefix}} scaling setting.
/// Content in the bar's `bottom` slot brings its own edge.
///
/// App bar is a {{typePrefix}} extension, not a Radix Themes parity family.
@MixWidget(target: RemixAppBar.new)
AppBarStyler {{valuePrefix}}AppBarStyle({
  AppBarStyler style = const AppBarStyler.create(),
}) => AppBarStyler(
  container: BoxStyler().color({{typePrefix}}Tokens.colorPanelSolid()),
  toolbar: BoxStyler()
      .padding(.horizontal({{typePrefix}}Tokens.space4()))
      .border(
        .bottom(
          .color({{typePrefix}}Tokens.grayA6()).width({{typePrefix}}Tokens.borderWidth1()),
        ),
      ),
  title: {{valuePrefix}}TextStyle(size: .size4, weight: .bold),
  actions: FlexBoxStyler().spacing({{typePrefix}}Tokens.space3()),
  toolbarHeight: {{typePrefix}}Tokens.space9(),
  spacing: {{typePrefix}}Tokens.space3(),
).merge(style);
