import 'dart:math' as math;

import 'package:flutter/services.dart';
import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
{{icon:import}}

import '../theme/theme.dart';
import 'icon_button.dart';
import 'text_field.dart';

/// The sizes a search field comes in: the text field's. Pixel values are at
/// 100% theme scaling.
enum {{typePrefix}}SearchFieldSize {
  /// 24px tall, with 12px text and a 12px clear glyph.
  size1,

  /// 32px tall, with 14px text and a 12px clear glyph. The default.
  size2,

  /// 40px tall, with 16px text and a 16px clear glyph.
  size3,
}

/// The looks a search field comes in: the text field's.
enum {{typePrefix}}SearchFieldVariant {
  /// The `gray2` fill inside a 1px neutral frame, with neutral text.
  surface,

  /// An accent tint inside a 1px accent ring, with accent-colored text.
  soft,
}

/// A text field for a search: a leading search glyph, and a clear button once
/// there is something to clear.
///
/// The field is a [{{typePrefix}}TextField] of the same [size] and [variant], so the
/// two share their height, frame, focus ring and disabled look. It has no
/// label or helper text: [semanticLabel] names it.
///
/// The clear button shows while the field is enabled, editable and not
/// empty. It sits over the field's end, centered in the last 40px so its
/// whole 40px target is inside the field, and the text area always stops
/// where that target starts. Pressing it clears the text, reports `onChanged('')` and
/// [onCleared], and returns focus to the field. It is its own semantics node
/// and takes no Tab stop: Escape clears from the keyboard, its repeats
/// included. Escape passes on, to close a dialog for example, when there is
/// nothing to clear, and is left to an input method that is composing.
///
/// The field creates its own controller and focus node when none are given.
/// When a caller's controller is withdrawn, the owned one starts from its
/// last value.
class {{typePrefix}}SearchField extends StatefulWidget {
  const {{typePrefix}}SearchField({
    super.key,
    this.variant = .surface,
    this.size = .size2,
    required this.semanticLabel,
    this.controller,
    this.focusNode,
    this.hintText,
    this.enabled = true,
    this.readOnly = false,
    this.autofocus = false,
    this.onChanged,
    this.onSubmitted,
    this.onCleared,
    this.clearSemanticLabel = 'Clear search',
    this.textInputAction = .search,
    this.style = const TextFieldStyler.create(),
  }) : assert(semanticLabel != ''),
       assert(clearSemanticLabel != '');

  /// The `gray2` fill inside a 1px neutral frame, with neutral text.
  const {{typePrefix}}SearchField.surface({
    super.key,
    this.size = .size2,
    required this.semanticLabel,
    this.controller,
    this.focusNode,
    this.hintText,
    this.enabled = true,
    this.readOnly = false,
    this.autofocus = false,
    this.onChanged,
    this.onSubmitted,
    this.onCleared,
    this.clearSemanticLabel = 'Clear search',
    this.textInputAction = .search,
    this.style = const TextFieldStyler.create(),
  }) : variant = {{typePrefix}}SearchFieldVariant.surface,
       assert(semanticLabel != ''),
       assert(clearSemanticLabel != '');

  /// An accent tint inside a 1px accent ring, with accent-colored text.
  const {{typePrefix}}SearchField.soft({
    super.key,
    this.size = .size2,
    required this.semanticLabel,
    this.controller,
    this.focusNode,
    this.hintText,
    this.enabled = true,
    this.readOnly = false,
    this.autofocus = false,
    this.onChanged,
    this.onSubmitted,
    this.onCleared,
    this.clearSemanticLabel = 'Clear search',
    this.textInputAction = .search,
    this.style = const TextFieldStyler.create(),
  }) : variant = {{typePrefix}}SearchFieldVariant.soft,
       assert(semanticLabel != ''),
       assert(clearSemanticLabel != '');

  final {{typePrefix}}SearchFieldVariant variant;
  final {{typePrefix}}SearchFieldSize size;

  /// The field's accessible name.
  final String semanticLabel;

  final TextEditingController? controller;
  final FocusNode? focusNode;
  final String? hintText;
  final bool enabled;
  final bool readOnly;
  final bool autofocus;
  final ValueChanged<String>? onChanged;
  final ValueChanged<String>? onSubmitted;

  /// Called after the clear button or Escape empties the field.
  final VoidCallback? onCleared;

  /// The clear button's accessible name.
  final String clearSemanticLabel;

  final TextInputAction textInputAction;

  /// Merged last into the field's style.
  final TextFieldStyler style;

  @override
  State<{{typePrefix}}SearchField> createState() => _{{typePrefix}}SearchFieldState();
}

class _{{typePrefix}}SearchFieldState extends State<{{typePrefix}}SearchField> {
  TextEditingController? _ownController;
  FocusNode? _ownFocusNode;

  TextEditingController get _controller =>
      widget.controller ?? (_ownController ??= TextEditingController());

  FocusNode get _focusNode =>
      widget.focusNode ?? (_ownFocusNode ??= FocusNode(debugLabel: 'search'));

  late bool _hasText = _controller.text.isNotEmpty;

  bool get _canClear => widget.enabled && !widget.readOnly && _hasText;

  @override
  void initState() {
    super.initState();
    _controller.addListener(_onTextChanged);
  }

  @override
  void didUpdateWidget({{typePrefix}}SearchField oldWidget) {
    super.didUpdateWidget(oldWidget);
    if (widget.controller != oldWidget.controller) {
      final previous = oldWidget.controller ?? _ownController!;
      previous.removeListener(_onTextChanged);
      if (oldWidget.controller == null) {
        _disposeAfterFrame(_ownController);
        _ownController = null;
      } else if (widget.controller == null) {
        // Keep what the caller's controller held instead of emptying the
        // field.
        _ownController = TextEditingController.fromValue(previous.value);
      }
      _controller.addListener(_onTextChanged);
      _hasText = _controller.text.isNotEmpty;
    }
    if (oldWidget.focusNode == null && widget.focusNode != null) {
      _disposeAfterFrame(_ownFocusNode);
      _ownFocusNode = null;
    }
  }

  /// Disposes [notifier] once the field below has let go of it.
  void _disposeAfterFrame(ChangeNotifier? notifier) {
    if (notifier == null) return;
    WidgetsBinding.instance.addPostFrameCallback((_) => notifier.dispose());
  }

  @override
  void dispose() {
    _controller.removeListener(_onTextChanged);
    _ownController?.dispose();
    _ownFocusNode?.dispose();
    super.dispose();
  }

  void _onTextChanged() {
    final hasText = _controller.text.isNotEmpty;
    if (hasText != _hasText) setState(() => _hasText = hasText);
  }

  void _clear() {
    _controller.clear();
    widget.onChanged?.call('');
    widget.onCleared?.call();
    _focusNode.requestFocus();
  }

  /// Whether the Escape press now held down cleared the field.
  bool _escapeCleared = false;

  /// Escape clears when there is something to clear, and otherwise passes
  /// on, to close a dialog for example.
  ///
  /// The repeats and release of a press that cleared are consumed with it:
  /// the field is empty after the first, so holding Escape would otherwise
  /// close the dialog too. While an input method is composing, the key is
  /// left to it alone.
  KeyEventResult _onKeyEvent(FocusNode _, KeyEvent event) {
    if (event.logicalKey != LogicalKeyboardKey.escape) return .ignored;
    if (event is KeyDownEvent) {
      _escapeCleared = false;
    } else if (_escapeCleared) {
      if (event is KeyUpEvent) _escapeCleared = false;
      return .handled;
    }
    final composing = _controller.value.composing;
    if (composing.isValid && !composing.isCollapsed) {
      return .skipRemainingHandlers;
    }
    if (event is! KeyDownEvent || !_canClear) return .ignored;
    _clear();
    _escapeCleared = true;

    return .handled;
  }

  @override
  Widget build(BuildContext context) {
    // The field's own end padding and the spacing before a trailing widget,
    // as the text field sets them for each size.
    final (
      fieldSize,
      buttonSize,
      paddingX,
      spacing,
      glyph,
    ) = switch (widget.size) {
      .size1 => (
        {{typePrefix}}TextFieldSize.size1,
        {{typePrefix}}IconButtonSize.size1,
        {{typePrefix}}Tokens.space2,
        {{typePrefix}}Tokens.space2,
        {{typePrefix}}Tokens.space3,
      ),
      .size2 => (
        {{typePrefix}}TextFieldSize.size2,
        {{typePrefix}}IconButtonSize.size1,
        {{typePrefix}}Tokens.space2,
        {{typePrefix}}Tokens.space2,
        {{typePrefix}}Tokens.space3,
      ),
      .size3 => (
        {{typePrefix}}TextFieldSize.size3,
        {{typePrefix}}IconButtonSize.size2,
        {{typePrefix}}Tokens.space3,
        {{typePrefix}}Tokens.space3,
        {{typePrefix}}Tokens.space4,
      ),
    };
    final target = {{typePrefix}}Tokens.touchTargetMin.resolve(context);
    final inset = paddingX.resolve(context) + spacing.resolve(context);
    // The input stops where the clear button's target starts, so a tap on
    // the text never clears it, and at least one spacing step short of the
    // glyph, as it would beside a trailing icon of that size.
    final reserved = math.max(
      target - inset,
      target / 2 + glyph.resolve(context) / 2 - paddingX.resolve(context),
    );

    return Focus(
      canRequestFocus: false,
      skipTraversal: true,
      onKeyEvent: _onKeyEvent,
      child: Stack(
        fit: .passthrough,
        children: [
          {{typePrefix}}TextField(
            variant: switch (widget.variant) {
              .surface => .surface,
              .soft => .soft,
            },
            size: fieldSize,
            controller: _controller,
            focusNode: _focusNode,
            hintText: widget.hintText,
            semanticLabel: widget.semanticLabel,
            enabled: widget.enabled,
            readOnly: widget.readOnly,
            autofocus: widget.autofocus,
            textInputAction: widget.textInputAction,
            onChanged: widget.onChanged,
            onSubmitted: widget.onSubmitted,
            leading: const StyledIcon(icon: {{icon:magnifyingGlass}}),
            // Always present at the clear button's width, so the text area
            // keeps one width and the field one structure as text comes and
            // goes.
            trailing: SizedBox(width: reserved),
            style: widget.style,
          ),
          if (_canClear)
            PositionedDirectional(
              top: 0,
              bottom: 0,
              end: 0,
              width: target,
              // Its own semantics node. Merged into the node around the
              // field, the button would make that node a button once there
              // is text, and on the web the browser then drops the input
              // focus the field's editor hangs from.
              child: Semantics(
                container: true,
                child: Center(
                  // Inside the field's tap region, so pressing it does not
                  // count as a tap outside the field.
                  child: TextFieldTapRegion(
                    child: ExcludeFocus(
                      child: {{typePrefix}}IconButton.ghost(
                        icon: {{icon:cross2}},
                        semanticLabel: widget.clearSemanticLabel,
                        size: buttonSize,
                        onPressed: _clear,
                        style: _clearStyle(widget.variant),
                      ),
                    ),
                  ),
                ),
              ),
            ),
        ],
      ),
    );
  }
}

/// The clear button takes the field's icon color: gray on a surface field,
/// with a gray tint under the pointer, and the accent on a soft one.
IconButtonStyler _clearStyle({{typePrefix}}SearchFieldVariant variant) =>
    switch (variant) {
      .surface =>
        IconButtonStyler()
            .icon(.color({{typePrefix}}Tokens.gray11()))
            .onHovered(.color({{typePrefix}}Tokens.grayA3()))
            .onPressed(.color({{typePrefix}}Tokens.grayA4())),
      .soft => IconButtonStyler().icon(.color({{typePrefix}}Tokens.accentContent())),
    };
