import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'card.g.dart';

/// The looks a card comes in.
enum {{typePrefix}}CardVariant {
  /// A panel fill inside a 1px gray frame.
  surface,

  /// No fill or frame until hovered. It sits in a negative margin equal to its
  /// padding, so its content lines up with the content around it.
  ghost,
}

/// The sizes a card comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}CardSize {
  /// 12px padding.
  size1,

  /// 16px padding.
  size2,

  /// 24px padding.
  size3,

  /// 32px padding.
  size4,

  /// 48px padding.
  size5,
}

/// The {{typePrefix}} Card recipe: a flat panel. Elevation is reserved for floating
/// layers, never cards.
///
/// It reads top to bottom: the size and focus ring, then the variant's colors
/// for rest, hover, press and selected, then disabled.
@MixWidget(target: RemixCard.new)
CardStyler {{valuePrefix}}CardStyle({
  {{typePrefix}}CardVariant variant = .surface,
  {{typePrefix}}CardSize size = .size1,
  CardStyler style = const CardStyler.create(),
}) => _base(size)
    .merge(switch (variant) {
      .surface => _surface(),
      .ghost => _ghost(size),
    })
    .onDisabled(.containerEffects(.outline(.style(.none))))
    .merge(style);

/// The padding, corner size and clipping of each step, and the focus ring.
CardStyler _base({{typePrefix}}CardSize size) {
  final (:padding, :radius) = switch (size) {
    .size1 => (padding: {{typePrefix}}Tokens.space3(), radius: {{typePrefix}}Tokens.radius4()),
    .size2 => (padding: {{typePrefix}}Tokens.space4(), radius: {{typePrefix}}Tokens.radius4()),
    .size3 => (padding: {{typePrefix}}Tokens.space5(), radius: {{typePrefix}}Tokens.radius5()),
    .size4 => (padding: {{typePrefix}}Tokens.space6(), radius: {{typePrefix}}Tokens.radius5()),
    .size5 => (padding: {{typePrefix}}Tokens.space8(), radius: {{typePrefix}}Tokens.radius6()),
  };

  return CardStyler()
      .padding(.all(padding))
      .borderRadius(.all(radius))
      .clipBehavior(.antiAlias)
      .onFocusVisible(.containerEffects({{valuePrefix}}FocusOutline()));
}

CardStyler _surface() => CardStyler()
    .color({{typePrefix}}Tokens.colorPanel())
    .border(
      .all(.color({{typePrefix}}Tokens.gray6()).width({{typePrefix}}Tokens.borderWidth1())),
    )
    .containerEffects(.backdropBlur({{typePrefix}}Tokens.panelBlur()))
    .onHovered(.border(.all(.color({{typePrefix}}Tokens.gray7()))))
    .onPressed(.color({{typePrefix}}Tokens.gray3()))
    .onSelected(.color({{typePrefix}}Tokens.gray3()));

CardStyler _ghost({{typePrefix}}CardSize size) => CardStyler()
    .margin(.all(_ghostMargin(size)))
    .color(const Color(0x00000000))
    .onHovered(.color({{typePrefix}}Tokens.grayA3()))
    .onPressed(.color({{typePrefix}}Tokens.grayA4()))
    .onSelected(.color({{typePrefix}}Tokens.grayA3()));

/// The negative margin that cancels a ghost card's padding.
double _ghostMargin({{typePrefix}}CardSize size) => switch (size) {
  .size1 => {{typePrefix}}Tokens.cardGhostMargin1(),
  .size2 => {{typePrefix}}Tokens.cardGhostMargin2(),
  .size3 => {{typePrefix}}Tokens.cardGhostMargin3(),
  .size4 => {{typePrefix}}Tokens.cardGhostMargin4(),
  .size5 => {{typePrefix}}Tokens.cardGhostMargin5(),
};
