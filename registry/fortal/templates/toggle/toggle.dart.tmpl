import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'toggle.g.dart';

/// The sizes a toggle comes in. Pixel values are at 100% theme scaling.
enum {{typePrefix}}ToggleSize {
  /// 24px tall, with 12px text.
  size1,

  /// 32px tall, with 14px text. The default.
  size2,

  /// 40px tall, with 16px text.
  size3,
}

/// The looks a toggle comes in.
enum {{typePrefix}}ToggleVariant {
  /// No fill or frame until hovered; an accent tint when on.
  ghost,

  /// A 1px gray frame; an accent tint and frame when on.
  outline,
}

/// The {{typePrefix}} Toggle recipe.
///
/// It reads top to bottom: what every toggle shares, then the size, then the
/// variant's colors for rest, hover, press, on, focus and disabled.
///
/// [highContrast] moves the label and icon of the on state to accent step 12.
@MixWidget(target: RemixToggle.new)
ToggleStyler {{valuePrefix}}ToggleStyle({
  {{typePrefix}}ToggleVariant variant = .ghost,
  {{typePrefix}}ToggleSize size = .size2,
  bool highContrast = false,
  ToggleStyler style = const ToggleStyler.create(),
}) => _base()
    .merge(_scale(size))
    .merge(switch (variant) {
      .ghost => _ghost(highContrast),
      .outline => _outline(highContrast),
    })
    .wrap({{valuePrefix}}TouchTarget())
    .onDisabled(.containerEffects(.outline(.style(.none))))
    .merge(style);

/// What every toggle shares: a medium-weight label and icon in gray 12.
ToggleStyler _base() => ToggleStyler()
    .container(.mainAxisSize(.min))
    .labelColor({{typePrefix}}Tokens.gray12())
    .iconColor({{typePrefix}}Tokens.gray12())
    .labelFontWeight({{typePrefix}}Tokens.fontWeightMedium());

/// The height, padding, corner, text and icon size of each step.
///
/// The heights are the Button height scale, with content centered in it.
ToggleStyler _scale({{typePrefix}}ToggleSize size) => switch (size) {
  .size1 => ToggleStyler(
    container: FlexBoxStyler()
        .padding(.horizontal({{typePrefix}}Tokens.space2()))
        .borderRadius(.all({{typePrefix}}Tokens.radius2()))
        .spacing({{typePrefix}}Tokens.space1()),
    label: .style({{typePrefix}}Tokens.text1.mix()),
    icon: .size({{typePrefix}}Tokens.space3()),
  ).minHeight({{typePrefix}}Tokens.space5()),
  .size2 => ToggleStyler(
    container: FlexBoxStyler()
        .padding(.horizontal({{typePrefix}}Tokens.space3()))
        .borderRadius(.all({{typePrefix}}Tokens.radius2()))
        .spacing({{typePrefix}}Tokens.space1()),
    label: .style({{typePrefix}}Tokens.text2.mix()),
    icon: .size({{typePrefix}}Tokens.space4()),
  ).minHeight({{typePrefix}}Tokens.space6()),
  .size3 => ToggleStyler(
    container: FlexBoxStyler()
        .padding(.horizontal({{typePrefix}}Tokens.space4()))
        .borderRadius(.all({{typePrefix}}Tokens.radius3()))
        .spacing({{typePrefix}}Tokens.space2()),
    label: .style({{typePrefix}}Tokens.text3.mix()),
    icon: .size({{typePrefix}}Tokens.spinnerSize3()),
  ).minHeight({{typePrefix}}Tokens.space7()),
};

ToggleStyler _ghost(bool highContrast) => ToggleStyler()
    .color(const Color(0x00000000))
    .onHovered(.color({{typePrefix}}Tokens.grayA3()))
    .onPressed(.color({{typePrefix}}Tokens.grayA4()))
    .onSelected(
      ToggleStyler()
          .color({{typePrefix}}Tokens.accent3())
          .merge(_onContent(highContrast))
          .onHovered(.color({{typePrefix}}Tokens.accent4()))
          .onPressed(.color({{typePrefix}}Tokens.accent5())),
    )
    .onFocusVisible(.containerEffects({{valuePrefix}}FocusOutline()))
    .onDisabled(_disabled());

ToggleStyler _outline(bool highContrast) => ToggleStyler()
    .color(const Color(0x00000000))
    .border(
      .color({{typePrefix}}Tokens.gray7())
          .width({{typePrefix}}Tokens.borderWidth1())
          .strokeAlign(BorderSide.strokeAlignInside),
    )
    .onHovered(.color({{typePrefix}}Tokens.grayA3()))
    .onPressed(.color({{typePrefix}}Tokens.grayA4()))
    .onSelected(
      ToggleStyler()
          .color({{typePrefix}}Tokens.accentA3())
          .merge(_onContent(highContrast))
          .border(.color({{typePrefix}}Tokens.accentA5()))
          .onHovered(.color({{typePrefix}}Tokens.accentA4()))
          .onPressed(.color({{typePrefix}}Tokens.accentA5())),
    )
    .onFocusVisible(.containerEffects({{valuePrefix}}FocusOutline()))
    .onDisabled(
      _disabled().border(
        .color({{typePrefix}}Tokens.grayA6())
            .width({{typePrefix}}Tokens.borderWidth1())
            .strokeAlign(BorderSide.strokeAlignInside),
      ),
    );

/// The accent label and icon of the on state.
ToggleStyler _onContent(bool highContrast) {
  final color = highContrast
      ? {{typePrefix}}Tokens.accent12()
      : {{typePrefix}}Tokens.accentContent();

  return ToggleStyler().labelColor(color).iconColor(color);
}

/// A gray fill, label and icon.
ToggleStyler _disabled() => ToggleStyler()
    .color({{typePrefix}}Tokens.grayA3())
    .labelColor({{typePrefix}}Tokens.gray8())
    .iconColor({{typePrefix}}Tokens.gray8());
