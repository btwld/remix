import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'switch.g.dart';

/// {{typePrefix}} switch size presets.
enum {{typePrefix}}SwitchSize {
  /// Compact switch.
  size1,

  /// Default switch.
  size2,

  /// Large switch.
  size3,
}

/// {{typePrefix}} switch color variants.
enum {{typePrefix}}SwitchVariant {
  /// Surface treatment with a visible border.
  surface,

  /// Softer accent treatment.
  soft,
}

/// {{typePrefix}}-themed preset for [RemixSwitch].
@MixWidget(target: RemixSwitch.new)
SwitchStyler {{valuePrefix}}SwitchStyle({
  {{typePrefix}}SwitchVariant variant = .surface,
  {{typePrefix}}SwitchSize size = .size2,
  bool highContrast = false,
  SwitchStyler style = const SwitchStyler.create(),
}) {
  return (switch (variant) {
    .surface => _{{valuePrefix}}SwitchSurfaceStyler(size, highContrast: highContrast),
    .soft => _{{valuePrefix}}SwitchSoftStyler(size, highContrast: highContrast),
  }).wrap({{valuePrefix}}TouchTarget()).merge(style);
}

SwitchStyler _{{valuePrefix}}SwitchBaseStyler({{typePrefix}}SwitchSize size) {
  final metrics = _{{valuePrefix}}SwitchMetrics(size);
  return SwitchStyler(
        container: .size(
          metrics.width,
          metrics.height,
        ).padding(.all(1)).borderRadius(.all(metrics.radius)),
        thumb: .size(
          metrics.thumbSize,
          metrics.thumbSize,
        ).borderRadius(.all(metrics.radius)),
        trackEffects: RemixBoxEffectsMix(
          behindContent: _{{valuePrefix}}SwitchLayer(),
          overContent: _{{valuePrefix}}SwitchLayer(),
        ),
      )
      .thumbColor(const Color(0xFFFFFFFF))
      .onFocusVisible(.trackEffects({{valuePrefix}}FocusOutline()));
}

SwitchStyler _{{valuePrefix}}SwitchSurfaceStyler(
  {{typePrefix}}SwitchSize size, {
  required bool highContrast,
}) {
  return _{{valuePrefix}}SwitchBaseStyler(size)
      .trackColor({{typePrefix}}Tokens.grayA3())
      .trackEffects(RemixBoxEffectsMix.behindContent(_{{valuePrefix}}SwitchLayer()))
      .trackEffects(
        RemixBoxEffectsMix.overContent(
          _{{valuePrefix}}SwitchInsetRing({{typePrefix}}Tokens.controlBorder()),
        ),
      )
      .thumb(_{{valuePrefix}}SwitchOffThumbStyler())
      .onSelected(
        SwitchStyler()
            .trackColor(
              highContrast
                  ? {{typePrefix}}Tokens.accent12()
                  : {{typePrefix}}Tokens.accentTrack(),
            )
            .trackEffects(
              RemixBoxEffectsMix.behindContent(_{{valuePrefix}}SwitchLayer()),
            )
            .trackEffects(
              RemixBoxEffectsMix.overContent(
                _{{valuePrefix}}SwitchInsetRing({{typePrefix}}Tokens.grayA5()),
              ),
            )
            .thumb(_{{valuePrefix}}SwitchSelectedThumbStyler(highContrast)),
      )
      .onPressed(
        SwitchStyler()
            .trackColor({{typePrefix}}Tokens.grayA4())
            .onSelected(
              SwitchStyler().trackColor(
                highContrast
                    ? {{typePrefix}}Tokens.accent12()
                    : {{typePrefix}}Tokens.accent10(),
              ),
            )
            .trackEffects(
              RemixBoxEffectsMix.behindContent(_{{valuePrefix}}SwitchLayer()),
            ),
      )
      .onDisabled(_{{valuePrefix}}SwitchDisabledStyler());
}

SwitchStyler _{{valuePrefix}}SwitchSoftStyler(
  {{typePrefix}}SwitchSize size, {
  required bool highContrast,
}) {
  return _{{valuePrefix}}SwitchBaseStyler(size)
      .trackColor({{typePrefix}}Tokens.grayA3())
      .trackEffects(RemixBoxEffectsMix.behindContent(_{{valuePrefix}}SwitchLayer()))
      .trackEffects(
        RemixBoxEffectsMix.overContent(
          _{{valuePrefix}}SwitchInsetRing({{typePrefix}}Tokens.controlBorder()),
        ),
      )
      .thumb(_{{valuePrefix}}SwitchOffThumbStyler())
      .onSelected(
        SwitchStyler()
            .trackColor(
              highContrast ? {{typePrefix}}Tokens.accentA6() : {{typePrefix}}Tokens.accentA4(),
            )
            .trackEffects(
              RemixBoxEffectsMix.behindContent(_{{valuePrefix}}SwitchLayer()),
            )
            .trackEffects(
              RemixBoxEffectsMix.overContent(_{{valuePrefix}}SwitchInsetRing(null)),
            )
            .thumb(_{{valuePrefix}}SwitchSoftSelectedThumbStyler(highContrast)),
      )
      .onPressed(
        SwitchStyler()
            .trackColor({{typePrefix}}Tokens.grayA4())
            .onSelected(
              SwitchStyler().trackColor(
                highContrast
                    ? {{typePrefix}}Tokens.accentA7()
                    : {{typePrefix}}Tokens.accentA5(),
              ),
            )
            .trackEffects(
              RemixBoxEffectsMix.behindContent(_{{valuePrefix}}SwitchLayer()),
            ),
      )
      .onDisabled(_{{valuePrefix}}SwitchDisabledStyler(soft: true));
}

({double width, double height, double thumbSize, Radius radius})
_{{valuePrefix}}SwitchMetrics({{typePrefix}}SwitchSize size) {
  final height = switch (size) {
    .size1 => {{typePrefix}}Tokens.space4(),
    .size2 => {{typePrefix}}Tokens.switchHeight2(),
    .size3 => {{typePrefix}}Tokens.space5(),
  };
  final width = switch (size) {
    .size1 => {{typePrefix}}Tokens.switchWidth1(),
    .size2 => {{typePrefix}}Tokens.switchWidth2(),
    .size3 => {{typePrefix}}Tokens.switchWidth3(),
  };
  final thumbSize = switch (size) {
    .size1 => {{typePrefix}}Tokens.switchThumbSize1(),
    .size2 => {{typePrefix}}Tokens.switchThumbSize2(),
    .size3 => {{typePrefix}}Tokens.switchThumbSize3(),
  };
  final radius = switch (size) {
    .size1 => {{typePrefix}}Tokens.radius1OrThumb(),
    .size2 || .size3 => {{typePrefix}}Tokens.radius2OrThumb(),
  };
  return (width: width, height: height, thumbSize: thumbSize, radius: radius);
}

/// Disabled switches stay muted: the active off-track boundary is replaced by
/// the quiet gray-alpha-5 edge (surface) or removed (soft), whatever the
/// selection, focus or press state.
SwitchStyler _{{valuePrefix}}SwitchDisabledStyler({bool soft = false}) => SwitchStyler()
    .trackColor(soft ? {{typePrefix}}Tokens.grayA4() : {{typePrefix}}Tokens.grayA3())
    .trackEffects(
      RemixBoxEffectsMix.overContent(
        _{{valuePrefix}}SwitchInsetRing(soft ? null : {{typePrefix}}Tokens.grayA5()),
      ),
    )
    .thumbColor({{typePrefix}}Tokens.gray2())
    .thumb(
      .border(
        .all(.color({{typePrefix}}Tokens.gray6()).width({{typePrefix}}Tokens.borderWidth1())),
      ),
    )
    .trackEffects(RemixBoxEffectsMix(outline: BorderSideMix(style: .none)));

/// The off thumb is a light surface; its neutral ring separates it from the
/// off track in light mode, where white alone is too close to the track.
BoxStyler _{{valuePrefix}}SwitchOffThumbStyler() => BoxStyler()
    .color(const Color(0xFFFFFFFF))
    .border(
      .all(
        .color({{typePrefix}}Tokens.controlBorder()).width({{typePrefix}}Tokens.borderWidth1()),
      ),
    );

/// The selected surface thumb stays a light surface rather than a disc of
/// on-solid ink: a 2px [{{typePrefix}}Tokens.accentThumbRing] carries its contrast on
/// light fills. High contrast keeps its deliberate step-1 knockout thumb.
BoxStyler _{{valuePrefix}}SwitchSelectedThumbStyler(bool highContrast) => highContrast
    ? BoxStyler()
          .color({{typePrefix}}Tokens.accent1())
          .border(
            .all(
              .color({{typePrefix}}Tokens.gray7()).width({{typePrefix}}Tokens.borderWidth1()),
            ),
          )
    : BoxStyler()
          .color(const Color(0xFFFFFFFF))
          .border(
            .all(
              .color(
                {{typePrefix}}Tokens.accentThumbRing(),
              ).width({{typePrefix}}Tokens.borderWidth2()),
            ),
          );

/// Selected soft thumbs keep their accent content role on the tinted track.
BoxStyler _{{valuePrefix}}SwitchSoftSelectedThumbStyler(bool highContrast) => BoxStyler()
    .color(highContrast ? {{typePrefix}}Tokens.accent12() : {{typePrefix}}Tokens.accent11())
    .border(
      .all(.color({{typePrefix}}Tokens.gray7()).width({{typePrefix}}Tokens.borderWidth1())),
    );

/// A 1px inset track ring, or none when [color] is null.
RemixBoxEffectLayerMix _{{valuePrefix}}SwitchInsetRing(Color? color) =>
    _{{valuePrefix}}SwitchLayer(
      shadows: [
        if (color != null)
          RemixBoxShadowMix(kind: .inset, color: color, spreadRadius: 1),
      ],
    );

RemixBoxEffectLayerMix _{{valuePrefix}}SwitchLayer({
  List<RemixBoxShadowMix>? shadows,
  RemixBoxShadowListToken? shadowToken,
}) => RemixBoxEffectLayerMix(shadows: shadows, shadowToken: shadowToken);
