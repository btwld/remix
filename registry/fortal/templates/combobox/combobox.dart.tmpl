ComboboxStyler {{valuePrefix}}ComboboxStyle({
  {{typePrefix}}TextFieldVariant variant = .surface,
  {{typePrefix}}TextFieldSize size = .size2,
  ComboboxStyler style = const ComboboxStyler.create(),
}) {
  final highlighted = ComboboxOptionStyler().color({{typePrefix}}Tokens.gray3());

  return ComboboxStyler()
      .field(
        {{valuePrefix}}TextFieldStyle(
          variant: variant,
          size: size,
        ).merge(_field(variant)),
      )
      .panel(
        ComboboxPanelStyler()
            .margin(.top({{typePrefix}}Tokens.space2()))
            .maxHeight(300)
            .scrollbarColor({{typePrefix}}Tokens.gray9())
            .scrollbarThickness(0)
            .borderRadius(.all({{typePrefix}}Tokens.radius6()))
            .color({{typePrefix}}Tokens.colorPanelSolid())
            .padding(.all(_panelInset()))
            .border(
              .all(
                .color({{typePrefix}}Tokens.gray7()).width({{typePrefix}}Tokens.borderWidth1()),
              ),
            )
            .decoration(
              BoxDecorationMix.create(boxShadow: {{typePrefix}}Tokens.shadow5.mix()),
            )
            .panelTransition(
              RemixPanelTransition(
                duration: {{typePrefix}}SpringCurve.snappy.duration,
                reverseDuration: {{typePrefix}}Motion.instant,
                reducedMotionDuration: {{typePrefix}}Motion.instant,
                builder: _panelMotion,
              ),
            ),
      )
      .option(
        ComboboxOptionStyler()
            .minHeight(_optionHeight())
            .padding(
              .symmetric(
                horizontal: {{typePrefix}}Tokens.space3(),
                vertical: _optionPaddingY(),
              ),
            )
            .borderRadius(.all(_optionRadius()))
            .label(
              TextStyler(
                style: {{typePrefix}}Tokens.text2.mix(),
              ).color({{typePrefix}}Tokens.gray12()),
            )
            .onHovered(highlighted)
            .onFocused(highlighted)
            .onPressed(highlighted)
            .animate(
              AnimationConfig.curve(
                duration: const Duration(milliseconds: 80),
                curve: {{typePrefix}}Motion.easeStandard,
              ),
            ),
      )
      .merge(style);
}

/// The field's own frame over the text field look. Focus with the panel
/// closed draws the accent frame; the open panel and the pointer draw the
/// strong frame over the muted fill, and the pointer wins over focus.
TextFieldStyler _field({{typePrefix}}TextFieldVariant variant) {
  final engaged = _frame({{typePrefix}}Tokens.gray8()).color({{typePrefix}}Tokens.gray3());
  final rest = switch (variant) {
    .surface => _frame({{typePrefix}}Tokens.gray7()),
    .soft => TextFieldStyler(),
  };

  return rest
      .onFocused(_frame({{typePrefix}}Tokens.accent9()))
      .onSelected(engaged)
      .onHovered(engaged)
      .onDisabled(rest)
      .variant(
        ContextVariant.widgetState(.error),
        _frame({{typePrefix}}Tokens.error8()),
      );
}

TextFieldStyler _frame(Color color) => TextFieldStyler().containerEffects(
  RemixBoxEffectsMix.overContent({{valuePrefix}}InsetSurface(strokes: [color])),
);

