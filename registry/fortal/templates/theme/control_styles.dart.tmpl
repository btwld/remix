final class _{{typePrefix}}FocusRingMix extends ModifierMix<_{{typePrefix}}FocusRingModifier> {
  const _{{typePrefix}}FocusRingMix(this.radius, this.visible);
  final Radius? radius;
  final bool visible;

  @override
  _{{typePrefix}}FocusRingModifier resolve(BuildContext context) {
    final outline = {{valuePrefix}}FocusOutline().resolve(context);
    return _{{typePrefix}}FocusRingModifier(
      color: visible ? outline.outline.color : const Color(0x00000000),
      width: outline.outline.width,
      offset: outline.outlineOffset,
      radius:
          MixOps.resolve(context, Prop.maybe(radius)) ??
          {{typePrefix}}Tokens.radius2.resolve(context),
    );
  }

  @override
  _{{typePrefix}}FocusRingMix merge(_{{typePrefix}}FocusRingMix? other) => other ?? this;
  @override
  List<Object?> get props => [radius, visible];
}

final class _{{typePrefix}}FocusRingModifier
    extends WidgetModifier<_{{typePrefix}}FocusRingModifier> {
  const _{{typePrefix}}FocusRingModifier({
    required this.color,
    required this.width,
    required this.offset,
    required this.radius,
  });
  final Color color;
  final double width;
  final double offset;
  final Radius radius;

  @override
  _{{typePrefix}}FocusRingModifier copyWith({
    Color? color,
    double? width,
    double? offset,
    Radius? radius,
  }) => _{{typePrefix}}FocusRingModifier(
    color: color ?? this.color,
    width: width ?? this.width,
    offset: offset ?? this.offset,
    radius: radius ?? this.radius,
  );
  @override
  _{{typePrefix}}FocusRingModifier lerp(_{{typePrefix}}FocusRingModifier? other, double t) =>
      other == null
      ? this
      : _{{typePrefix}}FocusRingModifier(
          color: Color.lerp(color, other.color, t)!,
          width: width + (other.width - width) * t,
          offset: offset + (other.offset - offset) * t,
          radius: Radius.lerp(radius, other.radius, t)!,
        );
  @override
  Widget build(Widget child) => CustomPaint(
    foregroundPainter: _{{typePrefix}}FocusPainter(color, width, offset, radius),
    child: child,
  );
  @override
  List<Object?> get props => [color, width, offset, radius];
}

class _{{typePrefix}}FocusPainter extends CustomPainter {
  const _{{typePrefix}}FocusPainter(this.color, this.width, this.offset, this.radius);
  final Color color;
  final double width;
  final double offset;
  final Radius radius;

  @override
  void paint(Canvas canvas, Size size) {
    if (color.a == 0 || width == 0) return;
    final box = RRect.fromRectAndRadius(Offset.zero & size, radius);
    canvas.drawDRRect(
      box.inflate(offset + width),
      box.inflate(offset),
      Paint()..color = color,
    );
  }

  @override
  bool shouldRepaint(_{{typePrefix}}FocusPainter old) =>
      color != old.color ||
      width != old.width ||
      offset != old.offset ||
      radius != old.radius;
}

/// A crisp inset frame, not an elevation shadow. No blur or offset is used.
RemixBoxEffectLayerMix {{valuePrefix}}InsetSurface({required List<Color> strokes}) =>
    RemixBoxEffectLayerMix(
      shadows: [
        for (final stroke in strokes)
          RemixBoxShadowMix(
            kind: .inset,
            color: stroke,
            spreadRadius: {{typePrefix}}Tokens.borderWidth1(),
          ),
      ],
    );
