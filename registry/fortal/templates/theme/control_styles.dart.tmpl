/// {{typePrefix}}'s focus ring: solid step 8, 2px wide, with a 2px gap.
/// Tokens resolve at the control, so nested themes and overrides work.
/// The outline takes no layout space and never replaces the control's border.
RemixBoxEffectsMix {{valuePrefix}}FocusOutline() => RemixBoxEffectsMix(
  outline: BorderSideMix(
    color: {{typePrefix}}Tokens.focus8(),
    width: {{typePrefix}}Tokens.focusRingWidth(),
  ),
  outlineOffset: {{typePrefix}}Tokens.focusRingOffset(),
);

/// Keeps compact visual sizes while giving controls a 40px interaction area.
/// This wraps the painted child inside Naked UI's existing gesture target.
WidgetModifierConfig {{valuePrefix}}TouchTarget() =>
    WidgetModifierConfig.modifier(const _{{typePrefix}}TouchTargetMix());

final class _{{typePrefix}}TouchTargetMix extends ModifierMix<_{{typePrefix}}TouchTarget> {
  const _{{typePrefix}}TouchTargetMix();

  @override
  _{{typePrefix}}TouchTarget resolve(BuildContext context) =>
      _{{typePrefix}}TouchTarget({{typePrefix}}Tokens.touchTargetMin.resolve(context));

  @override
  _{{typePrefix}}TouchTargetMix merge(_{{typePrefix}}TouchTargetMix? other) => other ?? this;

  @override
  List<Object?> get props => const [];
}

final class _{{typePrefix}}TouchTarget extends WidgetModifier<_{{typePrefix}}TouchTarget> {
  const _{{typePrefix}}TouchTarget(this.minimum);
  final double minimum;

  @override
  Widget build(Widget child) => ConstrainedBox(
    constraints: BoxConstraints(minWidth: minimum, minHeight: minimum),
    child: Center(widthFactor: 1, heightFactor: 1, child: child),
  );

  @override
  _{{typePrefix}}TouchTarget copyWith({double? minimum}) =>
      _{{typePrefix}}TouchTarget(minimum ?? this.minimum);

  @override
  _{{typePrefix}}TouchTarget lerp(_{{typePrefix}}TouchTarget? other, double t) =>
      _{{typePrefix}}TouchTarget(minimum + ((other?.minimum ?? minimum) - minimum) * t);

  @override
  List<Object?> get props => [minimum];
}

/// The same outline for surfaces without a Remix effects slot.
WidgetModifierConfig {{valuePrefix}}FocusRingModifier({
  Radius? radius,
  bool visible = true,
}) => WidgetModifierConfig.modifier(_{{typePrefix}}FocusRingMix(radius, visible));

extension {{typePrefix}}FocusRingToggle on ToggleStyler {
  ToggleStyler {{valuePrefix}}FocusRing({Radius? radius}) =>
      container(FlexBoxStyler().wrap({{valuePrefix}}FocusRingModifier(radius: radius)));
}

