/// Fortal accents, named for Fortaleza landscapes and coastal materials.
/// Every accent shares one untinted neutral; an accent recolours selection
/// controls, accent text, soft tints, the focus outline and chart series.
/// Error roles use a dedicated red palette that is not a selectable accent.
enum {{typePrefix}}AccentColor { orla, mar, ceu, serra, sol, duna, caju, jambo }

/// Theme-level radius multipliers.
enum {{typePrefix}}Radius { none, small, medium, large, full }

/// Background treatment used by floating panels.
enum {{typePrefix}}PanelBackground { solid, translucent }

/// Discrete theme scaling values supported by Fortal.
enum {{typePrefix}}Scaling {
  percent90(0.9),
  percent95(0.95),
  percent100(1.0),
  percent105(1.05),
  percent110(1.1);

  const {{typePrefix}}Scaling(this.factor);

  /// Numeric multiplier represented by this preset.
  final double factor;
}

/// Appearance selection for a Fortal scope. A root defaults to system;
/// a nested scope inherits its parent's selection when mode is omitted.
enum {{typePrefix}}ThemeMode { system, light, dark }

/// Partial theme values applied by a [{{typePrefix}}Theme].
@immutable
class {{typePrefix}}ThemeConfig {
  const {{typePrefix}}ThemeConfig({
    this.accent,
    this.accentPalette,
    this.brightness,
    this.panelBackground,
    this.radius,
    this.scaling,
    this.hasBackground,
    this.highContrast,
    this.fontFamily,
    this.displayFontFamily,
    this.monoFontFamily,
  });

  final {{typePrefix}}AccentColor? accent;

  /// Optional seed-generated brand palette, overriding the named accent.
  final {{typePrefix}}ColorTheme? accentPalette;
  final Brightness? brightness;
  final {{typePrefix}}PanelBackground? panelBackground;
  final {{typePrefix}}Radius? radius;
  final {{typePrefix}}Scaling? scaling;
  final bool? hasBackground;

  /// Moves the foundation's low-contrast boundaries (control borders, the off
  /// track, thumb outlines, mark fills and accent text) to values that meet
  /// Fortal's contrast gates. Per-family `highContrast` parameters keep their
  /// step-12 treatment on top of it.
  final bool? highContrast;

  /// Family of body text, `text1` to `text6` and typed field text.
  final String? fontFamily;

  /// Family of display text, `text7` to `text9`.
  final String? displayFontFamily;

  /// Family of code and keyboard text.
  final String? monoFontFamily;

  bool get isDark => brightness == .dark;

  {{typePrefix}}ThemeConfig copyWith({
    {{typePrefix}}AccentColor? accent,
    {{typePrefix}}ColorTheme? accentPalette,
    Brightness? brightness,
    {{typePrefix}}PanelBackground? panelBackground,
    {{typePrefix}}Radius? radius,
    {{typePrefix}}Scaling? scaling,
    bool? hasBackground,
    bool? highContrast,
    String? fontFamily,
    String? displayFontFamily,
    String? monoFontFamily,
  }) => {{typePrefix}}ThemeConfig(
    accent: accent ?? this.accent,
    accentPalette:
        accentPalette ?? (accent == null ? this.accentPalette : null),
    brightness: brightness ?? this.brightness,
    panelBackground: panelBackground ?? this.panelBackground,
    radius: radius ?? this.radius,
    scaling: scaling ?? this.scaling,
    hasBackground: hasBackground ?? this.hasBackground,
    highContrast: highContrast ?? this.highContrast,
    fontFamily: fontFamily ?? this.fontFamily,
    displayFontFamily: displayFontFamily ?? this.displayFontFamily,
    monoFontFamily: monoFontFamily ?? this.monoFontFamily,
  );

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is {{typePrefix}}ThemeConfig &&
          accent == other.accent &&
          accentPalette == other.accentPalette &&
          brightness == other.brightness &&
          panelBackground == other.panelBackground &&
          radius == other.radius &&
          scaling == other.scaling &&
          hasBackground == other.hasBackground &&
          highContrast == other.highContrast &&
          fontFamily == other.fontFamily &&
          displayFontFamily == other.displayFontFamily &&
          monoFontFamily == other.monoFontFamily;

  @override
  int get hashCode => Object.hash(
    accent,
    accentPalette,
    brightness,
    panelBackground,
    radius,
    scaling,
    hasBackground,
    highContrast,
    fontFamily,
    displayFontFamily,
    monoFontFamily,
  );
}

