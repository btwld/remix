  /// The preset's dark appearance, with editable design options.
  const {{typePrefix}}ThemeData.dark({
    {{typePrefix}}AccentColor accent = {{typePrefix}}AccentColor.calcadao,
    {{typePrefix}}ColorTheme? accentPalette,
    {{typePrefix}}GrayColor gray = {{typePrefix}}GrayColor.calcadao,
    {{typePrefix}}PanelBackground panelBackground = {{typePrefix}}PanelBackground.solid,
    {{typePrefix}}Radius radius = {{typePrefix}}Radius.medium,
    {{typePrefix}}Scaling scaling = {{typePrefix}}Scaling.percent100,
    bool hasBackground = true,
  }) : this(
         accent: accent,
         accentPalette: accentPalette,
         gray: gray,
         brightness: Brightness.dark,
         panelBackground: panelBackground,
         radius: radius,
         scaling: scaling,
         hasBackground: hasBackground,
