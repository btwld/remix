/// The token maps already built, by theme.
///
/// A scope rebuilds whenever its parent does, and nested scopes are common: a
/// table of status badges holds one per row. Building a map resolves every
/// computed role, so each distinct theme is built once and then shared. The
/// same instance also lets Mix skip comparing the map entry by entry.
final _scopeTokens = <{{typePrefix}}ThemeData, Map<MixToken<Object?>, Object>>{};

/// Themes kept before the cache starts over. An application has two
/// appearances and a handful of nested accents; a theme animated through
/// custom palettes must not grow the cache without bound.
const _scopeTokensLimit = 64;

/// Returns the token map for a Fortal scope. Used by [{{typePrefix}}Theme].
///
/// The map is shared between scopes with an equal [theme] and cannot be
/// modified.
Map<MixToken<Object?>, Object> build{{typePrefix}}ScopeTokens({{typePrefix}}ThemeData theme) {
  final cached = _scopeTokens[theme];
  if (cached != null) return cached;
  if (_scopeTokens.length >= _scopeTokensLimit) _scopeTokens.clear();

  return _scopeTokens[theme] = Map.unmodifiable(_buildScopeTokens(theme));
}

Map<MixToken<Object?>, Object> _buildScopeTokens({{typePrefix}}ThemeData theme) {
  final tokens = resolve{{typePrefix}}Tokens(theme);
  final scaling = theme.scaling.factor;
  final shadows = build{{typePrefix}}Shadows(isDark: theme.isDark);
  // Error roles never follow the accent or a custom palette.
  final error = theme.isDark
      ? colors.{{valuePrefix}}Error.dark.scale
      : colors.{{valuePrefix}}Error.light.scale;
  final functional = tokens.functional;
  TextStyle text(
    double size, {
    required double leading,
    required double tracking,
    String? family,
  }) => TextStyle(
    fontFamily: family ?? theme.fontFamily,
    fontSize: size * scaling,
    letterSpacing: tracking * size * scaling,
    height: leading,
    // CSS splits leading evenly around the glyphs; Flutter's default places
    // it by font metrics, which sits a label off-centre in a control sized to
    // the line height.
    leadingDistribution: TextLeadingDistribution.even,
  );
  TextStyle body(
    double size, {
    double leading = 1.4,
    double tracking = -0.01,
  }) => text(size, leading: leading, tracking: tracking);
  TextStyle display(double size) => text(
    size,
    leading: 1.1,
