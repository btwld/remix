/// {{typePrefix}} palettes, named for the landscapes and coastal materials. Error
/// roles use a dedicated red palette that is not a selectable accent.
enum {{typePrefix}}AccentColor { calcadao, mar, ceu, serra, sol, duna, caju }

/// The neutral palette. The enum leaves room for future neutral families.
enum {{typePrefix}}GrayColor { calcadao }

/// Theme-level radius multipliers.
enum {{typePrefix}}Radius { none, small, medium, large, full }

/// Background treatment used by floating panels.
enum {{typePrefix}}PanelBackground { solid, translucent }

/// Discrete theme scaling values supported by {{typePrefix}}.
enum {{typePrefix}}Scaling {
  percent90(0.9),
  percent95(0.95),
  percent100(1.0),
  percent105(1.05),
  percent110(1.1);

  const {{typePrefix}}Scaling(this.factor);

  /// Numeric multiplier represented by this preset.
  final double factor;
}

/// Appearance selection for a {{typePrefix}} scope. A root defaults to system;
/// a nested scope inherits its parent's selection when mode is omitted.
enum {{typePrefix}}ThemeMode { system, light, dark }

/// Partial theme values applied by a [{{typePrefix}}Theme].
@immutable
class {{typePrefix}}ThemeConfig {
  const {{typePrefix}}ThemeConfig({
    this.accent,
    this.accentPalette,
    this.gray,
    this.brightness,
    this.panelBackground,
    this.radius,
    this.scaling,
    this.hasBackground,
  });

  final {{typePrefix}}AccentColor? accent;

  /// Optional seed-generated brand palette, overriding the named accent.
  final {{typePrefix}}ColorTheme? accentPalette;
  final {{typePrefix}}GrayColor? gray;
  final Brightness? brightness;
  final {{typePrefix}}PanelBackground? panelBackground;
  final {{typePrefix}}Radius? radius;
  final {{typePrefix}}Scaling? scaling;
  final bool? hasBackground;

  bool get isDark => brightness == .dark;

  {{typePrefix}}ThemeConfig copyWith({
    {{typePrefix}}AccentColor? accent,
    {{typePrefix}}ColorTheme? accentPalette,
    {{typePrefix}}GrayColor? gray,
    Brightness? brightness,
    {{typePrefix}}PanelBackground? panelBackground,
    {{typePrefix}}Radius? radius,
    {{typePrefix}}Scaling? scaling,
    bool? hasBackground,
  }) => {{typePrefix}}ThemeConfig(
    accent: accent ?? this.accent,
    accentPalette:
        accentPalette ?? (accent == null ? this.accentPalette : null),
    gray: gray ?? this.gray,
    brightness: brightness ?? this.brightness,
    panelBackground: panelBackground ?? this.panelBackground,
    radius: radius ?? this.radius,
    scaling: scaling ?? this.scaling,
    hasBackground: hasBackground ?? this.hasBackground,
  );

  @override
  bool operator ==(Object other) =>
      identical(this, other) ||
      other is {{typePrefix}}ThemeConfig &&
          accent == other.accent &&
          accentPalette == other.accentPalette &&
          gray == other.gray &&
          brightness == other.brightness &&
          panelBackground == other.panelBackground &&
          radius == other.radius &&
          scaling == other.scaling &&
          hasBackground == other.hasBackground;

  @override
  int get hashCode => Object.hash(
    accent,
    accentPalette,
    gray,
    brightness,
    panelBackground,
    radius,
    scaling,
    hasBackground,
  );
}

/// Fully resolved theme values inherited by a {{typePrefix}} subtree.
@immutable
class {{typePrefix}}ThemeData extends {{typePrefix}}ThemeConfig {
  const {{typePrefix}}ThemeData({
    required {{typePrefix}}AccentColor super.accent,
    super.accentPalette,
    required {{typePrefix}}GrayColor super.gray,
    required Brightness super.brightness,
    required {{typePrefix}}PanelBackground super.panelBackground,
    required {{typePrefix}}Radius super.radius,
    required {{typePrefix}}Scaling super.scaling,
    required bool super.hasBackground,
  });

  /// The preset's light appearance, with editable design options.
  const {{typePrefix}}ThemeData.light({
    {{typePrefix}}AccentColor accent = {{typePrefix}}AccentColor.calcadao,
    {{typePrefix}}ColorTheme? accentPalette,
    {{typePrefix}}GrayColor gray = {{typePrefix}}GrayColor.calcadao,
    {{typePrefix}}PanelBackground panelBackground = {{typePrefix}}PanelBackground.solid,
    {{typePrefix}}Radius radius = {{typePrefix}}Radius.medium,
    {{typePrefix}}Scaling scaling = {{typePrefix}}Scaling.percent100,
    bool hasBackground = true,
