      ErrorSummary('No {{typePrefix}}Theme found.'),
      ErrorDescription(
        '${context.widget.runtimeType} tried to read the {{typePrefix}} theme, but no {{typePrefix}}Scope was found above it.',
      ),
      context.describeElement('The context used was'),
    ]);
  }

  /// Returns the closest resolved {{typePrefix}} theme, if one is available.
  static {{typePrefix}}ThemeData? maybeOf(BuildContext context) =>
      context.dependOnInheritedWidgetOfExactType<{{typePrefix}}Theme>()?.data;

  /// Rebuilds only the theme and its Mix tokens.
  ///
