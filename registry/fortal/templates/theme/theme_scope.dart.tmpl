  Widget wrap(BuildContext context, Widget child) => {{typePrefix}}Theme(
    data: data,
    orderOfModifiers: orderOfModifiers,
    child: MixScope(
      tokens: build{{typePrefix}}ScopeTokens(data),
      orderOfModifiers: orderOfModifiers,
      child: child,
    ),
  );

  @override
  bool updateShouldNotify({{typePrefix}}Theme oldWidget) => data != oldWidget.data;
}
