import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';

import 'theme_data.dart';

/// Provides IBM Carbon design tokens to its subtree via a [MixScope], and
/// exposes the active [{{typePrefix}}Theme] to descendants.
///
/// Place a [{{typePrefix}}Scope] at the root of the app (or around any subtree that uses
/// Carbon widgets/styles) so that `{{typePrefix}}Tokens.*` resolve to concrete values.
///
/// ```dart
/// {{typePrefix}}Scope(
///   theme: {{typePrefix}}Theme.g100,
///   child: app,
/// )
/// ```
///
/// Pass [overrides] to substitute specific colors or a bundled font family
/// (for example an `IBM Plex Sans` family the app ships) without mutating the
/// generated theme maps.
class {{typePrefix}}Scope extends StatelessWidget {
  const {{typePrefix}}Scope({
    super.key,
    this.theme = {{typePrefix}}Theme.white,
    this.overrides = const {{typePrefix}}ThemeOverrides(),
    this.orderOfModifiers,
    required this.child,
  });

  /// The active Carbon theme.
  final {{typePrefix}}Theme theme;

  /// Optional typed overrides (colors, font family).
  final {{typePrefix}}ThemeOverrides overrides;

  /// Optional Mix modifier ordering, forwarded to [MixScope].
  final List<Type>? orderOfModifiers;

  final Widget child;

  /// The active [{{typePrefix}}Theme] for [context], or null if there is no scope.
  static {{typePrefix}}Theme? maybeThemeOf(BuildContext context) {
    final scope = context
        .dependOnInheritedWidgetOfExactType<_{{typePrefix}}Inherited>();

    return scope?.theme;
  }

  /// The active [{{typePrefix}}ThemeOverrides] for [context] (empty with no scope).
  ///
  /// Lets font-aware helpers such as `{{typePrefix}}Type.fluidTextStyle` pick up the
  /// scope's configured font family without re-passing it at every call site.
  static {{typePrefix}}ThemeOverrides overridesOf(BuildContext context) {
    final scope = context
        .dependOnInheritedWidgetOfExactType<_{{typePrefix}}Inherited>();

    return scope?.overrides ?? const {{typePrefix}}ThemeOverrides();
  }

  /// The active [{{typePrefix}}Theme] for [context].
  ///
  /// Throws if there is no enclosing [{{typePrefix}}Scope]; use [maybeThemeOf] when the
  /// scope may be absent.
  static {{typePrefix}}Theme themeOf(BuildContext context) {
    final theme = maybeThemeOf(context);
    assert(theme != null, 'No {{typePrefix}}Scope found in the widget tree.');

    return theme ?? .white;
  }

  @override
  Widget build(BuildContext context) {
    return _{{typePrefix}}Inherited(
      theme: theme,
      overrides: overrides,
      child: MixScope(
        tokens: build{{typePrefix}}TokenMap(theme, overrides: overrides),
        orderOfModifiers: orderOfModifiers,
        child: child,
      ),
    );
  }
}

class _{{typePrefix}}Inherited extends InheritedWidget {
  const _{{typePrefix}}Inherited({
    required this.theme,
    required this.overrides,
    required super.child,
  });

  final {{typePrefix}}Theme theme;
  final {{typePrefix}}ThemeOverrides overrides;

  @override
  bool updateShouldNotify(_{{typePrefix}}Inherited oldWidget) =>
      oldWidget.theme != theme || oldWidget.overrides != overrides;
}
