import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'badge.g.dart';

/// {{typePrefix}} recipe for [RemixBadge]: a pill with a quiet border and a 12px label.
///
/// [{{typePrefix}}Color.defaultColor] is the plain badge, muted text in a hairline
/// border. Any other colour tints the fill to 10% and the border to 25% and
/// colours the label, as {{valuePrefix}}'s status badges do. [style] merges last.
@MixWidget(target: RemixBadge.new)
BadgeStyler {{valuePrefix}}BadgeStyle({
  {{typePrefix}}Color color = .defaultColor,
  BadgeStyler style = const BadgeStyler.create(),
}) {
  final tone = _tone(color);
  return BadgeStyler()
      .alignment(.center)
      .padding(.symmetric(horizontal: _paddingX, vertical: _paddingY))
      .borderRadius(.circular(_pill))
      .color(tone.fill)
      .border(.color(tone.edge).width(1))
      .label(
        .style({{typePrefix}}Tokens.textXs.mix())
            .fontWeight(.w500)
            .color(tone.label)
            .softWrap(false)
            .maxLines(1)
            .overflow(TextOverflow.ellipsis),
      )
      .merge(style);
}

typedef _Tone = ({Color fill, Color edge, Color label});

_Tone _tone({{typePrefix}}Color color) => switch (color) {
  .defaultColor => (
    fill: {{typePrefix}}Tokens.transparent,
    edge: {{typePrefix}}Tokens.border(),
    label: {{typePrefix}}Tokens.muted(),
  ),
  .accent => (
    fill: _accentFill(),
    edge: _accentEdge(),
    label: {{typePrefix}}Tokens.accent(),
  ),
  .success => (
    fill: _successFill(),
    edge: _successEdge(),
    label: {{typePrefix}}Tokens.success(),
  ),
  .warning => (
    fill: _warningFill(),
    edge: _warningEdge(),
    label: {{typePrefix}}Tokens.warning(),
  ),
  .danger => (
    fill: _dangerFill(),
    edge: _dangerEdge(),
    label: {{typePrefix}}Tokens.danger(),
  ),
};

final _accentFill = {{valuePrefix}}Alpha({{typePrefix}}Tokens.accent, .10);
final _accentEdge = {{valuePrefix}}Alpha({{typePrefix}}Tokens.accent, .25);
final _successFill = {{valuePrefix}}Alpha({{typePrefix}}Tokens.success, .10);
final _successEdge = {{valuePrefix}}Alpha({{typePrefix}}Tokens.success, .25);
final _warningFill = {{valuePrefix}}Alpha({{typePrefix}}Tokens.warning, .10);
final _warningEdge = {{valuePrefix}}Alpha({{typePrefix}}Tokens.warning, .25);
final _dangerFill = {{valuePrefix}}Alpha({{typePrefix}}Tokens.danger, .10);
final _dangerEdge = {{valuePrefix}}Alpha({{typePrefix}}Tokens.danger, .25);

const _paddingX = 8.0;
const _paddingY = 2.0;
const _pill = 999.0;
