import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'disclosure.g.dart';

/// {{typePrefix}} recipe for [RemixDisclosure].
///
/// [animationStyle] defaults to {{typePrefix}}'s accordion timing: 200 ms in and out on
/// [Curves.ease], which is also Remix's own default.
@MixWidget(target: RemixDisclosure.new)
DisclosureStyler {{valuePrefix}}DisclosureStyle({
  AnimationStyle animationStyle = const AnimationStyle(
    curve: Curves.ease,
    duration: _panelDuration,
    reverseDuration: _panelDuration,
  ),
  DisclosureStyler style = const DisclosureStyler.create(),
}) => DisclosureStyler()
    .content(BoxStyler().padding(.all(_bodyPadding)))
    .onFocusVisible(DisclosureStyler().triggerEffects({{valuePrefix}}FocusRing()))
    .onDisabled(
      DisclosureStyler().trigger(
        BoxStyler().wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
      ),
    )
    .merge(style);

/// The panel's height and opacity, 200 ms both ways.
const _panelDuration = Duration(milliseconds: 200);

/// `.disclosure__body`: `p-2`.
const _bodyPadding = 8.0;
