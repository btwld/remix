import 'dart:ui' show ImageFilter;

import 'package:flutter/physics.dart';
import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/theme.dart';

part 'modal.g.dart';

/// {{typePrefix}} modal widths.
enum {{typePrefix}}ModalSize {
  /// `max-w-xs`: 320px.
  xs,

  /// `max-w-sm`: 384px.
  sm,

  /// `max-w-md`: 448px. The default.
  md,

  /// `max-w-lg`: 512px.
  lg,

  /// Fills the viewport inside the container's inset, keeping the rounded card.
  cover,

  /// Fills the viewport edge to edge, without inset or rounded corners.
  full,
}

/// Where the dialog sits in the viewport.
enum {{typePrefix}}ModalPlacement {
  /// A bottom sheet below the `sm` breakpoint, centered from it up.
  auto,

  /// Centered.
  center,

  /// Against the top edge.
  top,

  /// Against the bottom edge.
  bottom,
}

/// {{typePrefix}} recipe for [RemixDialog], the modal surface.
///
/// Open it with `showRemixDialog`, or `showRemixAlertDialog` for an alert; pass
/// `{{typePrefix}}Tokens.backdrop` (resolved in the caller's context) as `barrierColor`
/// for {{typePrefix}}'s backdrop.
@MixWidget(target: RemixDialog.new)
DialogStyler {{valuePrefix}}ModalStyle({
  {{typePrefix}}ModalSize size = .md,
  {{typePrefix}}ModalPlacement placement = .auto,
  DialogStyler style = const DialogStyler.create(),
}) {
  final full = size == .full;
  final alignment = switch (placement) {
    .auto || .bottom => Alignment.bottomCenter,
    .center => Alignment.center,
    .top => Alignment.topCenter,
  };

  return DialogStyler()
      .wrap(_frame(full ? 0 : _inset, alignment))
      .onBreakpoint(
        const Breakpoint.minWidth({{typePrefix}}Tokens.breakpointSm),
        DialogStyler().wrap(
          _frame(
            full ? 0 : _insetSm,
            placement == .auto ? Alignment.center : alignment,
          ),
        ),
      )
      .padding(.all(_padding))
      .color({{typePrefix}}Tokens.surface())
      .title(
        .style(
          {{typePrefix}}Tokens.textBase.mix(),
        ).fontWeight(.w500).color({{typePrefix}}Tokens.foreground()),
      )
      .description(
        TextStyler(style: {{typePrefix}}Tokens.textSm.mix())
            .color({{typePrefix}}Tokens.muted())
            .wrap(
              .padding(
                EdgeInsetsGeometryMix.only(
                  top: _bodyGap + _bodyInset,
                  bottom: _bodyInset,
                ),
              ),
            ),
      )
      .actions(
        FlexBoxStyler()
            .mainAxisAlignment(.end)
            .crossAxisAlignment(.center)
            .spacing(_actionsGap)
            .margin(.top(_footerGap)),
      )
      .merge(switch (size) {
        .xs => DialogStyler().maxWidth(_maxWidthXs),
        .sm => DialogStyler().maxWidth(_maxWidthSm),
        .md => DialogStyler().maxWidth(_maxWidthMd),
        .lg => DialogStyler().maxWidth(_maxWidthLg),
        .cover || .full => DialogStyler().width(.infinity).height(.infinity),
      })
      .merge(
        full
            ? null
            : DialogStyler()
                  .borderRadius(.all({{typePrefix}}Tokens.radiusPanel()))
                  .border({{valuePrefix}}Hairline()),
      )
      .merge(style);
}

/// Opens [builder] with {{typePrefix}}'s modal motion: a 650 ms spring in (opacity, an
/// 8px rise and a .96 to 1 scale), a blur of 24 that follows the opacity, and
/// a 150 ms ease-out back. [{{typePrefix}}Tokens.backdrop] is the barrier.
///
/// This is `showRemixDialog` with its `transitionDuration`,
/// `reverseTransitionDuration` and `transitionBuilder` set; it adds no route of
/// its own. With reduced motion (`MediaQuery.disableAnimations`) the modal
/// appears and leaves at once. Dismissing mid-entrance returns from the current
/// pose over the reverse duration.
Future<T?> show{{typePrefix}}Modal<T>({
  required BuildContext context,
  required WidgetBuilder builder,
  bool barrierDismissible = true,
  String? barrierLabel,
  bool useRootNavigator = true,
  RouteSettings? routeSettings,
}) {
  final reduced = MediaQuery.disableAnimationsOf(context);

  return showRemixDialog<T>(
    context: context,
    builder: builder,
    barrierColor: {{typePrefix}}Tokens.backdrop.resolve(context),
    barrierDismissible: barrierDismissible,
    barrierLabel: barrierLabel ?? 'Dismiss dialog',
    useRootNavigator: useRootNavigator,
    routeSettings: routeSettings,
    transitionDuration: reduced ? Duration.zero : _enter,
    reverseTransitionDuration: reduced ? Duration.zero : _exit,
    transitionBuilder: (context, animation, secondary, child) {
      if (reduced) return child;

      return AnimatedBuilder(
        animation: animation,
        builder: (context, _) {
          final reverse = animation.status == AnimationStatus.reverse;
          final progress = reverse
              ? 1 - _easeOut.transform(1 - animation.value)
              : _spring.x(animation.value * _springSpan);
          final blur = reverse
              ? progress
              : _easeOut.transform((animation.value * 3.25).clamp(0.0, 1.0));
          final shown = progress.clamp(0.0, 1.0);

          return Stack(
            fit: StackFit.expand,
            children: [
              IgnorePointer(
                child: BackdropFilter(
                  filter: ImageFilter.blur(
                    sigmaX: _blur * blur,
                    sigmaY: _blur * blur,
                  ),
                  child: const SizedBox.expand(),
                ),
              ),
              Opacity(
                opacity: shown,
                child: Transform.translate(
                  offset: Offset(
                    0,
                    (reverse ? _riseOut : _rise) * (1 - progress),
                  ),
                  child: Transform.scale(
                    scale: _scaleFrom + (1 - _scaleFrom) * progress,
                    child: child,
                  ),
                ),
              ),
            ],
          );
        },
      );
    },
  );
}

const _enter = Duration(milliseconds: 650);
const _exit = Duration(milliseconds: 150);
const _easeOut = Cubic(.16, 1, .3, 1);
const _blur = 24.0;
const _rise = 8.0;
const _riseOut = 6.0;
const _scaleFrom = .96;

/// The panel spring (mass .5, stiffness 420, damping 40) settles in about
/// 0.65 s of its own time; the 650 ms route runs it over that span.
const _springSpan = .65;
final _spring = SpringSimulation(
  const SpringDescription(mass: .5, stiffness: 420, damping: 40),
  0,
  1,
  0,
);

/// The positioning wrapper `.modal__container`: inset by its padding, then
/// aligned.
WidgetModifierConfig _frame(double inset, Alignment alignment) =>
    WidgetModifierConfig.padding(EdgeInsetsGeometryMix.all(inset))
        .align(alignment: alignment)
        .orderOfModifiers([PaddingModifier, AlignModifier]);

/// `.modal__container` `p-4`, then `sm:p-10`.
const _inset = 16.0;
const _insetSm = 40.0;

/// `.modal__dialog` `p-6`; `.modal__header + .modal__body` `mt-2`, and the
/// body's own `p-[3px]` (`modal-md-auto-body`); `.modal__body + .modal__footer`
/// `mt-5`; `.modal__footer` `gap-2`.
const _padding = 16.0;
const _bodyGap = 8.0;
const _bodyInset = 3.0;
const _footerGap = 20.0;
const _actionsGap = 8.0;

/// `max-w-xs`, `max-w-sm`, `max-w-md`, `max-w-lg`.
const _maxWidthXs = 320.0;
const _maxWidthSm = 384.0;
const _maxWidthMd = 448.0;
const _maxWidthLg = 512.0;
