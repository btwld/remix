import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/tokens.dart';
import 'button.dart';
import 'icon_button.dart';

part 'toast.g.dart';

/// The tones this application offers for a toast.
enum {{typePrefix}}ToastVariant {
  /// An ordinary confirmation or notice.
  neutral,

  /// A failure the reader should notice.
  ///
  /// Visual only. Pair it with `RemixToastPriority.assertive` when the message
  /// must interrupt a screen reader; a red outline alone announces nothing.
  destructive,
}

/// The application's Toast recipe.
///
/// Hand it to `RemixToastScope` once, above the app's `Navigator`, so every
/// route (dialogs included) can reach it:
///
/// ```dart
/// WidgetsApp(
///   color: const Color(0xFFFFFFFF),
///   pageRouteBuilder: <T>(settings, builder) => PageRouteBuilder<T>(
///     settings: settings,
///     pageBuilder: (context, animation, secondaryAnimation) => builder(context),
///   ),
///   home: const SizedBox.shrink(),
///   builder: (context, child) => Overlay.wrap(
///     child: RemixToastScope(style: {{valuePrefix}}ToastStyle(), child: child!),
///   ),
/// )
/// ```
///
/// One toast can switch tone through `RemixToastData.style`, which merges over
/// the scope's style:
///
/// ```dart
/// showRemixToast(
///   context,
///   RemixToastData(
///     title: 'Upload failed',
///     priority: RemixToastPriority.assertive,
///     style: {{valuePrefix}}ToastStyle(variant: .destructive),
///   ),
/// );
/// ```
///
/// The action and close button reuse the Button and IconButton recipes, with
/// their own hover, focus and press states.
@MixWidget(target: RemixToast.new)
ToastStyler {{valuePrefix}}ToastStyle({
  {{typePrefix}}ToastVariant variant = .neutral,
  ToastStyler style = const ToastStyler.create(),
}) {
  // The tone shows in the glyph and, for `destructive`, the outline. The text
  // stays `popoverForeground`, which reads on the toast's own surface.
  final (:border, :icon) = switch (variant) {
    .neutral => (
      border: {{typePrefix}}Tokens.border(),
      icon: {{typePrefix}}Tokens.mutedForeground(),
    ),
    .destructive => (
      border: {{typePrefix}}Tokens.destructive(),
      icon: {{typePrefix}}Tokens.destructive(),
    ),
  };

  return ToastStyler()
      .color({{typePrefix}}Tokens.popover())
      .border(.color(border).width({{typePrefix}}Tokens.strokeHairline))
      .borderRadius(.all({{typePrefix}}Tokens.radiusLg()))
      .padding(.all({{typePrefix}}Tokens.s4))
      .maxWidth({{typePrefix}}Tokens.toastWidth)
      // Heavier than a card's: a toast floats over content that keeps scrolling
      // beneath it. Black at 10%.
      .shadow(
        BoxShadowMix(
          color: const Color(0x1A000000),
          offset: const Offset(0, 4),
          blurRadius: 12,
        ),
      )
      .spacing({{typePrefix}}Tokens.s3)
      .content(FlexBoxStyler().spacing({{typePrefix}}Tokens.s1))
      .title(
        .style(
          {{typePrefix}}Tokens.textSm.mix(),
        ).fontWeight(FontWeight.w500).color({{typePrefix}}Tokens.popoverForeground()),
      )
      .description(
        .style(
          {{typePrefix}}Tokens.textSm.mix(),
        ).color({{typePrefix}}Tokens.mutedForeground()),
      )
      .icon(.size({{typePrefix}}Tokens.icon).color(icon))
      .action({{valuePrefix}}ButtonStyle(variant: .outline, size: .small))
      .closeButton({{valuePrefix}}IconButtonStyle(variant: .ghost, size: .small))
      .merge(style);
}
