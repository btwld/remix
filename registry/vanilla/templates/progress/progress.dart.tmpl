import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/effects.dart';
import '../theme/tokens.dart';

part 'progress.g.dart';

/// The application's Progress recipe.
///
/// An 8px bar with a `primary` indicator on a track of `primary` at 20%, so the
/// track reads as the same bar, not yet filled. Both ends are fully rounded:
/// the theme radius is authored for 32-40px controls. Set `.height(...)`
/// through [style] for another weight.
@MixWidget(target: RemixProgress.new)
ProgressStyler {{valuePrefix}}ProgressStyle({
  ProgressStyler style = const ProgressStyler.create(),
}) => ProgressStyler()
    // Spans its container: progress is a fraction of the width, so a
    // shrink-wrapped bar would collapse. The clip rounds the indicator as it
    // grows past the track's corner.
    .width(double.infinity)
    .height(_thickness)
    .borderRadius(.all(_radius))
    .clipBehavior(Clip.antiAlias)
    .track(
      _bar()
          .width(double.infinity)
          .color({{valuePrefix}}Tint({{typePrefix}}Tokens.primary, 0.2)()),
    )
    .indicator(_bar().color({{typePrefix}}Tokens.primary()))
    .merge(style);

const _thickness = {{typePrefix}}Tokens.s2;

/// Half the thickness, so each end is a semicircle.
const _radius = Radius.circular(_thickness / 2);

/// One rounded bar, used for both the track and the fill.
BoxStyler _bar() => BoxStyler().height(_thickness).borderRadius(.all(_radius));
