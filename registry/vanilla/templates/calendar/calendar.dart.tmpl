  CalendarStyler style = const CalendarStyler.create(),
}) {
  final clear = {{valuePrefix}}Tint({{typePrefix}}Tokens.foreground, 0)();

  return CalendarStyler()
      .padding(.all({{typePrefix}}Tokens.s3))
      .headerSpacing({{typePrefix}}Tokens.s2)
      .weekdaySpacing({{typePrefix}}Tokens.s1)
      .rowSpacing({{typePrefix}}Tokens.s0_5)
      .selectorSpacing({{typePrefix}}Tokens.s2)
      .weekday(
        .style(
          {{typePrefix}}Tokens.textXs.mix(),
        ).color({{typePrefix}}Tokens.mutedForeground()),
      )
      .day(
        CalendarDayStyler()
            .minWidth({{typePrefix}}Tokens.s12)
            .minHeight({{typePrefix}}Tokens.s12)
            .alignment(.center)
            .color(clear)
            .border(.color(clear).width({{typePrefix}}Tokens.strokeHairline))
            .borderRadius(
              .only(
                topStart: {{typePrefix}}Tokens.radiusSm(),
                topEnd: {{typePrefix}}Tokens.radiusSm(),
                bottomStart: {{typePrefix}}Tokens.radiusSm(),
                bottomEnd: {{typePrefix}}Tokens.radiusSm(),
              ),
            )
            .label(
              .style(
                {{typePrefix}}Tokens.textSm.mix(),
              ).color({{typePrefix}}Tokens.foreground()),
            )
            .onToday(
              CalendarDayStyler()
                  .border(.color({{typePrefix}}Tokens.mutedForeground()))
                  .label(.fontWeight(FontWeight.w600)),
            )
            .onSelected(
              CalendarDayStyler()
                  .color({{typePrefix}}Tokens.primary())
                  .label(.color({{typePrefix}}Tokens.primaryForeground())),
            )
            // Declared empty so the range keys sit before the pointer states: Mix
            // keeps a key's first position when the range recipe fills them in.
            .onRangeStart(CalendarDayStyler())
            .onRangeMiddle(CalendarDayStyler())
            .onRangeEnd(CalendarDayStyler())
            .onRangeSingle(CalendarDayStyler())
            .onRangePreview(CalendarDayStyler())
            .onHovered(
              CalendarDayStyler()
                  .color({{typePrefix}}Tokens.accent())
                  .label(.color({{typePrefix}}Tokens.accentForeground()))
                  .onSelected(
                    CalendarDayStyler()
                        .color({{valuePrefix}}Tint({{typePrefix}}Tokens.primary, 0.9)())
                        .label(.color({{typePrefix}}Tokens.primaryForeground())),
