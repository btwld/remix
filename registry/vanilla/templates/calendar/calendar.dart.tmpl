                            {{typePrefix}}Tokens.primary,
                            0.15,
                            dark: 0.32,
                          )(),
                        )
                        .label(.color({{typePrefix}}Tokens.foreground())),
                  )
                  .onRangePreview(
                    CalendarDayStyler()
                        .color(
                          {{valuePrefix}}Tint(
                            {{typePrefix}}Tokens.primary,
                            0.18,
                            dark: 0.28,
                          )(),
                        )
                        .label(.color({{typePrefix}}Tokens.foreground())),
                  ),
            )
            .onPressed(
              CalendarDayStyler()
                  .color({{valuePrefix}}Tint({{typePrefix}}Tokens.primary, 0.22, dark: 0.32)())
                  .label(.color({{typePrefix}}Tokens.foreground()))
                  .onSelected(
                    CalendarDayStyler()
                        .color({{valuePrefix}}Tint({{typePrefix}}Tokens.primary, 0.8)())
                        .label(.color({{typePrefix}}Tokens.primaryForeground())),
                  )
                  .onRangeMiddle(
                    CalendarDayStyler()
                        .color(
                          {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, 0.22, dark: 0.4)(),
                        )
                        .label(.color({{typePrefix}}Tokens.foreground())),
                  )
                  .onRangePreview(
                    CalendarDayStyler()
                        .color(
                          {{valuePrefix}}Tint(
                            {{typePrefix}}Tokens.primary,
                            0.24,
                            dark: 0.36,
                          )(),
                        )
                        .label(.color({{typePrefix}}Tokens.foreground())),
                  ),
            )
            .onFocusVisible(
              CalendarDayStyler()
                  .border(.all(.color(clear).width(0).style(BorderStyle.none)))
                  .containerEffects(
                    RemixBoxEffectsMix(
                      outline: BorderSideMix(
                        color: _focusContour(),
                        width: {{typePrefix}}Tokens.strokeIndicator,
                      ),
                      outlineOffset: -{{typePrefix}}Tokens.strokeIndicator,
                    ),
                  ),
            )
            .onDisabled(
              CalendarDayStyler()
                  .label(.color({{typePrefix}}Tokens.mutedForeground()))
                  .wrap(.opacity({{typePrefix}}Tokens.disabledOpacity))
                  .onSelected(
                    CalendarDayStyler()
                        .color(_quietSelected())
