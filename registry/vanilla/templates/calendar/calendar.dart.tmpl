final _calendarDisabled = ContextVariant(
  '{{valuePrefix}}.calendar.disabled',
  (context) =>
      (NakedCalendarState.maybeOf(context)?.states ??
              NakedRangeCalendarState.maybeOf(context)?.states ??
              const <WidgetState>{})
          .contains(WidgetState.disabled),
);

CalendarDayStyler _solidPointer(ContextToken<Color> fill) => CalendarDayStyler()
    .color(fill())
    .label(.color({{typePrefix}}Tokens.primaryForeground()));
final _primaryHover = {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, .9);
final _primaryPressed = {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, .8);
final _middleHover = {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, .15, dark: .32);
final _middlePressed = {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, .22, dark: .4);
final _draftHover = {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, .18, dark: .28);
final _draftPressed = {{valuePrefix}}Tint({{typePrefix}}Tokens.primary, .24, dark: .36);
final _quietSelected = ContextToken<Color>((context) {
  final value = NakedRangeCalendarState.maybeOf(context)?.value;
  if (value == null) return _quietSingle.resolve(context);
  final day = NakedCalendarDayState.maybeOf(context)?.date;
  final cap =
      day != null &&
      (compareCivilDates(day, value.start) == 0 ||
          compareCivilDates(day, value.end) == 0);
  return (cap ? _quietCap : _quietMiddle).resolve(context);
});
