    onChanged: onChanged,
    currentDate: currentDate,
    isDateUnavailable: isDateUnavailable,
    firstDayOfWeek: firstDayOfWeek,
    enabled: enabled,
    semanticLabel: semanticLabel,
    focusNode: focusNode,
    autofocus: autofocus,
    labels: labels,
    headerBuilder: headerBuilder,
    navigationStyle: {{valuePrefix}}IconButtonStyle(
      variant: .ghost,
      style: IconButtonStyler()
          .size(
            {{valuePrefix}}CalendarDayWidth(context),
            {{valuePrefix}}CalendarDayWidth(context),
