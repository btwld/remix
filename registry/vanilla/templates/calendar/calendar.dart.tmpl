            CalendarDayStyler()
                .color(_pressed())
                .label(.color({{typePrefix}}Tokens.foreground()))
                .onSelected(_solidPointer(_primaryPressed))
                .onRangeMiddle(
                  CalendarDayStyler()
                      .color(_middlePressed())
                      .label(.color({{typePrefix}}Tokens.foreground())),
                )
                .onRangePreview(
                  CalendarDayStyler()
                      .color(_draftPressed())
                      .label(.color({{typePrefix}}Tokens.foreground())),
