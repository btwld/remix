/// Dashboard with Overview, Chat, Customers, Orders, and Settings.
class {{typePrefix}}DashboardDemo extends StatefulWidget {
  const {{typePrefix}}DashboardDemo({
    super.key,
    this.brand = const _{{typePrefix}}Brand(),
    this.account,
    this.headerActions = const [],
    this.onSearchChanged,
    this.data = {{valuePrefix}}DashboardSampleData,
    this.initialPage = {{typePrefix}}DashboardDemoPage.overview,
    this.collapsed,
    this.initiallyCollapsed = false,
    this.onCollapsedChanged,
    this.builtInChrome = true,
    this.chatStepDelay = const Duration(milliseconds: 320),
  });

  final Widget brand;
  final Widget? account;
  final List<Widget> headerActions;
  final ValueChanged<String>? onSearchChanged;
  final {{typePrefix}}DashboardSampleData data;
  final {{typePrefix}}DashboardDemoPage initialPage;
  final bool? collapsed;
  final bool initiallyCollapsed;
  final ValueChanged<bool>? onCollapsedChanged;
  final bool builtInChrome;
  final Duration chatStepDelay;

  @override
  State<{{typePrefix}}DashboardDemo> createState() => _{{typePrefix}}DashboardDemoState();
}

class _{{typePrefix}}DashboardDemoState extends State<{{typePrefix}}DashboardDemo> {
  /// The appearance the toggle chose, or null to follow the scope this demo
  /// is placed in.
  bool? _dark;

  /// Base corner radius chosen from Settings, or null to keep the inherited
  /// theme's radius.
  double? _radius;
  Brightness? _ambientBrightness;
  bool _notificationsRead = false;

  @override
  void didChangeDependencies() {
    super.didChangeDependencies();
    final ambient = {{typePrefix}}Theme.maybeOf(context)?.brightness;
    if (_ambientBrightness != null && ambient != _ambientBrightness) {
      _dark = null;
    }
    _ambientBrightness = ambient;
  }

  bool get _isDark =>
      _dark ?? ({{typePrefix}}Theme.maybeOf(context)?.brightness == Brightness.dark);

  /// [brightness]'s inherited values, or the preset default, with [radius].
  {{typePrefix}}ThemeData _themeWithRadius(Brightness brightness, double radius) {
    final inherited = {{typePrefix}}Theme.maybeOf(context);
    final base = inherited != null && inherited.brightness == brightness
        ? inherited
        : switch (brightness) {
            Brightness.light => const {{typePrefix}}ThemeData.light(),
            Brightness.dark => const {{typePrefix}}ThemeData.dark(),
          };
    return base.copyWith(radius: Radius.circular(radius));
  }

  @override
  Widget build(BuildContext context) {
    final demo = {{typePrefix}}DashboardDemoBase(
      initialPage: widget.initialPage,
      shellBuilder:
          (
            context, {
            required sections,
            required selectedValue,
            required onSelected,
            required body,
            required title,
            required onSearchChanged,
          }) => {{typePrefix}}DashboardShell<{{typePrefix}}DashboardDemoPage>(
            sections: sections,
            selectedValue: selectedValue,
            onSelected: onSelected,
            body: body,
            title: title,
            headerTitle: widget.builtInChrome
                ? _{{typePrefix}}Breadcrumb(page: selectedValue)
                : null,
            brand: widget.brand,
            account:
                widget.account ??
                (widget.builtInChrome ? const _{{typePrefix}}Account() : null),
            headerActions: [
              if (widget.builtInChrome) ..._chromeActions(),
              ...widget.headerActions,
            ],
            onSearchChanged:
                widget.builtInChrome || widget.onSearchChanged != null
                ? (value) {
                    onSearchChanged(value);
                    widget.onSearchChanged?.call(value);
                  }
                : null,
            collapsed: widget.collapsed,
            initiallyCollapsed: widget.initiallyCollapsed,
            onCollapsedChanged: widget.onCollapsedChanged,
          ),
      pageBuilder: (context, page, query, onSelected) => switch (page) {
        .overview => {{typePrefix}}DashboardOverview(
          data: widget.data,
          onViewOrders: () => onSelected({{typePrefix}}DashboardDemoPage.orders),
        ),
        .chat => {{typePrefix}}DashboardChatPage(
          styles: _{{valuePrefix}}AgentStyles(),
          stepDelay: widget.chatStepDelay,
        ),
        .customers => {{typePrefix}}DashboardCustomersPage(globalQuery: query),
        .orders => {{typePrefix}}DashboardOrdersPage(globalQuery: query),
        .settings => {{typePrefix}}DashboardSettingsPage(
          darkMode: _dark,
          onDarkModeChanged: (value) => setState(() => _dark = value),
          onRadiusChanged: (value) => setState(() => _radius = value),
        ),
      },
    );
    if (!widget.builtInChrome) return demo;
    final radius = _radius;
    return {{typePrefix}}Theme(
      mode: _isDark ? {{typePrefix}}ThemeMode.dark : {{typePrefix}}ThemeMode.light,
      // One explicit half would be reused for the other brightness. Copy the
      // radius onto both so light and dark keep their own colors.
      theme: radius == null ? null : _themeWithRadius(Brightness.light, radius),
      darkTheme: radius == null
          ? null
          : _themeWithRadius(Brightness.dark, radius),
      child: Box(
        style: BoxStyler().color({{typePrefix}}Tokens.background()),
        child: RemixToastScope(style: {{valuePrefix}}ToastStyle(), child: demo),
      ),
    );
  }

  List<Widget> _chromeActions() => [
    {{typePrefix}}IconButton.ghost(
      key: const ValueKey('dashboard-appearance-toggle'),
      icon: _isDark ? {{icon:sun}} : {{icon:moon}},
      semanticLabel: _isDark ? 'Use light appearance' : 'Use dark appearance',
      onPressed: () => setState(() => _dark = !_isDark),
    ),
    {{typePrefix}}Popover(
      semanticLabel: 'Notifications',
      popoverChild: Box(
        style: BoxStyler()
            .width({{typePrefix}}Tokens.popoverWidth)
            .padding(.all({{typePrefix}}Tokens.s4)),
        child: ColumnBox(
          style: FlexBoxStyler()
              .mainAxisSize(.min)
              .crossAxisAlignment(.stretch)
              .spacing({{typePrefix}}Tokens.s2),
          children: [
            RowBox(
              style: FlexBoxStyler()
                  .mainAxisAlignment(.spaceBetween)
                  .crossAxisAlignment(.center),
              children: [
                Flexible(
                  child: StyledText(
                    'Notifications',
                    style: _textStyle(weight: FontWeight.w600),
                  ),
                ),
                if (!_notificationsRead)
                  {{typePrefix}}Button.ghost(
                    size: .small,
                    label: 'Mark all read',
                    onPressed: () => setState(() => _notificationsRead = true),
                  ),
              ],
            ),
            const {{typePrefix}}Divider(),
            _notificationItem(
              'Order ORD-1047 requires review.',
              '14m ago',
              unread: !_notificationsRead,
            ),
            _notificationItem(
              'Three customer invitations are pending.',
              '1h ago',
              unread: !_notificationsRead,
            ),
            _notificationItem(
              'Payout batch #29 was settled.',
              '3h ago',
              unread: false,
            ),
          ],
        ),
      ),
      child: StackBox(
        style: StackBoxStyler().clipBehavior(.none),
        children: [
          const {{typePrefix}}IconButton.ghost(
            icon: {{icon:bell}},
            semanticLabel: 'Open notifications',
          ),
          if (!_notificationsRead)
            Positioned(
              right: 8,
              top: 8,
              child: IgnorePointer(
                child: Box(
                  style: BoxStyler()
                      .size(7, 7)
                      .borderRadius(.circular(99))
                      .color({{typePrefix}}Tokens.primary()),
                ),
              ),
            ),
        ],
      ),
    ),
    {{typePrefix}}Popover(
      semanticLabel: 'Theme settings',
      popoverChild: Box(
        style: BoxStyler()
            .width({{typePrefix}}Tokens.popoverWidth)
            .padding(.all({{typePrefix}}Tokens.s4)),
        child: ColumnBox(
          style: FlexBoxStyler()
              .mainAxisSize(.min)
              .crossAxisAlignment(.stretch)
              .spacing({{typePrefix}}Tokens.s3),
          children: [
            StyledText(
              'Theme settings',
              style: _textStyle(
                token: {{typePrefix}}Tokens.textBase,
                weight: FontWeight.w600,
              ),
            ),
            {{typePrefix}}SegmentedControl<bool>(
              semanticLabel: 'Theme appearance',
              selectedValue: _isDark,
              items: const [
                RemixSegmentedControlItem(value: false, label: 'Light'),
                RemixSegmentedControlItem(value: true, label: 'Dark'),
              ],
              onChanged: (value) => setState(() => _dark = value),
            ),
            const {{typePrefix}}Divider(),
            _settingLine('Appearance', _isDark ? 'Dark' : 'Light'),
          ],
        ),
      ),
      child: const {{typePrefix}}IconButton.ghost(
        icon: {{icon:gear}},
        semanticLabel: 'Open theme settings',
      ),
    ),
  ];

  Widget _settingLine(String label, String value) => RowBox(
    style: FlexBoxStyler().crossAxisAlignment(.center),
    children: [
      Expanded(child: StyledText(label, style: _textStyle())),
      StyledText(value, style: _textStyle(muted: true)),
    ],
  );

  Widget _notificationItem(
    String message,
    String time, {
    required bool unread,
  }) => Box(
    style: BoxStyler()
        .padding(.all({{typePrefix}}Tokens.s2))
        .borderRadius(.all({{typePrefix}}Tokens.radiusMd()))
        .color(unread ? {{typePrefix}}Tokens.secondary() : const Color(0x00000000)),
    child: ColumnBox(
      style: FlexBoxStyler()
          .mainAxisSize(.min)
          .crossAxisAlignment(.start)
          .spacing({{typePrefix}}Tokens.s0_5),
      children: [
        StyledText(
          message,
          style: _textStyle(
            token: {{typePrefix}}Tokens.textXs,
            weight: unread ? FontWeight.w500 : FontWeight.w400,
          ),
        ),
        StyledText(
          time,
          style: _textStyle(token: {{typePrefix}}Tokens.textXs, muted: true),
        ),
      ],
    ),
  );
}

