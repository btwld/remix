Widget? _chartLegend({{typePrefix}}DashboardChartCase chart) {
  final items = switch (chart) {
    .revenueMomentum => const [
      {{typePrefix}}ChartLegendItem(label: 'Revenue', color: {{typePrefix}}Tokens.chart1),
    ],
    .linePatterns => const [
      {{typePrefix}}ChartLegendItem(
        label: 'Actual',
        detail: 'solid',
        color: {{typePrefix}}Tokens.chart1,
      ),
      {{typePrefix}}ChartLegendItem(
        label: 'Plan',
        detail: 'dashed',
        color: {{typePrefix}}Tokens.chart2,
        pattern: .dashed,
      ),
    ],
    .stepGaps => const [
      {{typePrefix}}ChartLegendItem(
        label: 'Inventory',
        detail: 'step after',
        color: {{typePrefix}}Tokens.chart1,
