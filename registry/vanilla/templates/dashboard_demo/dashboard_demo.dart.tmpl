    ],
    .groupedBars => const [
      {{typePrefix}}ChartLegendItem(label: 'Actual', color: {{typePrefix}}Tokens.chart1),
      {{typePrefix}}ChartLegendItem(label: 'Plan', color: {{typePrefix}}Tokens.chart2),
    ],
    .stackedBars => const [
      {{typePrefix}}ChartLegendItem(label: 'Product', color: {{typePrefix}}Tokens.chart1),
      {{typePrefix}}ChartLegendItem(label: 'Services', color: {{typePrefix}}Tokens.chart2),
    ],
    .floatingBars => const [
      {{typePrefix}}ChartLegendItem(
        label: 'Min–Max range',
        color: {{typePrefix}}Tokens.chart1,
      ),
