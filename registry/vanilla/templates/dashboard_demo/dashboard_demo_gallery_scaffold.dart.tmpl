class {{typePrefix}}GalleryMatrix<R, C> extends StatelessWidget {
  const {{typePrefix}}GalleryMatrix({
    super.key,
    required this.rows,
    required this.columns,
    required this.rowLabelBuilder,
    required this.columnLabelBuilder,
    required this.cellBuilder,
    this.cellWidth = 190,
  });

  final List<R> rows;
  final List<C> columns;
  final String Function(R value) rowLabelBuilder;
  final String Function(C value) columnLabelBuilder;
  final Widget Function(BuildContext context, R row, C column) cellBuilder;
  final double cellWidth;

  @override
  Widget build(BuildContext context) {
    final divider = BorderSideMix(
      color: {{typePrefix}}Tokens.border(),
      width: {{typePrefix}}Tokens.strokeHairline,
    );
    final borderRadius = BorderRadiusMix.all({{typePrefix}}Tokens.radiusMd());
    final GridBoxStyler gridStyle = .columns([
      const .fixed(112),
      for (final _ in columns) .fixed(cellWidth),
    ]);

    return SingleChildScrollView(
      scrollDirection: Axis.horizontal,
      child: Box(
        style: BoxStyler()
            .borderRadius(borderRadius)
            .clipBehavior(.antiAlias)
            .foregroundDecoration(
              BoxDecorationMix(
                border: BoxBorderMix.all(divider),
                borderRadius: borderRadius,
              ),
            ),
        child: GridBox(
          style: gridStyle,
          children: [
            _MatrixCell(
              divider: divider,
              alignment: Alignment.centerLeft,
              child: const {{typePrefix}}GalleryText('', muted: true),
            ),
            for (final column in columns)
              _MatrixCell(
                divider: divider,
                hasLeadingDivider: true,
                child: {{typePrefix}}GalleryText(
                  columnLabelBuilder(column),
                  muted: true,
                ),
              ),
            for (final row in rows) ...[
              _MatrixCell(
                divider: divider,
                hasTopDivider: true,
                alignment: Alignment.centerLeft,
                child: {{typePrefix}}GalleryText(rowLabelBuilder(row), muted: true),
              ),
              for (final column in columns)
                _MatrixCell(
                  divider: divider,
                  hasLeadingDivider: true,
                  hasTopDivider: true,
                  child: cellBuilder(context, row, column),
                ),
            ],
          ],
        ),
      ),
    );
  }
}

class {{typePrefix}}GalleryEnumMatrix<R extends Enum, C extends Enum>
    extends {{typePrefix}}GalleryMatrix<R, C> {
  const {{typePrefix}}GalleryEnumMatrix({
    super.key,
    required super.rows,
    required super.columns,
    required super.cellBuilder,
    super.cellWidth,
  }) : super(
         rowLabelBuilder: {{valuePrefix}}GalleryEnumLabel,
         columnLabelBuilder: {{valuePrefix}}GalleryEnumLabel,
       );
}

class _MatrixCell extends StatelessWidget {
  const _MatrixCell({
    required this.child,
    required this.divider,
    this.hasLeadingDivider = false,
    this.hasTopDivider = false,
    this.alignment = Alignment.center,
  });

  final Widget child;
  final BorderSideMix divider;
  final bool hasLeadingDivider;
  final bool hasTopDivider;
  final AlignmentGeometry alignment;

  @override
  Widget build(BuildContext context) {
    var style = BoxStyler()
        .minHeight(64)
        .padding(.all({{typePrefix}}Tokens.s2_5))
        .alignment(alignment);
    if (hasLeadingDivider || hasTopDivider) {
      style = style.foregroundDecoration(
        BoxDecorationMix(
          border: BorderMix(
            left: hasLeadingDivider ? divider : null,
            top: hasTopDivider ? divider : null,
          ),
        ),
      );
    }

    return Box(style: style, child: child);
  }
}

class {{typePrefix}}GalleryText extends StatelessWidget {
  const {{typePrefix}}GalleryText(
    this.value, {
    super.key,
    this.token = {{typePrefix}}Tokens.textSm,
    this.weight = FontWeight.w400,
    this.muted = false,
    this.emphasized = false,
    this.maxLines,
    this.overflow,
  });

  final String value;
  final TextStyleToken token;
  final FontWeight weight;
  final bool muted;
  final bool emphasized;
  final int? maxLines;
  final TextOverflow? overflow;

  @override
  Widget build(BuildContext context) {
    var style = TextStyler()
        .style(token.mix())
        .fontWeight(emphasized ? FontWeight.w600 : weight)
        .color(
          muted ? {{typePrefix}}Tokens.mutedForeground() : {{typePrefix}}Tokens.foreground(),
        );
    if (maxLines != null) style = style.maxLines(maxLines!);
    if (overflow != null) style = style.overflow(overflow!);
    return StyledText(value, style: style);
  }
}

class {{typePrefix}}GalleryHeading extends {{typePrefix}}GalleryText {
