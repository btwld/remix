import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
{{icon:import}}

import '../../theme/tokens.dart';

/// A run of dashboard text in the preset's type scale.
class {{typePrefix}}DashboardText extends StatelessWidget {
  const {{typePrefix}}DashboardText(
    this.value, {
    super.key,
    this.token = {{typePrefix}}Tokens.textSm,
    this.emphasized = false,
    this.muted = false,
  });

  /// The text to show.
  final String value;

  /// The text size token.
  final TextStyleToken token;

  /// Whether to use the semibold weight.
  final bool emphasized;

  /// Whether to use the muted foreground color.
  final bool muted;

  @override
  Widget build(BuildContext context) => StyledText(
    value,
    style: TextStyler()
        .style(token.mix())
        .fontWeight(emphasized ? FontWeight.w600 : FontWeight.w400)
        .color(
          muted ? {{typePrefix}}Tokens.mutedForeground() : {{typePrefix}}Tokens.foreground(),
        ),
  );
}

/// Shows a confirmation toast with [title].
void {{valuePrefix}}DashboardToast(BuildContext context, String title) =>
    showRemixToast(
      context,
      RemixToastData(title: title, icon: {{icon:checkCircled}}),
    );
