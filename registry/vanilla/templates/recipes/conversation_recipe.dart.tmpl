  latestStyle: {{valuePrefix}}IconButtonStyle(
    variant: .outline,
    size: .large,
    style: IconButtonStyler()
        .color({{typePrefix}}Tokens.background())
        .borderRadius(.circular({{typePrefix}}Tokens.pill))
