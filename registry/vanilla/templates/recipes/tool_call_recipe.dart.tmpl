AgentToolCallStyler _status() =>
    AgentToolCallStyler(
          status: FlexBoxStyler()
              .spacing({{typePrefix}}Tokens.s1)
              .crossAxisAlignment(.center),
          statusIcon: _glyph(size: {{typePrefix}}Tokens.s3),
          statusLabel: TextStyler()
              .style({{typePrefix}}Tokens.textXs.mix())
              .fontWeight(FontWeight.w500)
              .color({{typePrefix}}Tokens.mutedForeground()),
        )
        .onStatus(
          .failed,
          AgentToolCallStyler(
            statusIcon: _glyph(
              size: {{typePrefix}}Tokens.s3,
              color: {{typePrefix}}Tokens.destructive(),
            ),
            statusLabel: TextStyler().color({{typePrefix}}Tokens.destructive()),
          ),
        )
        .onStatus(
          .awaitingApproval,
