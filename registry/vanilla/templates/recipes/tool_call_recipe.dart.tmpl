/// Builds the recipe; each argument is merged last, so callers can override.
///
/// It reads top to bottom: the row, the status for each outcome, the output
/// well, then the approval card. The row paints 32px tall inside the
/// disclosure's 40px touch target. The well is a `gray2` panel with a `gray5`
/// edge that scrolls past `activityMaxHeight`; a failed call frames it in
/// `errorA7` and tints only the failing lines, which the call reports as its
/// error.
{{typePrefix}}AgentToolCallRecipe {{valuePrefix}}AgentToolCallRecipe({
  AgentToolCallStyler style = const AgentToolCallStyler.create(),
  DisclosureStyler disclosureStyle = const DisclosureStyler.create(),
  DataListStyler inputStyle = const DataListStyler.create(),
  ButtonStyler allowOnceStyle = const ButtonStyler.create(),
  ButtonStyler alwaysAllowStyle = const ButtonStyler.create(),
  ButtonStyler denyStyle = const ButtonStyler.create(),
}) => {{typePrefix}}AgentToolCallRecipe(
  style: _row().merge(_status()).merge(_well()).merge(_card()).merge(style),
  disclosureStyle: _quietDisclosure().merge(disclosureStyle),
  inputStyle: {{valuePrefix}}DataListStyle(
    style: DataListStyler()
        .rowSpacing({{typePrefix}}Tokens.s1)
        .value(_mono(13))
        .merge(inputStyle),
  ),
  allowOnceStyle: {{valuePrefix}}ButtonStyle(
    variant: .primary,
    size: .small,
    style: allowOnceStyle,
  ),
  alwaysAllowStyle: {{valuePrefix}}ButtonStyle(
    variant: .ghost,
    size: .small,
    style: ButtonStyler()
        .label(.color({{typePrefix}}Tokens.mutedForeground()))
        .merge(alwaysAllowStyle),
  ),
  denyStyle: {{valuePrefix}}ButtonStyle(
    variant: .outline,
    size: .small,
    style: denyStyle,
  ),
);

/// The row: tool icon, summary, then the meta with the tool id in monospace.
AgentToolCallStyler _row() =>
    AgentToolCallStyler(
          row: FlexBoxStyler()
              .spacing({{typePrefix}}Tokens.s2)
              .crossAxisAlignment(.center)
              .minHeight({{typePrefix}}Tokens.s8)
              .padding(.horizontal({{typePrefix}}Tokens.s2))
              .transform(Matrix4.translationValues(-{{typePrefix}}Tokens.s2, 0, 0))
              .borderRadius(.all({{typePrefix}}Tokens.radiusMd())),
          icon: _glyph(),
          summary: TextStyler()
              .style({{typePrefix}}Tokens.textSm.mix())
              .fontWeight(FontWeight.w500)
              .color({{typePrefix}}Tokens.foreground()),
          meta: TextStyler()
              .style({{typePrefix}}Tokens.textXs.mix())
              .color({{typePrefix}}Tokens.mutedForeground()),
          toolId: _mono(12),
          indicator: _glyph(),
        )
        .onFocused(.row(.color({{typePrefix}}Tokens.accent())))
        .onHovered(.row(.color({{typePrefix}}Tokens.accent())))
        .onPressed(.row(.color({{typePrefix}}Tokens.accent())));

