/// Builds the recipe; each argument is merged last, so callers can override.
///
/// A user message is a `gray3` bubble at most three quarters of the line wide.
/// An assistant message adds nothing: its answer is the content.
{{typePrefix}}AgentMessageRecipe {{valuePrefix}}AgentMessageRecipe({
  AgentMessageStyler style = const AgentMessageStyler.create(),
  ButtonStyler toggleStyle = const ButtonStyler.create(),
}) => {{typePrefix}}AgentMessageRecipe(
  style: AgentMessageStyler()
      .text(
        TextStyler()
            .style({{typePrefix}}Tokens.textBase.mix())
            .color({{typePrefix}}Tokens.foreground()),
      )
      .onUser(
        AgentMessageStyler(
          surface: BoxStyler()
              .color({{typePrefix}}Tokens.muted())
              .borderRadius(.all({{typePrefix}}Tokens.radiusXl()))
              .padding(
                .symmetric(
                  horizontal: {{typePrefix}}Tokens.s4,
                  vertical: {{typePrefix}}Tokens.s2,
                ),
              ),
          maxWidthFactor: 0.75,
          collapsedHeight: 72.0,
        ),
      )
      .merge(style),
  toggleStyle: {{valuePrefix}}ButtonStyle(
    variant: .ghost,
    size: .small,
    style: toggleStyle,
  ),
);
