import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/effects.dart';
import '../theme/tokens.dart';

part 'select.g.dart';

/// The application's Select recipe.
///
/// One recipe covers the trigger, the floating panel and the option rows,
/// because `SelectSpec` carries all three. The trigger is styled as a field,
/// like the text field; the panel matches the menu's.
@MixWidget(target: RemixSelect.new)
SelectStyler {{valuePrefix}}SelectStyle({
  SelectStyler style = const SelectStyler.create(),
}) {
  return SelectStyler()
      .trigger(_triggerStyle())
      .content(_contentStyle())
      .menuContainer(.direction(.vertical).mainAxisSize(.min))
      .item(_itemStyle())
      .merge(style);
}

/// The closed control: a field showing the current value and a chevron.
/// See "Select trigger vertical padding" in the spec's Deviations.
SelectTriggerStyler _triggerStyle() => SelectTriggerStyler()
    .animate({{typePrefix}}Tokens.motion)
    .direction(.horizontal)
    .crossAxisAlignment(.center)
    .mainAxisAlignment(.spaceBetween)
    .minHeight({{typePrefix}}Tokens.controlMd)
    .padding(
      .symmetric(horizontal: {{typePrefix}}Tokens.s3, vertical: {{typePrefix}}Tokens.s1),
    )
    .spacing({{typePrefix}}Tokens.s2)
    // Transparent, or `input` at 30% in the dark theme.
    .color({{valuePrefix}}Tint({{typePrefix}}Tokens.input, 0, dark: 0.3)())
    .border(.color({{typePrefix}}Tokens.input()).width({{typePrefix}}Tokens.strokeHairline))
    .borderRadius(.all({{typePrefix}}Tokens.radiusMd()))
    // In the effects layer: the fill is transparent, and a decoration shadow
    // would show through it.
    .containerEffects(.behindContent({{typePrefix}}Shadow.xs.effects))
    .label(.style({{typePrefix}}Tokens.textSm.mix()).color({{typePrefix}}Tokens.foreground()))
    // Quieter than a value, or an empty select looks answered.
    .placeholder(
      .style({{typePrefix}}Tokens.textSm.mix()).color({{typePrefix}}Tokens.mutedForeground()),
    )
    .icon(.size({{typePrefix}}Tokens.icon).color({{typePrefix}}Tokens.mutedForeground()))
    // 10px sizes Remix's edge-to-edge 9x9 chevron path.
    .indicator(.size({{typePrefix}}Tokens.s2_5).color({{typePrefix}}Tokens.mutedForeground()))
    .indicatorOpacity(0.5)
    // Only the dark trigger changes on hover; the chevron already says it opens.
    .onHovered(
      SelectTriggerStyler().color(
        {{valuePrefix}}Tint({{typePrefix}}Tokens.input, 0, dark: 0.5)(),
      ),
    )
    .onFocusVisible(
      SelectTriggerStyler()
          .containerEffects({{valuePrefix}}FocusRing())
          .border({{valuePrefix}}FocusBorder()),
    )
    .onDisabled(
      SelectTriggerStyler()
          .containerEffects(.outline(.style(.none)))
          .wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
    );

/// The floating panel: at least 128px wide and at least as wide as its
/// trigger.
SelectContentStyler _contentStyle() => SelectContentStyler()
    .color({{typePrefix}}Tokens.popover())
    .border(.color({{typePrefix}}Tokens.border()).width({{typePrefix}}Tokens.strokeHairline))
    .borderRadius(.all({{typePrefix}}Tokens.radiusMd()))
    .padding(.all({{typePrefix}}Tokens.s1))
    .minWidth({{typePrefix}}Tokens.panelMinWidth)
    // A second minimum on a modifier, so the trigger's width holds even if a
    // caller replaces the 128px floor.
    .wrap(.box(BoxStyler().minWidth(remixAnchorWidth())))
    .maxHeight({{typePrefix}}Tokens.panelMaxHeight)
    .containerEffects(.behindContent({{typePrefix}}Shadow.md.effects));

/// One option row. Remix lays the check mark out after the label, so the
/// symmetric 8px padding puts it 8px from the trailing edge. `accent` marks the
/// row under the pointer and the one the arrow keys are on.
SelectMenuItemStyler _itemStyle() => SelectMenuItemStyler()
    .direction(.horizontal)
    .crossAxisAlignment(.center)
    .minHeight({{typePrefix}}Tokens.controlSm)
    .padding(
      .symmetric(horizontal: {{typePrefix}}Tokens.s2, vertical: {{typePrefix}}Tokens.s1_5),
    )
    .spacing({{typePrefix}}Tokens.s2)
    .borderRadius(.all({{typePrefix}}Tokens.radiusSm()))
    .label(
      .style(
        {{typePrefix}}Tokens.textSm.mix(),
      ).color({{typePrefix}}Tokens.popoverForeground()),
    )
    // The check stays `mutedForeground`, highlighted or not. 10px sizes
    // Remix's edge-to-edge 9x9 check path.
    .icon(.size({{typePrefix}}Tokens.s2_5).color({{typePrefix}}Tokens.mutedForeground()))
    .onHovered(_highlighted())
    .onFocused(_highlighted())
    .onDisabled(
      SelectMenuItemStyler().wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
    );

SelectMenuItemStyler _highlighted() => SelectMenuItemStyler()
    .color({{typePrefix}}Tokens.accent())
    .label(.color({{typePrefix}}Tokens.accentForeground()));
