import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/tokens.dart';

part 'app_bar.g.dart';

/// Height of the toolbar row, including its bottom hairline. The sidebar
/// brand row uses it to line up with the app bar.
const {{valuePrefix}}AppBarToolbarHeight = {{typePrefix}}Tokens.s16;

/// The application's AppBar recipe: a `background` surface over a toolbar row
/// with a bottom hairline and a semibold `textLg` title.
///
/// [style] merges last:
///
/// ```dart
/// {{typePrefix}}AppBar(
///   style: AppBarStyler().toolbarHeight({{typePrefix}}Tokens.s12),
///   title: 'Orders',
/// )
/// ```
@MixWidget(target: RemixAppBar.new)
AppBarStyler {{valuePrefix}}AppBarStyle({
  AppBarStyler style = const AppBarStyler.create(),
}) => AppBarStyler(
  container: BoxStyler().color({{typePrefix}}Tokens.background()),
  toolbar: BoxStyler()
      .padding(.horizontal({{typePrefix}}Tokens.s4))
      .border(
        .bottom(
          .color({{typePrefix}}Tokens.border()).width({{typePrefix}}Tokens.strokeHairline),
        ),
      ),
  title: TextStyler()
      .style({{typePrefix}}Tokens.textLg.mix())
      .fontWeight(FontWeight.w600)
      .color({{typePrefix}}Tokens.foreground()),
  actions: FlexBoxStyler().spacing({{typePrefix}}Tokens.s3),
  toolbarHeight: {{valuePrefix}}AppBarToolbarHeight,
  spacing: {{typePrefix}}Tokens.s3,
).merge(style);
