import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/effects.dart';
import '../theme/tokens.dart';

part 'radio.g.dart';

/// The application's Radio recipe.
///
/// A 16px ring with an 8px dot. The ring stays `input` whether or not the
/// option is chosen; the dot carries the choice. There is no hover fragment:
/// choosing is the feedback. The label is set like the checkbox's.
///
/// `RemixRadioGroup`, which owns `groupValue` and the change callback, has no
/// styler and no recipe. Wrap the options in it directly:
///
/// ```dart
/// RemixRadioGroup<String>(
///   groupValue: plan,
///   onChanged: (value) => setState(() => plan = value),
///   child: Column(children: const [
///     {{typePrefix}}Radio(value: 'free', label: 'Free'),
///     {{typePrefix}}Radio(value: 'pro', label: 'Pro'),
///   ]),
/// )
/// ```
@MixWidget(target: RemixRadio.new)
RadioStyler {{valuePrefix}}RadioStyle({
  RadioStyler style = const RadioStyler.create(),
}) {
  return RadioStyler()
      .animate({{typePrefix}}Tokens.motion)
      .size({{typePrefix}}Tokens.icon, {{typePrefix}}Tokens.icon)
      .alignment(.center)
      .borderRadius(.all(_circular))
      // Transparent, or `input` at 30% in the dark theme.
      .color({{valuePrefix}}Tint({{typePrefix}}Tokens.input, 0, dark: 0.3)())
      .border(.color({{typePrefix}}Tokens.input()).width({{typePrefix}}Tokens.strokeHairline))
      // In the effects layer: the ring is transparent, and a decoration shadow
      // would show through it.
      .containerEffects(.behindContent({{typePrefix}}Shadow.xs.effects))
      .indicator(
        BoxStyler()
            .size({{typePrefix}}Tokens.s2, {{typePrefix}}Tokens.s2)
            .borderRadius(.all(_circular)),
      )
      .labelSpacing({{typePrefix}}Tokens.s3)
      .label(
        .style(
          {{typePrefix}}Tokens.textSm.mix(),
        ).fontWeight(FontWeight.w500).color({{typePrefix}}Tokens.foreground()),
      )
      .onFocusVisible(
        RadioStyler()
            .containerEffects({{valuePrefix}}FocusRing())
            .border({{valuePrefix}}FocusBorder()),
      )
      .onSelected(RadioStyler().indicatorColor({{typePrefix}}Tokens.primary()))
      // Declared last so it wins; the ring is cleared because a disabled
      // control that still rings reads as actionable.
      .onDisabled(
        RadioStyler()
            .containerEffects(.outline(.style(.none)))
            .wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
      )
      .merge(style);
}

/// Rounds the ring and the dot into circles.
const _circular = Radius.circular({{typePrefix}}Tokens.pill);
