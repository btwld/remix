import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/effects.dart';
import '../theme/tokens.dart';

part 'menu.g.dart';

/// The application's Menu recipe.
///
/// One recipe covers every row kind: `MenuSpec` falls back to `item` for
/// `checkboxItem`, `radioItem` and `submenuItem`, so styling only `item` keeps
/// the menu one list.
///
/// The panel matches the popover's `popover` fill and `border` hairline, so a
/// menu and a popover beside each other do not read as two systems.
@MixWidget(target: RemixMenu.new)
MenuStyler {{valuePrefix}}MenuStyle({MenuStyler style = const MenuStyler.create()}) =>
    MenuStyler()
        .trigger(_triggerStyle())
        // The panel pads above and below only; each row takes the side inset
        // as its own margin, so a divider can run edge to edge.
        .overlay(
          FlexBoxStyler()
              .direction(.vertical)
              .mainAxisSize(.min)
              .color({{typePrefix}}Tokens.popover())
              .border(
                .color(
                  {{typePrefix}}Tokens.border(),
                ).width({{typePrefix}}Tokens.strokeHairline),
              )
              .borderRadius(.all({{typePrefix}}Tokens.radiusMd()))
              .padding(.vertical({{typePrefix}}Tokens.s1))
              .minWidth({{typePrefix}}Tokens.panelMinWidth),
        )
        .containerEffects(.behindContent({{typePrefix}}Shadow.md.effects))
        .item(_itemStyle())
        .divider(_dividerStyle())
        .merge(style);

/// The label trigger: quiet at rest, with hover and focus so a keyboard user
/// can see where they are. A button trigger (`RemixMenuTrigger.control`) owns
/// its own look.
MenuTriggerStyler _triggerStyle() => MenuTriggerStyler()
    .animate({{typePrefix}}Tokens.motion)
    .direction(.horizontal)
    .mainAxisSize(.min)
    .crossAxisAlignment(.center)
    .minHeight({{typePrefix}}Tokens.controlSm)
    .padding(
      .symmetric(horizontal: {{typePrefix}}Tokens.s2, vertical: {{typePrefix}}Tokens.s1_5),
    )
    .spacing({{typePrefix}}Tokens.s2)
    .borderRadius(.all({{typePrefix}}Tokens.radiusMd()))
    .label(
      .style({{typePrefix}}Tokens.textSm.mix())
          .fontWeight(FontWeight.w500)
          .color({{typePrefix}}Tokens.foreground())
          .maxLines(1)
          .softWrap(false)
          .overflow(.ellipsis),
    )
    .icon(.size({{typePrefix}}Tokens.icon).color({{typePrefix}}Tokens.foreground()))
    .onHovered(.color({{typePrefix}}Tokens.accent()))
    // An outline rather than a border, which would nudge the label.
    .onFocusVisible(.containerEffects({{valuePrefix}}FocusRing()))
    .onDisabled(
      MenuTriggerStyler().wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
    );

/// One row of any kind. `accent` marks the highlighted row on hover and on
/// focus, so arrow-key users see the same row a pointer user would.
MenuItemStyler _itemStyle() => MenuItemStyler()
    .direction(.horizontal)
    .crossAxisAlignment(.center)
    .minHeight({{typePrefix}}Tokens.controlSm)
    .margin(.horizontal({{typePrefix}}Tokens.s1))
    .padding(
      .symmetric(horizontal: {{typePrefix}}Tokens.s2, vertical: {{typePrefix}}Tokens.s1_5),
    )
    .spacing({{typePrefix}}Tokens.s2)
    .borderRadius(.all({{typePrefix}}Tokens.radiusSm()))
    .label(
      .style(
        {{typePrefix}}Tokens.textSm.mix(),
      ).color({{typePrefix}}Tokens.popoverForeground()),
    )
    .leadingIcon(
      .size({{typePrefix}}Tokens.icon).color({{typePrefix}}Tokens.mutedForeground()),
    )
    // 10px sizes Remix's edge-to-edge 9x9 chevron and check paths.
    .trailingIcon(
      .size({{typePrefix}}Tokens.s2_5).color({{typePrefix}}Tokens.mutedForeground()),
    )
    .trailingText(
      .style({{typePrefix}}Tokens.textXs.mix()).color({{typePrefix}}Tokens.mutedForeground()),
    )
    .indicator(
      .size({{typePrefix}}Tokens.s2_5).color({{typePrefix}}Tokens.popoverForeground()),
    )
    .onHovered(_highlighted())
    .onFocused(_highlighted())
    .onDisabled(MenuItemStyler().wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)));

/// The label and check mark follow the row onto `accentForeground`; the icons
/// and trailing text stay `mutedForeground`.
MenuItemStyler _highlighted() => MenuItemStyler()
    .color({{typePrefix}}Tokens.accent())
    .label(.color({{typePrefix}}Tokens.accentForeground()))
    .indicator(.color({{typePrefix}}Tokens.accentForeground()));

/// A `border` hairline between groups of rows, edge to edge across the panel.
DividerStyler _dividerStyle() => DividerStyler()
    .color({{typePrefix}}Tokens.border())
    .height({{typePrefix}}Tokens.strokeHairline)
    .margin(.vertical({{typePrefix}}Tokens.s1))
    .wrap(.fractionallySizedBox(widthFactor: 1));
