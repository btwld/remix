import 'package:flutter/widgets.dart';
import 'package:mix_annotations/mix_annotations.dart';
import 'package:remix/remix.dart';

import '../theme/effects.dart';
import '../theme/tokens.dart';

part 'switch.g.dart';

/// The application's Switch recipe.
///
/// A 32px by 18.4px track and a 16px thumb. The height is off the 4px grid on
/// purpose: the thumb, a 1px outline above and below, and 0.2px of air on each
/// side. Remix owns the thumb's travel. The label is a form label, `textSm` at
/// medium weight; a switch without one needs a `semanticLabel`.
@MixWidget(target: RemixSwitch.new)
SwitchStyler {{valuePrefix}}SwitchStyle({
  SwitchStyler style = const SwitchStyler.create(),
}) {
  return SwitchStyler()
      .animate({{typePrefix}}Tokens.motion)
      .size(
        {{typePrefix}}Tokens.s8,
        {{typePrefix}}Tokens.icon + 2 * ({{typePrefix}}Tokens.strokeHairline + 0.2),
      )
      .borderRadius(.all(_pill))
      // `input`, at 80% in the dark theme.
      .trackColor({{valuePrefix}}Tint({{typePrefix}}Tokens.input, 1, dark: 0.8)())
      // A transparent outline holds the pixel the focus fragment turns `ring`,
      // so focusing never changes the size.
      .border(
        .color(const Color(0x00000000)).width({{typePrefix}}Tokens.strokeHairline),
      )
      // In the effects layer: the dark off-track is translucent, and a
      // decoration shadow would show through it.
      .trackEffects(RemixBoxEffectsMix(behindContent: {{typePrefix}}Shadow.xs.effects))
      .thumb(
        BoxStyler()
            .size({{typePrefix}}Tokens.icon, {{typePrefix}}Tokens.icon)
            .borderRadius(.all(_pill))
            // The page color, except in the dark theme, where it would vanish
            // into the track.
            .color(
              {{valuePrefix}}ByBrightness(
                light: {{typePrefix}}Tokens.background,
                dark: {{typePrefix}}Tokens.foreground,
              )(),
            ),
      )
      .labelSpacing({{typePrefix}}Tokens.s2)
      .label(
        .style(
          {{typePrefix}}Tokens.textSm.mix(),
        ).fontWeight(FontWeight.w500).color({{typePrefix}}Tokens.foreground()),
      )
      .onSelected(
        SwitchStyler()
            .trackColor({{typePrefix}}Tokens.primary())
            // `primaryForeground` in the dark theme, where `primary` is light.
            .thumbColor(
              {{valuePrefix}}ByBrightness(
                light: {{typePrefix}}Tokens.background,
                dark: {{typePrefix}}Tokens.primaryForeground,
              )(),
            ),
      )
      .onFocusVisible(
        SwitchStyler()
            .trackEffects({{valuePrefix}}FocusRing())
            .border({{valuePrefix}}FocusBorder()),
      )
      // Declared last so it wins; the ring is cleared because a disabled
      // control that still rings reads as actionable.
      .onDisabled(
        SwitchStyler()
            .trackEffects(RemixBoxEffectsMix.outline(.style(.none)))
            .wrap(.opacity({{typePrefix}}Tokens.disabledOpacity)),
      )
      .merge(style);
}

const _pill = Radius.circular({{typePrefix}}Tokens.pill);
