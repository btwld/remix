{
  "name": "remix-registry-carbon-token-upstream",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development-only workspace pinning the IBM Carbon token packages used by the Remix registry preset. Never installed by consumers.",
  "scripts": {
    "install:pinned": "npm ci || npm install --no-save",
    "postinstall": "node -e \"process.stdout.write('carbon upstream token sources installed\\n')\""
  },
  "dependencies": {
    "@carbon/colors": "11.56.0",
    "@carbon/layout": "11.57.0",
    "@carbon/motion": "11.50.0",
    "@carbon/themes": "11.79.0",
    "@carbon/type": "11.65.0"
  }
}
