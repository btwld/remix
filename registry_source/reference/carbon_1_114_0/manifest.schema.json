{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Carbon for Flutter parity manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "source",
    "coreFamilies",
    "extensions",
    "excludedRemixFamilies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "source": {
      "type": "object",
      "required": [
        "catalogUrl",
        "reactPackage",
        "reactVersion",
        "reactIntegrity",
        "stylesPackage",
        "stylesVersion",
        "stylesIntegrity",
        "gitRepository",
        "gitCommit",
        "license"
      ]
    },
    "coreFamilies": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" }
    },
    "extensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/family" }
    },
    "excludedRemixFamilies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "reason"],
        "properties": {
          "id": { "type": "string" },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "family": {
      "type": "object",
      "required": [
        "id",
        "publicApi",
        "strategy",
        "remixBase",
        "semanticPrimitive"
      ],
      "properties": {
        "id": { "type": "string" },
        "publicApi": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "strategy": {
          "enum": [
            "carbon_composite",
            "carbon_native",
            "mix_chart_recipe",
            "remix_adapter",
            "remix_recipe"
          ]
        },
        "remixBase": {
          "type": "array",
          "items": { "type": "string" }
        },
        "semanticPrimitive": { "type": "string", "minLength": 1 },
        "sourceFiles": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  }
}
