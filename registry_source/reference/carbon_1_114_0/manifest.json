  "excludedRemixFamilies": [
    {
      "id": "avatar",
      "reason": "No component in the official Carbon core catalog."
    },
    {
      "id": "badge",
      "reason": "Carbon Tag has narrower labeling semantics and receives its own adapter."
    },
    {
      "id": "card",
      "reason": "Carbon Tile has explicit interaction variants and receives its own adapter."
    },
    {
      "id": "data_list",
      "reason": "Carbon Contained List and Structured List have different row contracts."
    },
    {
      "id": "divider",
      "reason": "Carbon uses contextual border tokens instead of a standalone core divider."
    },
    {
      "id": "skeleton",
      "reason": "Carbon exposes component skeleton states and dedicated skeleton primitives rather than a one-to-one catalog family."
    },
    {
      "id": "toggle_button",
      "reason": "RemixToggle is a selected pressable; Carbon Toggle is implemented from RemixSwitch."
    },
    {
      "id": "toggle_group",
      "reason": "Carbon Content Switcher is implemented from RemixSegmentedControl to avoid duplicate semantics."
    }
  ]
