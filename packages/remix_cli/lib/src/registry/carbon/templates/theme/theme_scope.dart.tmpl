}

class _{{typePrefix}}Inherited extends InheritedWidget {
  const _{{typePrefix}}Inherited({
    required this.theme,
    required this.overrides,
    required super.child,
  });

  final {{typePrefix}}Theme theme;
  final {{typePrefix}}ThemeOverrides overrides;

  @override
  bool updateShouldNotify(_{{typePrefix}}Inherited oldWidget) =>
