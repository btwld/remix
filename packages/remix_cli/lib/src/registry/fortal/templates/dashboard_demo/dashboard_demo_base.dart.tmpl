import 'package:flutter/widgets.dart';
import 'package:remix/remix.dart';
import 'package:remix_ui_icons/remix_ui_icons.dart';

/// The four navigation groups shared with the repository dashboard showcase.
enum {{typePrefix}}DashboardDemoSection {
  workspace('Workspace'),
  data('Data'),
  manage('Manage'),
  components('Components');

  const {{typePrefix}}DashboardDemoSection(this.label);

  final String label;
}

/// Every destination in the full dashboard demo.
enum {{typePrefix}}DashboardDemoPage {
  overview(
    {{typePrefix}}DashboardDemoSection.workspace,
    'Overview',
    RemixIcons.dashboard,
  ),
  chat({{typePrefix}}DashboardDemoSection.workspace, 'Chat', RemixIcons.chatBubble),
  customers({{typePrefix}}DashboardDemoSection.data, 'Customers', RemixIcons.group),
  orders({{typePrefix}}DashboardDemoSection.data, 'Orders', RemixIcons.table),
  settings(
    {{typePrefix}}DashboardDemoSection.manage,
    'Settings',
    RemixIcons.mixerHorizontal,
  ),
  charts(
    {{typePrefix}}DashboardDemoSection.components,
    'Charts',
    RemixIcons.barChart,
  ),
  actions(
    {{typePrefix}}DashboardDemoSection.components,
    'Actions',
    RemixIcons.cursorArrow,
  ),
  forms(
    {{typePrefix}}DashboardDemoSection.components,
    'Forms & Inputs',
    RemixIcons.input,
  ),
  dataDisplay(
    {{typePrefix}}DashboardDemoSection.components,
    'Data Display',
    RemixIcons.table,
  ),
  overlays(
    {{typePrefix}}DashboardDemoSection.components,
    'Overlays',
    RemixIcons.stack,
  ),
  navigation(
    {{typePrefix}}DashboardDemoSection.components,
    'Navigation',
    RemixIcons.hamburgerMenu,
  ),
  typography(
    {{typePrefix}}DashboardDemoSection.components,
    'Typography',
    RemixIcons.fontSize,
  );

  const {{typePrefix}}DashboardDemoPage(this.section, this.label, this.icon);

  final {{typePrefix}}DashboardDemoSection section;
  final String label;
  final IconData icon;
}

/// The complete sidebar inventory used by both {{valuePrefix}} presets.
final {{valuePrefix}}DashboardDemoSections =
    <RemixSidebarSection<{{typePrefix}}DashboardDemoPage>>[
      for (final section in {{typePrefix}}DashboardDemoSection.values)
        RemixSidebarSection(
          label: section.label,
          destinations: [
            for (final page in {{typePrefix}}DashboardDemoPage.values)
              if (page.section == section)
                RemixSidebarDestination(
                  value: page,
                  label: page.label,
                  icon: page.icon,
                ),
          ],
        ),
    ];

typedef {{typePrefix}}DashboardDemoShellBuilder =
    Widget Function(
      BuildContext context, {
      required List<RemixSidebarSection<{{typePrefix}}DashboardDemoPage>> sections,
      required {{typePrefix}}DashboardDemoPage selectedValue,
      required ValueChanged<{{typePrefix}}DashboardDemoPage> onSelected,
      required Widget body,
      required String title,
      required ValueChanged<String> onSearchChanged,
    });

typedef {{typePrefix}}DashboardDemoPageBuilder =
    Widget Function(
      BuildContext context,
      {{typePrefix}}DashboardDemoPage page,
      String searchQuery,
      ValueChanged<{{typePrefix}}DashboardDemoPage> onSelected,
    );

/// Preset-neutral navigation and state for the full dashboard demo.
///
/// Pages live in an [IndexedStack] so interactive controls and the chat draft
/// keep their state while visitors compare other destinations.
class {{typePrefix}}DashboardDemoBase extends StatefulWidget {
  const {{typePrefix}}DashboardDemoBase({
    super.key,
    required this.shellBuilder,
    required this.pageBuilder,
    this.initialPage = {{typePrefix}}DashboardDemoPage.overview,
  });

  final {{typePrefix}}DashboardDemoShellBuilder shellBuilder;
  final {{typePrefix}}DashboardDemoPageBuilder pageBuilder;
  final {{typePrefix}}DashboardDemoPage initialPage;

  @override
  State<{{typePrefix}}DashboardDemoBase> createState() =>
      _{{typePrefix}}DashboardDemoBaseState();
}

class _{{typePrefix}}DashboardDemoBaseState extends State<{{typePrefix}}DashboardDemoBase> {
  late {{typePrefix}}DashboardDemoPage _selected = widget.initialPage;
  String _searchQuery = '';

  void _select({{typePrefix}}DashboardDemoPage page) {
    if (_selected == page) return;
    setState(() => _selected = page);
  }

  @override
  Widget build(BuildContext context) => widget.shellBuilder(
    context,
    sections: {{valuePrefix}}DashboardDemoSections,
    selectedValue: _selected,
    onSelected: _select,
    title: _selected.label,
    onSearchChanged: (value) =>
        setState(() => _searchQuery = value.trim().toLowerCase()),
    body: IndexedStack(
      key: const ValueKey('dashboard-demo-pages'),
      index: _selected.index,
      children: [
        for (final page in {{typePrefix}}DashboardDemoPage.values)
          widget.pageBuilder(context, page, _searchQuery, _select),
      ],
    ),
  );
}

/// Responsive scrolling frame shared by the product and component pages.
class {{typePrefix}}DashboardDemoPageFrame extends StatelessWidget {
  const {{typePrefix}}DashboardDemoPageFrame({
    super.key,
    required this.header,
    required this.children,
  });

  final Widget header;
  final List<Widget> children;

  @override
  Widget build(BuildContext context) => SingleChildScrollView(
    key: const ValueKey('dashboard-demo-page-scroll'),
    padding: const EdgeInsets.all(24),
    child: Center(
      child: ConstrainedBox(
        constraints: const BoxConstraints(maxWidth: 1180),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.stretch,
          children: [
            header,
            const SizedBox(height: 24),
            for (final (index, child) in children.indexed) ...[
              if (index > 0) const SizedBox(height: 16),
              child,
            ],
          ],
        ),
      ),
    ),
  );
}
